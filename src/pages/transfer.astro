      </div>

      <!-- Peer-tab-hidden banner: shown when peer's tab is backgrounded -->
      <div id="peer-hidden-banner" class="hidden mt-4 rounded-lg border border-amber-500/40 bg-amber-500/10 p-3 flex items-center gap-3">
        <svg class="text-amber-500 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        <p class="text-sm text-[var(--color-fg)]">
          <span id="peer-hidden-text">Peer's tab is in the background.</span>
          <span class="text-[var(--color-fg-muted)]">Mobile browsers throttle hidden tabs — ask them to keep this tab open for steady transfers.</span>
        </p>
      </div>

      <!-- "Send another / Clear" reset after transfers complete -->
      <div id="reset-bar" class="hidden mt-4 flex items-center justify-between gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-3 flex-wrap">
        <p class="text-sm text-[var(--color-fg-muted)]">
          <span id="reset-summary">All sent.</span> Drop more files or clear the list.
        </p>
        <div class="flex items-center gap-2">
          <button id="reset-clear" type="button" class="h-9 rounded-md border border-[var(--color-border)] px-3 text-sm hover:bg-[var(--color-bg-muted)]">Clear list</button>
          <button id="reset-send-more" type="button" class="h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Send more files</button>
        </div>
      </div>
    </section>

    <!-- Chat panel (only shown after connection) -->
    <section id="chat-panel" class="hidden mt-6 rounded-lg border border-[var(--color-border)] overflow-hidden flex flex-col">
      <header class="px-5 py-3 border-b border-[var(--color-border)] bg-[var(--color-bg-subtle)] flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-[var(--color-fg-muted)]">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <h2 class="text-sm font-semibold">Chat <span id="chat-peer-label" class="font-normal text-[var(--color-fg-muted)]"></span></h2>
        <span id="chat-trusted-badge" class="hidden inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full bg-[var(--color-bg-muted)] border border-[var(--color-accent)] text-[var(--color-accent)] uppercase tracking-[0.06em] font-medium">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
          Trusted
        </span>
        <span class="ml-auto text-xs text-[var(--color-fg-subtle)]">End-to-end encrypted · Not saved anywhere</span>
      </header>

      <div id="chat-scroll" class="px-5 py-4 h-72 overflow-y-auto space-y-2 bg-[var(--color-bg)]">
        <p id="chat-empty" class="text-center text-sm text-[var(--color-fg-subtle)] py-12">
          No messages yet. Say hi 👋
        </p>
      </div>

      <div id="typing-indicator" class="hidden px-5 pb-2 flex items-center gap-2 text-xs text-[var(--color-fg-muted)]">
        <span class="inline-flex gap-1">
          <span class="size-1.5 rounded-full bg-[var(--color-fg-muted)] animate-pulse" style="animation-delay: 0ms"></span>
          <span class="size-1.5 rounded-full bg-[var(--color-fg-muted)] animate-pulse" style="animation-delay: 150ms"></span>
          <span class="size-1.5 rounded-full bg-[var(--color-fg-muted)] animate-pulse" style="animation-delay: 300ms"></span>
        </span>
        Peer is typing…
      </div>

      <form id="chat-form" class="border-t border-[var(--color-border)] p-3 flex gap-2 items-end bg-[var(--color-bg-subtle)]">
        <textarea
          id="chat-input"
          rows="1"
          placeholder="Type a message…"
          maxlength="2000"
          class="flex-1 resize-none rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2 text-sm leading-[1.4] min-h-10 max-h-32 focus:outline-none focus:border-[var(--color-accent)]"
          style="height: 40px;"
        ></textarea>
        <button
          id="chat-send"
          type="submit"
          disabled
          class="h-10 px-4 rounded-md bg-[var(--color-fg)] text-sm font-medium text-[var(--color-bg)] hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed transition-opacity"
        >Send</button>
      </form>
    </section>

    <!-- Warnings -->
    <div id="warnings" class="mt-6 space-y-3"></div>

    <p class="mt-10 text-xs text-[var(--color-fg-subtle)] text-center">
      Your files never touch a cloud.
      <a href={`${import.meta.env.BASE_URL}privacy`} class="underline hover:text-[var(--color-fg)] no-underline-children">Read how we keep it private →</a>
    </p>

    <!-- Keyboard-shortcut help overlay (toggled with ?) -->
    <div id="kbd-overlay" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="kbd-overlay-title">
      <div class="max-w-md w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] p-6 shadow-2xl">
        <div class="flex items-center justify-between mb-4">
          <h3 id="kbd-overlay-title" class="font-semibold">Keyboard shortcuts</h3>
          <button id="kbd-overlay-close" class="text-[var(--color-fg-subtle)] hover:text-[var(--color-fg)] text-xl leading-none" aria-label="Close">×</button>
        </div>
        <dl class="space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="text-[var(--color-fg-muted)]">Show this help</dt>
            <dd><kbd class="font-mono text-xs px-2 py-1 rounded border border-[var(--color-border)] bg-[var(--color-bg-subtle)]">?</kbd></dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-[var(--color-fg-muted)]">Close any overlay</dt>
            <dd><kbd class="font-mono text-xs px-2 py-1 rounded border border-[var(--color-border)] bg-[var(--color-bg-subtle)]">Esc</kbd></dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-[var(--color-fg-muted)]">Paste image/file from clipboard</dt>
            <dd>
              <kbd class="font-mono text-xs px-2 py-1 rounded border border-[var(--color-border)] bg-[var(--color-bg-subtle)]">Ctrl</kbd>
              <span class="text-[var(--color-fg-subtle)]">+</span>
              <kbd class="font-mono text-xs px-2 py-1 rounded border border-[var(--color-border)] bg-[var(--color-bg-subtle)]">V</kbd>
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-[var(--color-fg-muted)]">Send chat message</dt>
            <dd><kbd class="font-mono text-xs px-2 py-1 rounded border border-[var(--color-border)] bg-[var(--color-bg-subtle)]">Enter</kbd></dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-[var(--color-fg-muted)]">New line in chat</dt>
            <dd>
              <kbd class="font-mono text-xs px-2 py-1 rounded border border-[var(--color-border)] bg-[var(--color-bg-subtle)]">Shift</kbd>
              <span class="text-[var(--color-fg-subtle)]">+</span>
              <kbd class="font-mono text-xs px-2 py-1 rounded border border-[var(--color-border)] bg-[var(--color-bg-subtle)]">Enter</kbd>
            </dd>
          </div>
        </dl>
        <p class="mt-5 text-xs text-[var(--color-fg-subtle)]">
          Tip: drag & drop files (or whole folders) anywhere on this page to queue them.
        </p>
      </div>
    </div>
  </main>

  <script>
    import { TeleportSession, type PeerConnState, type DiagSnapshot } from "../lib/teleportSession";
    import { FileTransfer, saveFileToDisk } from "../lib/fileTransfer";
    import { ChatManager, type ChatMessage } from "../lib/chat";
    import { generateRoomId, formatBytes, formatRate, formatEta } from "../lib/format";
    import {
      listPairs, upsertPair, removePair, generatePairSecret,
      buildPairUrl, parsePairFragment, getAutoAccept, setAutoAccept,
      deriveRoomId,
      type Pair,
    } from "../lib/devicePairs";
    import { site } from "../site.config";
    import QRCode from "qrcode";
    import { downloadZip } from "client-zip";

    // ---------- DOM ----------
    const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
      document.getElementById(id) as T;

    const rolePicker = $("role-picker");
    const roleSendBtn = $<HTMLButtonElement>("role-send");
    const roleRecvBtn = $<HTMLButtonElement>("role-receive");
    const roleReceiveInput = $("role-receive-input");
    const roleReceiveLink = $<HTMLInputElement>("role-receive-link");
    const roleReceiveGo = $<HTMLButtonElement>("role-receive-go");
    const roleReceiveParanoid = $<HTMLButtonElement>("role-receive-paranoid");
    const statusCard = $("status-card");
    const statusDot = $("status-dot");
    const statusLabel = $("status-label");
    const statusDetail = $("status-detail");
    const statusRole = $("status-role");
    const statusUptime = $("status-uptime") as HTMLSpanElement;

    // ---------- Connection uptime ticker ----------
    let connectedSince = 0;
    let uptimeTimer: number | null = null;
    const fmtUptime = (ms: number) => {
      const s = Math.floor(ms / 1000);
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      const sec = s % 60;
      const pad = (n: number) => String(n).padStart(2, "0");
      return h > 0 ? `${h}:${pad(m)}:${pad(sec)}` : `${m}:${pad(sec)}`;
    };
    const tickUptime = () => {
      if (!connectedSince) return;
      statusUptime.textContent = fmtUptime(Date.now() - connectedSince);
    };
    const startUptime = () => {
      if (uptimeTimer) return;
      connectedSince = Date.now();
      statusUptime.classList.remove("hidden");
      tickUptime();
      uptimeTimer = window.setInterval(tickUptime, 1000);
    };
    const stopUptime = () => {
      if (uptimeTimer) { clearInterval(uptimeTimer); uptimeTimer = null; }
      connectedSince = 0;
      statusUptime.classList.add("hidden");
      statusUptime.textContent = "";
    };
    const diagGrid = $("diag-grid");
    const senderLink = $("sender-link");
    const shareLink = $<HTMLInputElement>("share-link");
    const copyLinkBtn = $<HTMLButtonElement>("copy-link");
    const shareLinkBtn = $<HTMLButtonElement>("share-link-btn");
    const qrToggle = $<HTMLButtonElement>("qr-toggle");
    const qrToggleLabel = $("qr-toggle-label");
    const qrWrap = $("qr-wrap");
    const qrCanvasBox = $("qr-canvas-box");
    const retryPanel = $("retry-panel");
    const retryBtn = $<HTMLButtonElement>("retry-btn");
    const retryParanoidBtn = $<HTMLButtonElement>("retry-paranoid");
    const paranoidToggle = $<HTMLInputElement>("paranoid-toggle");
    const paranoidPanel = $("paranoid-panel");
    const psSender = $("paranoid-sender");
    const psRecv = $("paranoid-receiver");
    const senderOfferBlob = $<HTMLTextAreaElement>("sender-offer-blob");
    const senderCopyOffer = $<HTMLButtonElement>("sender-copy-offer");
    const senderShareOffer = $<HTMLButtonElement>("sender-share-offer");
    const senderMarkShared = $<HTMLButtonElement>("sender-mark-shared");
    const psenderStep1 = $("psender-step1");
    const psenderStep2 = $("psender-step2");
    const senderAnswerBlob = $<HTMLTextAreaElement>("sender-answer-blob");
    const senderSubmitAnswer = $<HTMLButtonElement>("sender-submit-answer");
    const recvOfferBlob = $<HTMLTextAreaElement>("recv-offer-blob");
    const recvGenerateAnswer = $<HTMLButtonElement>("recv-generate-answer");
    const precvStep1 = $("precv-step1");
    const precvStep2 = $("precv-step2");
    const recvAnswerBlob = $<HTMLTextAreaElement>("recv-answer-blob");
    const recvCopyAnswer = $<HTMLButtonElement>("recv-copy-answer");
    const recvShareAnswer = $<HTMLButtonElement>("recv-share-answer");
    const transferPanel = $("transfer-panel");
    const dropZone = $("drop-zone");
    const fileInput = $<HTMLInputElement>("file-input");
    const folderInput = $<HTMLInputElement>("folder-input");
    const pickFolderBtn = $<HTMLButtonElement>("pick-folder-btn");
    const pendingQueueSection = $("pending-queue-section");
    const pendingQueueList = $<HTMLUListElement>("pending-queue");
    const pqCount = $("pq-count");
    const pqClear = $<HTMLButtonElement>("pq-clear");
    const pqReady = $("pq-ready");
    const pqReadyCount = $("pq-ready-count");
    const pqSend = $<HTMLButtonElement>("pq-send");
    const pqAuto = $<HTMLInputElement>("pq-auto");
    const pqHint = $("pq-hint");
    const receiverWait = $("receiver-wait");
    const fileList = $<HTMLUListElement>("file-list");
    const resetBar = $("reset-bar");
    const resetSummary = $("reset-summary");
    const resetClearBtn = $<HTMLButtonElement>("reset-clear");
    const resetSendMoreBtn = $<HTMLButtonElement>("reset-send-more");
    const peerHiddenBanner = $("peer-hidden-banner");
    const peerHiddenText = $("peer-hidden-text");
    const saveAllBar = $("save-all-bar");
    const saveAllSummary = $("save-all-summary");
    const saveAllBtn = $<HTMLButtonElement>("save-all-btn");
    const warnings = $("warnings");
    // Chat
    const chatPanel = $("chat-panel");
    const chatScroll = $<HTMLDivElement>("chat-scroll");
    const chatEmpty = $("chat-empty");
    const typingIndicator = $("typing-indicator");
    const chatForm = $<HTMLFormElement>("chat-form");
    const chatInput = $<HTMLTextAreaElement>("chat-input");
    const chatSend = $<HTMLButtonElement>("chat-send");

    // ---------- State ----------
    type Role = "sender" | "receiver";
    let role: Role | null = null;
    let session: TeleportSession | null = null;
    /** When auto-connect succeeds, we remember which pair "won" so the UI
     *  can surface the trusted badge + disconnect button. Cleared on
     *  destroy/disconnect. */
    let activePair: Pair | null = null;
    // One-shot auto-recovery: if a sender's connection fails, rebuild on a fresh
    // room without bothering the user. Reset on manual retry or successful link.
    let autoReconnectAttempted = false;
    let transfer: FileTransfer | null = null;
    let chat: ChatManager | null = null;
    let lastSessionState: PeerConnState | "idle" = "idle";
    let lastMessageTs = 0;

    // ---------- "Send another / Clear" reset bar ----------
    // Tracks completed transfer counts so we can show a helpful summary.
    let completedSendCount = 0;
    let completedSendBytes = 0;
    let completedRecvCount = 0;
    let completedRecvBytes = 0;

    const maybeShowResetBar = () => {
      // Show when nothing is actively transferring and at least one file finished
      const idle = !activeSendRow && !activeRecvRow && pendingQueue.length === 0;
      const anyCompleted = completedSendCount + completedRecvCount > 0;
      if (idle && anyCompleted) {
        const parts: string[] = [];
        if (completedSendCount > 0) {
          parts.push(`Sent ${completedSendCount} file${completedSendCount === 1 ? "" : "s"} (${formatBytes(completedSendBytes)})`);
        }
        if (completedRecvCount > 0) {
          parts.push(`Received ${completedRecvCount} file${completedRecvCount === 1 ? "" : "s"} (${formatBytes(completedRecvBytes)})`);
        }
        resetSummary.textContent = `${parts.join(" · ")}.`;
        // Sender gets the "Send more" CTA; receiver only gets "Clear list".
        resetSendMoreBtn.classList.toggle("hidden", role !== "sender");
        resetBar.classList.remove("hidden");
      } else {
        resetBar.classList.add("hidden");
      }
    };

    const clearCompletedRows = () => {
      // Remove all finished rows from the file list, reset counters.
      fileList.innerHTML = "";
      sendingRows.length = 0;
      receivingRows.length = 0;
      completedSendCount = 0;
      completedSendBytes = 0;
      completedRecvCount = 0;
      completedRecvBytes = 0;
      receivedItems.length = 0;
      saveAllBar.classList.add("hidden");
      resetBar.classList.add("hidden");
    };

    resetClearBtn.addEventListener("click", clearCompletedRows);
    resetSendMoreBtn.addEventListener("click", () => {
      clearCompletedRows();
      // Reopen file picker on click (same gesture chain — works on iOS too)
      fileInput.click();
    });

    // ---------- "Save all to folder" (receiver) ----------
    // Buffer received files until either user saves individually or
    // taps "Save all to folder" (uses showDirectoryPicker — Chromium-only).
    type ReceivedItem = { file: File; name: string; saved: boolean };
    const receivedItems: ReceivedItem[] = [];
    const supportsDirectoryPicker = typeof (window as unknown as { showDirectoryPicker?: unknown }).showDirectoryPicker === "function";

    const refreshSaveAllBar = () => {
      const unsaved = receivedItems.filter((r) => !r.saved);
      if (!supportsDirectoryPicker || unsaved.length < 2) {
        saveAllBar.classList.add("hidden");
        return;
      }
      const totalBytes = unsaved.reduce((a, r) => a + r.file.size, 0);
      saveAllSummary.textContent = `${unsaved.length} files ready (${formatBytes(totalBytes)})`;
      saveAllBar.classList.remove("hidden");
    };

    saveAllBtn.addEventListener("click", async () => {
      const unsaved = receivedItems.filter((r) => !r.saved);
      if (unsaved.length === 0) return;
      saveAllBtn.disabled = true;
      const originalText = saveAllBtn.textContent;
      saveAllBtn.textContent = "Picking folder…";
      try {
        const pickFn = (window as unknown as {
          showDirectoryPicker: (opts?: { mode?: "read" | "readwrite" }) => Promise<FileSystemDirectoryHandle>;
        }).showDirectoryPicker;
        const dir = await pickFn({ mode: "readwrite" });
        saveAllBtn.textContent = `Saving 0/${unsaved.length}…`;
        let saved = 0;
        for (const item of unsaved) {
          try {
            // Avoid clobbering: if file exists, append "-1", "-2", etc.
            const safeName = await uniqueName(dir, item.name);
            const fh = await dir.getFileHandle(safeName, { create: true });
            const w = await fh.createWritable();
            await item.file.stream().pipeTo(w);
            item.saved = true;
            saved += 1;
            saveAllBtn.textContent = `Saving ${saved}/${unsaved.length}…`;
          } catch (e) {
            addWarning(`Failed to save ${item.name}: ${(e as Error).message}`);
          }
        }
        saveAllBtn.textContent = `✓ Saved ${saved} files`;
        playDingComplete();
        vibrate(120);
        // Update individual row Save buttons to show they're already saved
        for (const item of receivedItems) {
          if (item.saved) markRowAsSaved(item.name);
        }
        setTimeout(() => {
          saveAllBtn.disabled = false;
          saveAllBtn.textContent = originalText || "Save all to folder";
          refreshSaveAllBar();
        }, 2000);
      } catch (e) {
        // User cancelled the picker — silent.
        if ((e as DOMException).name !== "AbortError") {
          addWarning(`Save all failed: ${(e as Error).message}`);
        }
        saveAllBtn.disabled = false;
        saveAllBtn.textContent = originalText || "Save all to folder";
      }
    });

    /** Probe for an unused filename in a directory: foo.png → foo-1.png if foo.png exists. */
    const uniqueName = async (dir: FileSystemDirectoryHandle, name: string): Promise<string> => {
      const dot = name.lastIndexOf(".");
      const stem = dot > 0 ? name.slice(0, dot) : name;
      const ext = dot > 0 ? name.slice(dot) : "";
      let candidate = name;
      let i = 0;
      while (i < 1000) {
        try {
          await dir.getFileHandle(candidate, { create: false });
          // Exists — try next
          i += 1;
          candidate = `${stem}-${i}${ext}`;
        } catch {
          return candidate;
        }
      }
      return `${stem}-${Date.now()}${ext}`;
    };

    /** Find the row showing this filename and mark its Save button as done. */
    const markRowAsSaved = (name: string) => {
      // Each row's action area has a Save button — find by walking receivingRows.
      for (const row of receivingRows) {
        if (row.name !== name) continue;
        const btn = row.action.querySelector('[data-act="save"]') as HTMLButtonElement | null;
        const hint = row.action.querySelector('[data-act="hint"]') as HTMLElement | null;
        if (btn && !btn.disabled) {
          btn.disabled = true;
          btn.textContent = "✓ Saved to folder";
        }
        if (hint) hint.textContent = "Saved via Save all.";
      }
    };


    // ---------- Local tab visibility → notify peer ----------
    // Fires whenever this tab goes background/foreground. Peer shows a
    // banner so they understand why throughput may drop on mobile.
    let lastVisibility: boolean | null = null;
    document.addEventListener("visibilitychange", () => {
      const hidden = document.visibilityState === "hidden";
      if (hidden === lastVisibility) return;
      lastVisibility = hidden;
      chat?.sendVisibility(hidden);
    });


    const SOUND_KEY = "p2pds:sound";

    // ---------- Device nickname ----------
    const NAME_KEY = "p2pds:name";
    const myNameInput = $<HTMLInputElement>("my-name");
    let myName: string = "";
    try { myName = localStorage.getItem(NAME_KEY) || ""; } catch {}
    myNameInput.value = myName;
    let peerName: string = "";

    const refreshIdentityLabels = () => {
      // Header status pill: "You · Shrestha" or fallback to Sender/Receiver
      if (myName && peerName) {
        statusRole.textContent = `${myName} ↔ ${peerName}`;
      } else if (myName) {
        statusRole.textContent = `${myName} · ${role === "receiver" ? "Receiver" : "Sender"}`;
      } else if (peerName) {
        statusRole.textContent = `${role === "receiver" ? "Receiver" : "Sender"} ↔ ${peerName}`;
      } else {
        statusRole.textContent = role === "receiver" ? "Receiver" : "Sender";
      }
      // Chat header "End-to-end encrypted · Not saved anywhere" — append peer name
      const chatPeerLabel = document.getElementById("chat-peer-label");
      if (chatPeerLabel) {
        chatPeerLabel.textContent = peerName ? `with ${peerName}` : "";
      }
    };

    myNameInput.addEventListener("input", () => {
      const v = myNameInput.value.trim().slice(0, 40);
      myName = v;
      try { localStorage.setItem(NAME_KEY, myName); } catch {}
      refreshIdentityLabels();
      // Push update to peer if chat already exists
      if (chat) chat.setMyName(myName);
    });

    let soundOn = true;
    try { soundOn = localStorage.getItem(SOUND_KEY) !== "0"; } catch {}
    const soundToggle = $<HTMLButtonElement>("sound-toggle");
    const soundIconOn = $("sound-icon-on");
    const soundIconOff = $("sound-icon-off");
    const refreshSoundIcon = () => {
      soundIconOn.classList.toggle("hidden", !soundOn);
      soundIconOff.classList.toggle("hidden", soundOn);
    };
    refreshSoundIcon();
    soundToggle.addEventListener("click", () => {
      soundOn = !soundOn;
      try { localStorage.setItem(SOUND_KEY, soundOn ? "1" : "0"); } catch {}
      refreshSoundIcon();
      // Tiny ping on enable so user gets feedback the sound works
      if (soundOn) playTone(660, 0.08, 0.04);
    });

    // Lazy AudioContext — Safari blocks creation until a user gesture, so
    // we create on first toggle/play attempt.
    let audioCtx: AudioContext | null = null;
    const ensureCtx = (): AudioContext | null => {
      if (audioCtx) return audioCtx;
      try {
        const Ctx = (window as unknown as { AudioContext?: typeof AudioContext; webkitAudioContext?: typeof AudioContext }).AudioContext
          || (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (Ctx) audioCtx = new Ctx();
      } catch { /* ignore */ }
      return audioCtx;
    };

    /** Play a short tone. freq Hz, duration s, volume 0..1 */
    const playTone = (freq: number, duration: number, volume = 0.06) => {
      if (!soundOn) return;
      const ctx = ensureCtx();
      if (!ctx) return;
      try {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.value = freq;
        // Smooth attack/decay — no clicks
        const now = ctx.currentTime;
        gain.gain.setValueAtTime(0, now);
        gain.gain.linearRampToValueAtTime(volume, now + 0.01);
        gain.gain.linearRampToValueAtTime(0, now + duration);
        osc.connect(gain).connect(ctx.destination);
        osc.start(now);
        osc.stop(now + duration + 0.02);
      } catch { /* AudioContext suspended or failed — silent */ }
    };

    const vibrate = (pattern: number | number[]) => {
      if (!soundOn) return;
      try { navigator.vibrate?.(pattern); } catch { /* ignore */ }
    };

    /** Major-third "ding" — friendly for "done" notifications */
    const playDingComplete = () => {
      playTone(880, 0.12, 0.06);
      setTimeout(() => playTone(1108, 0.18, 0.05), 90); // C#6 follow
    };
    /** Short rising chirp — peer just joined */
    const playConnectChirp = () => {
      playTone(523, 0.08, 0.05); // C5
      setTimeout(() => playTone(784, 0.10, 0.05), 70); // G5
    };
    /** Low buzz — something went wrong */
    const playFailBuzz = () => {
      playTone(220, 0.18, 0.06);
    };

    // ---------- Tab title progress ----------
    const originalTitle = document.title;
    let titleResetTimer: number | undefined;
    const setTabTitle = (text: string, autoResetMs?: number) => {
      document.title = text;
      if (titleResetTimer) clearTimeout(titleResetTimer);
      if (autoResetMs) {
        titleResetTimer = window.setTimeout(() => { document.title = originalTitle; }, autoResetMs);
      }
    };

    // Throttle title updates during transfer so we don't thrash on every progress event
    let lastTitlePct = -1;
    const updateTitleProgress = (bytes: number, total: number, prefix: string) => {
      const pct = total > 0 ? Math.round((bytes / total) * 100) : 0;
      if (pct === lastTitlePct) return;
      lastTitlePct = pct;
      setTabTitle(`(${pct}%) ${prefix} · ${originalTitle.split(" | ")[1] || "Local Teleport"}`);
    };


    // ---------- Helpers ----------
    const setStatus = (s: PeerConnState, detail = "") => {
      const map: Record<PeerConnState, { label: string; color: string }> = {
        idle: { label: "Idle", color: "var(--color-fg-subtle)" },
        signaling: { label: "Waiting for peer to join…", color: "var(--color-warning)" },
        connecting: { label: "Connecting…", color: "var(--color-warning)" },
        connected: { label: "Connected — peer linked", color: "var(--color-success)" },
        disconnected: { label: "Disconnected", color: "var(--color-fg-subtle)" },
        failed: { label: "Connection failed", color: "var(--color-danger)" },
      };
      const { label, color } = map[s];
      statusLabel.textContent = label;
      statusDot.style.background = color;
      statusDetail.textContent = detail;
      if (s === "connected") startUptime(); else stopUptime();
    };

    /**
     * Render a much more honest status line based on the live diag snapshot.
     * Walks through the actual handshake stages so the user (and we) can
     * tell exactly where things are stuck.
     */
    const updateLiveStatus = (d: DiagSnapshot) => {
      // Already connected? Don't second-guess.
      if (d.peerConnection === "connected") {
        setStatus("connected", `${d.candidateTypes.relay > 0 ? "Relayed via TURN" : "Direct P2P"} · ${d.candidatesGathered} local / ${d.candidatesReceived} remote candidates`);
        return;
      }
      if (d.peerConnection === "failed") {
        setStatus(
          "failed",
          `ICE could not find a working path. Local: ${candSummary(d.candidateTypes)} · Got ${d.candidatesReceived} candidates from peer. Likely cause: strict NAT or no TURN.`,
        );
        return;
      }

      // Sender flow
      if (role === "sender") {
        if (d.ws === "idle" || d.ws === "connecting") {
          setStatus("signaling", `Connecting to signaling server (${d.ws})…`);
        } else if (d.ws === "open" && d.candidatesGathered === 0) {
          setStatus("signaling", "Gathering your network candidates (STUN/TURN)…");
        } else if (d.ws === "open" && d.candidatesReceived === 0 && d.peerConnection !== "connecting") {
          setStatus(
            "signaling",
            `Waiting for receiver to open your link. Your handshake is ready (${d.candidatesGathered} candidates, ${candSummary(d.candidateTypes)}).`,
          );
        } else if (d.peerConnection === "connecting" || d.peerConnection === "new") {
          setStatus(
            "connecting",
            `Receiver joined. Negotiating direct path — got ${d.candidatesReceived} of their candidates so far (ICE: ${d.iceConnection}).`,
          );
        } else if (d.ws === "closed") {
          setStatus("signaling", "Signaling offline — will auto-reconnect when you return to this tab.");
        } else {
          setStatus("signaling", `WS:${d.ws} ICE:${d.iceConnection} Peer:${d.peerConnection}`);
        }
      } else {
        // Receiver flow
        if (d.ws === "idle" || d.ws === "connecting") {
          setStatus("signaling", "Connecting to signaling server…");
        } else if (d.ws === "open" && d.candidatesReceived === 0 && !d.peerHasOffer) {
          setStatus("signaling", "Connected to room — waiting for sender's invite to arrive…");
        } else if (d.peerHasOffer && d.candidatesGathered === 0) {
          setStatus("signaling", "Got the invite. Gathering your network candidates…");
        } else if (d.peerConnection === "connecting" || d.peerConnection === "new") {
          setStatus(
            "connecting",
            `Negotiating with sender — ${d.candidatesGathered} local / ${d.candidatesReceived} remote candidates (ICE: ${d.iceConnection}).`,
          );
        } else if (d.ws === "closed") {
          setStatus("signaling", "Signaling offline — will reconnect.");
        } else {
          setStatus("signaling", `WS:${d.ws} ICE:${d.iceConnection} Peer:${d.peerConnection}`);
        }
      }
    };

    const candSummary = (t: DiagSnapshot["candidateTypes"]) => {
      const bits: string[] = [];
      if (t.host) bits.push(`${t.host} local`);
      if (t.srflx) bits.push(`${t.srflx} STUN`);
      if (t.relay) bits.push(`${t.relay} TURN`);
      if (t.prflx) bits.push(`${t.prflx} reflexive`);
      return bits.length ? bits.join(", ") : "none yet";
    };

    const renderDiag = (d: DiagSnapshot) => {
      const cell = (k: string, v: string, color = "var(--color-fg)") => `
        <div class="rounded border border-[var(--color-border)] bg-[var(--color-bg)] px-2 py-1.5">
          <div class="text-[10px] uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">${k}</div>
          <div class="text-xs truncate" style="color:${color}">${v}</div>
        </div>
      `;
      const colorFor = (v: string, good: string[], bad: string[]) =>
        good.includes(v) ? "var(--color-success)" : bad.includes(v) ? "var(--color-danger)" : "var(--color-fg-muted)";
      diagGrid.innerHTML =
        cell("Signaling WS", d.ws, colorFor(d.ws, ["open"], ["closed"])) +
        cell("ICE gathering", d.iceGathering, colorFor(d.iceGathering, ["complete"], [])) +
        cell("ICE connection", d.iceConnection, colorFor(d.iceConnection, ["connected", "completed"], ["failed", "disconnected"])) +
        cell("Peer connection", d.peerConnection, colorFor(d.peerConnection, ["connected"], ["failed"])) +
        cell("Data channel", d.dataChannel, colorFor(d.dataChannel, ["open"], ["closed"])) +
        cell("Has offer", d.peerHasOffer ? "yes" : "no") +
        cell("Local candidates", `${d.candidatesGathered}`) +
        cell("Remote candidates", `${d.candidatesReceived}`) +
        cell("Cand types", candSummary(d.candidateTypes)) +
        cell("Peak throughput", peakRatePerSec > 0 ? formatRate(peakRatePerSec) : "—",
          peakRatePerSec > 0 ? "var(--color-success)" : "var(--color-fg-muted)") +
        cell("Session ↑ sent",
          sessionBytesSent > 0 ? formatBytes(sessionBytesSent) : "—",
          sessionBytesSent > 0 ? "var(--color-fg)" : "var(--color-fg-muted)") +
        cell("Session ↓ recv",
          sessionBytesRecv > 0 ? formatBytes(sessionBytesRecv) : "—",
          sessionBytesRecv > 0 ? "var(--color-fg)" : "var(--color-fg-muted)");
    };

    const addWarning = (msg: string) => {
      const el = document.createElement("div");
      el.className =
        "rounded-md border border-[var(--color-warning)] bg-[color-mix(in_srgb,var(--color-warning)_10%,transparent)] p-3 text-sm";
      el.textContent = msg;
      warnings.appendChild(el);
    };

    const lockStep = (el: HTMLElement, locked: boolean) => {
      if (locked) {
        el.classList.add("opacity-40", "pointer-events-none");
        el.classList.remove("border-2", "border-[var(--color-accent)]");
        el.classList.add("border", "border-[var(--color-border)]");
      } else {
        el.classList.remove("opacity-40", "pointer-events-none");
        el.classList.remove("border", "border-[var(--color-border)]");
        el.classList.add("border-2", "border-[var(--color-accent)]");
      }
    };

    const peekBlobType = (blob: string): "offer" | "answer" | "empty" | "invalid" => {
      if (!blob || !blob.trim()) return "empty";
      try {
        const json = JSON.parse(decodeURIComponent(escape(atob(blob.trim()))));
        if (json?.type === "offer" || json?.type === "answer") return json.type;
        return "invalid";
      } catch {
        return "invalid";
      }
    };

    // ---------- File row UI ----------
    type Row = {
      el: HTMLLIElement;
      bar: HTMLElement;
      pct: HTMLElement;
      bytes: HTMLElement;
      rate: HTMLElement;
      eta: HTMLElement;
      action: HTMLElement;
      resume: HTMLElement;
      name: string;
    };
    const sendingRows: Row[] = [];
    let activeSendRow: Row | null = null;
    const receivingRows: Row[] = [];
    let activeRecvRow: Row | null = null;

    const makeRow = (name: string, kind: "send" | "recv"): Row => {
      const el = document.createElement("li");
      el.className = "rounded-lg border border-[var(--color-border)] p-4";
      el.innerHTML = `
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 min-w-0">
            <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-bg-muted)] uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">
              ${kind === "send" ? "Sending" : "Receiving"}
            </span>
            <span class="font-medium truncate" data-field="name"></span>
            <span class="hidden text-[10px] px-1.5 py-0.5 rounded-full bg-[var(--color-bg-muted)] text-[var(--color-accent)] border border-[var(--color-accent)] uppercase tracking-[0.06em] font-medium shrink-0" data-field="resume"></span>
          </div>
          <span class="text-sm text-[var(--color-fg-muted)] tabular-nums" data-field="pct">0%</span>
        </div>
        <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-[var(--color-bg-muted)]">
          <div class="h-full w-0 bg-[var(--color-accent)] transition-[width] duration-150" data-field="bar"></div>
        </div>
        <div class="mt-3 flex justify-between text-xs text-[var(--color-fg-muted)] tabular-nums">
          <span data-field="bytes">0 B / —</span>
          <span data-field="rate">0 B/s</span>
          <span data-field="eta">ETA —</span>
        </div>
        <div data-field="action" class="mt-3 hidden"></div>
      `;
      const q = (s: string) => el.querySelector(`[data-field="${s}"]`) as HTMLElement;
      q("name").textContent = name;
      fileList.appendChild(el);
      return {
        el, name,
        bar: q("bar"),
        pct: q("pct"),
        bytes: q("bytes"),
        rate: q("rate"),
        eta: q("eta"),
        action: q("action"),
        resume: q("resume"),
      };
    };

    /** Highest sustained throughput observed this session, in bytes/sec.
     *  Updated from every progress tick; surfaced in the diagnostics panel
     *  so the user can see what their network actually achieved. */
    let peakRatePerSec = 0;
    /** Total bytes moved across all completed + in-flight rows this session,
     *  for both send and receive. Used by the diagnostics "Session total" cell. */
    let sessionBytesSent = 0;
    let sessionBytesRecv = 0;
    /** Per-row last-seen bytes so we can compute deltas without double-counting. */
    const lastRowBytes = new WeakMap<Row, number>();

    const updateRow = (row: Row, p: { bytes: number; total: number; ratePerSec: number; etaSec: number }) => {
      const pct = p.total > 0 ? Math.min(100, (p.bytes / p.total) * 100) : 0;
      row.pct.textContent = `${pct.toFixed(1)}%`;
      row.bar.style.width = `${pct}%`;
      row.bytes.textContent = `${formatBytes(p.bytes)} / ${formatBytes(p.total)}`;
      row.rate.textContent = formatRate(p.ratePerSec);
      row.eta.textContent = `ETA ${formatEta(p.etaSec)}`;
      // Track peak — ignore the initial 0s and any wildly-spiking single-tick
      // values during channel buffering by only counting rates above 1 KB/s.
      if (p.ratePerSec > peakRatePerSec && p.ratePerSec > 1024) {
        peakRatePerSec = p.ratePerSec;
      }
      // Track session totals as monotonic deltas per row.
      const prev = lastRowBytes.get(row) ?? 0;
      const delta = Math.max(0, p.bytes - prev);
      if (delta > 0) {
        lastRowBytes.set(row, p.bytes);
        // Sender rows live in sendRowsById; receiver rows in recvRowsById.
        // Cheaper than a lookup: rely on the row's text label set at creation.
        if (row.el.textContent?.includes("Sending")) sessionBytesSent += delta;
        else sessionBytesRecv += delta;
      }
    };

    // ---------- File preview ----------
    /**
     * Detect what kind of preview we can render for a received file.
     * Returns the HTML markup; wirePreview() attaches handlers after insert.
     */
    type PreviewKind = "image" | "svg" | "video" | "audio" | "pdf" | "text" | "none";

    const detectPreviewKind = (file: File, name: string): PreviewKind => {
      const ext = name.toLowerCase().split(".").pop() ?? "";
      const mime = file.type.toLowerCase();
      if (mime.startsWith("image/") && mime !== "image/svg+xml") return "image";
      if (mime === "image/svg+xml" || ext === "svg") return "svg";
      if (mime.startsWith("video/")) return "video";
      if (mime.startsWith("audio/")) return "audio";
      if (mime === "application/pdf" || ext === "pdf") return "pdf";
      if (
        mime.startsWith("text/") ||
        mime === "application/json" ||
        mime === "application/xml" ||
        ["txt", "md", "csv", "tsv", "json", "xml", "yaml", "yml", "ts", "js", "tsx", "jsx", "py", "sh", "html", "css", "log", "ini", "conf", "toml"].includes(ext)
      ) {
        return "text";
      }
      return "none";
    };

    // Cap previews so we don't churn through huge files in-browser.
    const MAX_IMAGE_PREVIEW = 25 * 1024 * 1024; // 25 MB
    const MAX_VIDEO_PREVIEW = 200 * 1024 * 1024; // 200 MB
    const MAX_TEXT_PREVIEW = 1 * 1024 * 1024; // 1 MB

    const buildPreview = (file: File, meta: { size: number; name: string }): string => {
      const kind = detectPreviewKind(file, meta.name);
      const wrap = (inner: string) =>
        `<div class="mt-3 rounded-lg border border-[var(--color-border)] overflow-hidden bg-[var(--color-bg-subtle)]" data-preview="${kind}">${inner}</div>`;

      switch (kind) {
        case "image":
        case "svg":
          if (meta.size > MAX_IMAGE_PREVIEW) {
            return wrap(`<p class="p-4 text-xs text-[var(--color-fg-subtle)] text-center">Image too large to preview (${formatBytes(meta.size)}) — save and open instead.</p>`);
          }
          return wrap(`<img data-pv="img" alt="${escapeAttr(meta.name)}" class="block max-h-80 w-auto mx-auto" />`);

        case "video":
          if (meta.size > MAX_VIDEO_PREVIEW) {
            return wrap(`<p class="p-4 text-xs text-[var(--color-fg-subtle)] text-center">Video too large to preview (${formatBytes(meta.size)}) — save and open instead.</p>`);
          }
          return wrap(`<video data-pv="video" controls preload="metadata" class="block max-h-80 w-full bg-black"></video>`);

        case "audio":
          return wrap(`<audio data-pv="audio" controls preload="metadata" class="block w-full"></audio>`);

        case "pdf":
          return wrap(`
            <div class="p-3 flex items-center gap-3">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-[var(--color-fg-muted)] shrink-0">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium truncate">${escapeText(meta.name)}</p>
                <p class="text-xs text-[var(--color-fg-subtle)]">PDF · ${formatBytes(meta.size)}</p>
              </div>
              <button data-pv="pdf-open" class="h-8 rounded-md border border-[var(--color-border)] px-3 text-xs hover:bg-[var(--color-bg-muted)]">Open in new tab</button>
            </div>
          `);

        case "text":
          if (meta.size > MAX_TEXT_PREVIEW) {
            return wrap(`<p class="p-4 text-xs text-[var(--color-fg-subtle)] text-center">Text file too large to preview (${formatBytes(meta.size)}) — save and open instead.</p>`);
          }
          return wrap(`
            <div class="flex items-center justify-between px-3 py-2 border-b border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
              <span class="text-[10px] uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">Text preview</span>
              <button data-pv="copy-text" class="h-7 rounded-md border border-[var(--color-border)] px-2.5 text-xs font-medium hover:bg-[var(--color-bg-muted)] inline-flex items-center gap-1.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span data-pv="copy-text-label">Copy</span>
              </button>
            </div>
            <pre data-pv="text" class="m-0 p-3 text-xs font-mono leading-relaxed max-h-80 overflow-auto whitespace-pre-wrap break-words text-[var(--color-fg)]">Loading…</pre>
          `);

        default:
          return ""; // no preview for unknown / binary types
      }
    };

    /**
     * Hook up post-insertion logic for any preview that needs JS — sets
     * blob URLs on media tags, fills text content, wires the PDF button.
     * Uses one URL per preview and revokes it when the row is removed.
     */
    const wirePreview = (container: HTMLElement, file: File, meta: { name: string }) => {
      const pv = container.querySelector("[data-preview]") as HTMLElement | null;
      if (!pv) return;
      const kind = pv.dataset.preview as PreviewKind;

      const makeUrl = () => URL.createObjectURL(file);
      let createdUrl: string | null = null;

      if (kind === "image" || kind === "svg") {
        const img = pv.querySelector('[data-pv="img"]') as HTMLImageElement;
        createdUrl = makeUrl();
        img.src = createdUrl;
        img.onload = img.onerror = () => {
          if (createdUrl) setTimeout(() => URL.revokeObjectURL(createdUrl!), 60_000);
        };
      } else if (kind === "video") {
        const vid = pv.querySelector('[data-pv="video"]') as HTMLVideoElement;
        createdUrl = makeUrl();
        vid.src = createdUrl;
      } else if (kind === "audio") {
        const audio = pv.querySelector('[data-pv="audio"]') as HTMLAudioElement;
        createdUrl = makeUrl();
        audio.src = createdUrl;
      } else if (kind === "pdf") {
        const btn = pv.querySelector('[data-pv="pdf-open"]') as HTMLButtonElement;
        btn.onclick = () => {
          const u = makeUrl();
          window.open(u, "_blank", "noopener");
          // Revoke after a minute so the new tab has time to load.
          setTimeout(() => URL.revokeObjectURL(u), 60_000);
        };
      } else if (kind === "text") {
        const pre = pv.querySelector('[data-pv="text"]') as HTMLPreElement;
        const copyBtn = pv.querySelector('[data-pv="copy-text"]') as HTMLButtonElement | null;
        const copyLabel = pv.querySelector('[data-pv="copy-text-label"]') as HTMLElement | null;
        let fullText = "";
        file.text()
          .then((text) => {
            fullText = text;
            // Cap rendered length so a 1MB JSON doesn't lock the UI.
            const MAX_RENDER = 50_000;
            pre.textContent = text.length > MAX_RENDER
              ? `${text.slice(0, MAX_RENDER)}\n\n… (${formatBytes(file.size - MAX_RENDER)} more — save to see full file)`
              : text;
          })
          .catch((e) => {
            pre.textContent = `(Could not read text: ${(e as Error).message})`;
          });
        if (copyBtn && copyLabel) {
          copyBtn.addEventListener("click", async () => {
            if (!fullText) return;
            try {
              await navigator.clipboard.writeText(fullText);
              copyLabel.textContent = `✓ Copied (${formatBytes(new Blob([fullText]).size)})`;
              setTimeout(() => { copyLabel.textContent = "Copy"; }, 2000);
            } catch (err) {
              copyLabel.textContent = "Failed";
              addWarning(`Copy failed: ${(err as Error).message}`);
              setTimeout(() => { copyLabel.textContent = "Copy"; }, 2000);
            }
          });
        }
      }
    };

    const escapeText = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
    const escapeAttr = (s: string) => escapeText(s);

    // ---------- Wire session ----------
    const wireSession = (s: TeleportSession) => {
      transfer = new FileTransfer(s);
      chat = new ChatManager(s);
      wireChat(chat);
      // Push current local nickname to peer (no-op if empty)
      if (myName) chat.setMyName(myName);
      // Push current local visibility so peer's banner is correct from t=0
      chat.sendVisibility(document.visibilityState === "hidden");
      // Listen for peer's nickname announcement
      chat.emitter.on("peerHello", ({ name }) => {
        const isFirst = !peerName;
        peerName = name;
        refreshIdentityLabels();
        if (isFirst) {
          addWarning(`👋 ${name} connected`);
          // Auto-clear that toast after 5s
          setTimeout(() => {
            const toasts = warnings.querySelectorAll("div");
            toasts.forEach((t) => {
              if (t.textContent?.includes(`👋 ${name} connected`)) t.remove();
            });
          }, 5000);
        }
      });

      // Listen for peer's tab visibility — show banner so user knows
      // why a transfer might suddenly slow down (mobile bg throttling).
      chat.emitter.on("peerVisibility", ({ hidden }) => {
        if (hidden) {
          const who = peerName ? `${peerName}'s tab` : "Peer's tab";
          peerHiddenText.textContent = `${who} is in the background.`;
          peerHiddenBanner.classList.remove("hidden");
        } else {
          peerHiddenBanner.classList.add("hidden");
        }
      });

      s.emitter.on("diag", (d) => {
        renderDiag(d);
        updateLiveStatus(d);
      });

      s.emitter.on("state", (state) => {
        const prevState = lastSessionState;
        lastSessionState = state;
        setStatus(state);
        if (state === "connected") {
          // Audio chirp + buzz only on the FIRST connect (not on reconnect),
          // to avoid spamming on flaky networks.
          if (prevState !== "connected") {
            playConnectChirp();
            vibrate(80);
          }
          transferPanel.classList.remove("hidden");
          senderLink.classList.add("hidden");
          retryPanel.classList.add("hidden");
          paranoidPanel.classList.add("hidden");
          // Successful link — re-arm one-shot auto-recovery for next failure.
          autoReconnectAttempted = false;
          // Surface the manual-disconnect button on every successful connect.
          const discBtn = document.getElementById("manual-disconnect");
          if (discBtn) discBtn.classList.remove("hidden");
          chatPanel.classList.remove("hidden");
          // Re-enable chat in case it was disabled by a transient disconnect.
          chatInput.disabled = false;
          chatInput.placeholder = "Type a message…";
          chatSend.disabled = chatInput.value.trim().length === 0;
          if (role === "receiver") {
            dropZone.classList.add("hidden");
            receiverWait.classList.remove("hidden");
          } else {
            receiverWait.classList.add("hidden");
            dropZone.classList.remove("hidden");
            // Sender: if there's a pre-queued batch, either auto-flush or show "Send all" CTA
            if (pendingQueue.length > 0) {
              if (pqAuto.checked) {
                flushPendingQueue();
              } else {
                pqReady.classList.remove("hidden");
                pqHint.textContent = "Drag to reorder. Tap Send all to start.";
              }
            }
          }
        }
        if (state === "failed") {
          // Hard failure recovery — there are three distinct paths:
          //
          //   (1) Paired auto-connect was active → the peer probably just
          //       refreshed/closed their tab. Don't show error UI; just
          //       destroy this session, hide the trusted/transfer bits,
          //       and re-run bootDevicesAuto so we get back to "Waiting
          //       for your devices..." and reconnect when the peer returns.
          //   (2) Sender on a random ?r= room, first failure of this session
          //       → mint a fresh room transparently (existing behavior).
          //   (3) Anything else → manual retry panel.
          if (activePair) {
            const lostPair = activePair;
            try { session?.destroy(); } catch {}
            session = null;
            role = null;
            activePair = null;
            // Reset UI bits that only make sense when connected.
            transferPanel.classList.add("hidden");
            chatPanel.classList.add("hidden");
            senderLink.classList.add("hidden");
            dropZone.classList.add("hidden");
            receiverWait.classList.add("hidden");
            const badge = document.getElementById("chat-trusted-badge");
            if (badge) badge.classList.add("hidden");
            const discBtn = document.getElementById("manual-disconnect");
            if (discBtn) discBtn.classList.add("hidden");
            renderDevices();
            addWarning(`${lostPair.nickname} disconnected — waiting for it to come back…`);
            setStatus("signaling", `Lost connection to ${lostPair.nickname}. Will auto-reconnect when it returns.`);
            // Restart paired auto-connect after a brief settle.
            setTimeout(() => { bootDevicesAuto(); }, 800);
            return;
          }
          if (role === "sender" && !autoReconnectAttempted) {
            autoReconnectAttempted = true;
            senderLink.classList.add("hidden");
            paranoidPanel.classList.add("hidden");
            retryPanel.classList.add("hidden");
            setStatus("connecting", "Connection failed — rebuilding on a fresh room…");
            // Brief delay so the user sees the message + the session can settle.
            setTimeout(() => {
              try { session?.close(); } catch {}
              // Strip the stale ?r= so bootRole mints a fresh one.
              const cleanUrl = `${location.origin}${import.meta.env.BASE_URL}transfer`;
              history.replaceState({}, "", cleanUrl);
              bootRole();
            }, 800);
            return;
          }
          // Already auto-recovered once, or we're the receiver — surface the
          // manual retry UI like before.
          senderLink.classList.add("hidden");
          paranoidPanel.classList.add("hidden");
          retryPanel.classList.remove("hidden");
          chatSend.disabled = true;
          chatInput.disabled = true;
          chatInput.placeholder = "Peer disconnected";
          playFailBuzz();
          vibrate([100, 60, 100]);
          setTabTitle(`✗ Disconnected · ${originalTitle.split(" | ")[1] || "Local Teleport"}`, 5000);
        }
        // NOTE: 'disconnected' is transient on mobile networks (ICE
        // renegotiation) — we deliberately do NOT disable chat on it.
        // Only 'failed' is terminal.
      });

      s.emitter.on("error", (e) => {
        addWarning(e.message);
        // Show the retry UI on ANY error during signaling (not just
        // hard ICE failures). Hides the share link so user doesn't
        // keep sending out a dead URL.
        if (statusLabel.textContent !== "Connected — peer linked") {
          senderLink.classList.add("hidden");
          paranoidPanel.classList.add("hidden");
          retryPanel.classList.remove("hidden");
          setStatus("failed", e.message);
        }
      });

      // Track rows by file id so retries reuse the existing row
      // instead of stacking duplicates on every reconnect.
      const sendRowsById = new Map<string, Row>();
      const recvRowsById = new Map<string, Row>();

      const showResumeBadge = (row: Row, resumedFrom: number, total: number) => {
        if (resumedFrom > 0) {
          const pct = total > 0 ? Math.round((resumedFrom / total) * 100) : 0;
          row.resume.textContent = `Resumed at ${pct}%`;
          row.resume.classList.remove("hidden");
        }
      };

      transfer.emitter.on("sendStart", (m) => {
        const existing = m.id ? sendRowsById.get(m.id) : undefined;
        if (existing) {
          activeSendRow = existing;
          showResumeBadge(existing, m.resumedFrom ?? 0, m.size);
        } else {
          activeSendRow = makeRow(m.name, "send");
          sendingRows.push(activeSendRow);
          if (m.id) sendRowsById.set(m.id, activeSendRow);
          showResumeBadge(activeSendRow, m.resumedFrom ?? 0, m.size);
        }
      });
      transfer.emitter.on("sendProgress", (p) => {
        if (activeSendRow) updateRow(activeSendRow, p);
        updateTitleProgress(p.bytes, p.total, "Sending");
      });
      transfer.emitter.on("sendComplete", (m) => {
        if (activeSendRow) {
          activeSendRow.action.classList.remove("hidden");
          activeSendRow.action.innerHTML = `<span class="text-sm text-[var(--color-success)]">✓ Sent ${formatBytes(m.size)}</span>`;
        }
        activeSendRow = null;
        completedSendCount += 1;
        completedSendBytes += m.size;
        playDingComplete();
        vibrate(120);
        setTabTitle(`✓ Sent · ${originalTitle.split(" | ")[1] || "Local Teleport"}`, 3000);
        lastTitlePct = -1;
        maybeShowResetBar();
      });

      transfer.emitter.on("receiveStart", (m) => {
        receiverWait.classList.add("hidden");
        const existing = m.id ? recvRowsById.get(m.id) : undefined;
        if (existing) {
          activeRecvRow = existing;
          showResumeBadge(existing, m.resumedFrom ?? 0, m.size);
        } else {
          activeRecvRow = makeRow(m.name, "recv");
          receivingRows.push(activeRecvRow);
          if (m.id) recvRowsById.set(m.id, activeRecvRow);
          showResumeBadge(activeRecvRow, m.resumedFrom ?? 0, m.size);
        }
      });
      transfer.emitter.on("receiveProgress", (p) => {
        if (activeRecvRow) updateRow(activeRecvRow, p);
        updateTitleProgress(p.bytes, p.total, "Receiving");
      });
      transfer.emitter.on("receiveComplete", ({ meta, file }) => {
        playDingComplete();
        vibrate([80, 40, 80]);
        setTabTitle(`✓ Received · ${originalTitle.split(" | ")[1] || "Local Teleport"}`, 3000);
        lastTitlePct = -1;
        completedRecvCount += 1;
        completedRecvBytes += meta.size;
        // Buffer for "Save all to folder"
        receivedItems.push({ file, name: meta.name, saved: false });
        refreshSaveAllBar();
        if (activeRecvRow) {
          const row = activeRecvRow;
          row.action.classList.remove("hidden");
          const preview = buildPreview(file, meta);
          row.action.innerHTML = `
            ${preview}
            <div class="flex items-center gap-2 flex-wrap mt-3">
              <button class="h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90" data-act="save">Save to disk</button>
              <span class="text-xs text-[var(--color-fg-subtle)]" data-act="hint">Pick where to save the file on your device</span>
            </div>
          `;
          const btn = row.action.querySelector('[data-act="save"]') as HTMLButtonElement;
          const hint = row.action.querySelector('[data-act="hint"]') as HTMLElement;
          btn.onclick = async () => {
            btn.disabled = true;
            btn.textContent = "Saving…";
            try {
              const result = await saveFileToDisk(file, meta.name);
              if (result === "saved" || result === "downloaded") {
                // Mark this item as saved so it drops out of "Save all" tally
                const entry = receivedItems.find((r) => r.name === meta.name && !r.saved);
                if (entry) entry.saved = true;
                refreshSaveAllBar();
              }
              if (result === "saved") {
                btn.textContent = "✓ Saved to disk";
                hint.textContent = "File written to the location you chose.";
              } else if (result === "downloaded") {
                btn.textContent = "✓ Downloaded";
                hint.textContent = "Browser saved it to your Downloads folder.";
              } else {
                btn.disabled = false;
                btn.textContent = "Save to disk";
                hint.textContent = "Save cancelled — click again to retry.";
              }
            } catch (e) {
              btn.disabled = false;
              btn.textContent = "Save to disk";
              addWarning((e as Error).message);
            }
          };
          // Wire up preview interactions (text expansion, etc.)
          wirePreview(row.action, file, meta);
        }
        activeRecvRow = null;
        maybeShowResetBar();
      });

      transfer.emitter.on("error", (e) => addWarning(e.message));
    };

    // ---------- Pending queue (sender, pre-connection) ----------
    type PendingItem = { id: string; file: File; thumbUrl?: string };
    const pendingQueue: PendingItem[] = [];
    const PQ_AUTO_KEY = "p2pds:autoSend";

    // Restore "auto-send" preference
    try {
      pqAuto.checked = localStorage.getItem(PQ_AUTO_KEY) === "1";
    } catch {
      // localStorage may be blocked (private mode) — non-fatal
    }
    pqAuto.addEventListener("change", () => {
      try { localStorage.setItem(PQ_AUTO_KEY, pqAuto.checked ? "1" : "0"); } catch {}
    });

    const isChannelLive = (): boolean =>
      !!(transfer && lastSessionState === "connected");

    const revokeThumbs = (items: PendingItem[]) => {
      for (const it of items) {
        if (it.thumbUrl) URL.revokeObjectURL(it.thumbUrl);
      }
    };

    const escHtml = (s: string) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    const fileIconSvg = (file: File): string => {
      const t = file.type;
      const color = "text-[var(--color-fg-muted)]";
      if (t.startsWith("video/")) {
        return `<svg class="${color}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="m22 8-6 4 6 4z"/></svg>`;
      }
      if (t.startsWith("audio/")) {
        return `<svg class="${color}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`;
      }
      if (t === "application/pdf") {
        return `<svg class="${color}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>`;
      }
      return `<svg class="${color}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>`;
    };

    const renderPendingQueue = () => {
      pendingQueueList.innerHTML = "";
      if (pendingQueue.length === 0) {
        pendingQueueSection.classList.add("hidden");
        pqReady.classList.add("hidden");
        return;
      }
      pendingQueueSection.classList.remove("hidden");
      const totalBytes = pendingQueue.reduce((a, it) => a + it.file.size, 0);
      pqCount.textContent = `· ${pendingQueue.length} file${pendingQueue.length === 1 ? "" : "s"} · ${formatBytes(totalBytes)}`;
      pqReadyCount.textContent = `${pendingQueue.length} file${pendingQueue.length === 1 ? "" : "s"} · ${formatBytes(totalBytes)}`;

      for (const it of pendingQueue) {
        const li = document.createElement("li");
        li.draggable = true;
        li.dataset.id = it.id;
        li.className = "group flex items-center gap-3 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-2.5 cursor-grab active:cursor-grabbing hover:border-[var(--color-border-strong)] transition-colors";

        const grip = document.createElement("span");
        grip.className = "shrink-0 text-[var(--color-fg-subtle)] group-hover:text-[var(--color-fg-muted)] transition-colors select-none";
        grip.title = "Drag to reorder";
        grip.setAttribute("aria-label", "Drag handle");
        grip.innerHTML = `<svg width="14" height="20" viewBox="0 0 14 20" fill="currentColor" aria-hidden="true"><circle cx="4" cy="4" r="1.4"/><circle cx="10" cy="4" r="1.4"/><circle cx="4" cy="10" r="1.4"/><circle cx="10" cy="10" r="1.4"/><circle cx="4" cy="16" r="1.4"/><circle cx="10" cy="16" r="1.4"/></svg>`;
        li.appendChild(grip);

        const thumb = document.createElement("div");
        thumb.className = "shrink-0 size-10 rounded-md bg-[var(--color-bg)] border border-[var(--color-border)] overflow-hidden flex items-center justify-center";
        if (it.thumbUrl) {
          const img = document.createElement("img");
          img.src = it.thumbUrl;
          img.alt = "";
          img.className = "w-full h-full object-cover";
          thumb.appendChild(img);
        } else {
          thumb.innerHTML = fileIconSvg(it.file);
        }
        li.appendChild(thumb);

        const meta = document.createElement("div");
        meta.className = "min-w-0 flex-1";
        meta.innerHTML = `
          <p class="text-sm font-medium truncate">${escHtml(it.file.name)}</p>
          <p class="text-xs text-[var(--color-fg-muted)]">${formatBytes(it.file.size)}</p>
        `;
        li.appendChild(meta);

        const remove = document.createElement("button");
        remove.type = "button";
        remove.setAttribute("aria-label", "Remove from queue");
        remove.className = "shrink-0 size-7 rounded-md text-[var(--color-fg-subtle)] hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)] flex items-center justify-center";
        remove.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>`;
        remove.onclick = (e) => {
          e.stopPropagation();
          const idx = pendingQueue.findIndex((x) => x.id === it.id);
          if (idx >= 0) {
            const [gone] = pendingQueue.splice(idx, 1);
            if (gone.thumbUrl) URL.revokeObjectURL(gone.thumbUrl);
            renderPendingQueue();
          }
        };
        li.appendChild(remove);

        // Drag & drop reorder
        li.addEventListener("dragstart", (e) => {
          li.classList.add("opacity-50");
          e.dataTransfer?.setData("text/plain", it.id);
          if (e.dataTransfer) e.dataTransfer.effectAllowed = "move";
        });
        li.addEventListener("dragend", () => li.classList.remove("opacity-50"));
        li.addEventListener("dragover", (e) => {
          e.preventDefault();
          if (e.dataTransfer) e.dataTransfer.dropEffect = "move";
        });
        li.addEventListener("drop", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const draggedId = e.dataTransfer?.getData("text/plain");
          if (!draggedId || draggedId === it.id) return;
          const from = pendingQueue.findIndex((x) => x.id === draggedId);
          const to = pendingQueue.findIndex((x) => x.id === it.id);
          if (from < 0 || to < 0) return;
          const [moved] = pendingQueue.splice(from, 1);
          pendingQueue.splice(to, 0, moved);
          renderPendingQueue();
        });

        pendingQueueList.appendChild(li);
      }

      // Show "Send all" CTA only when channel is live
      if (isChannelLive()) {
        pqReady.classList.remove("hidden");
        pqHint.textContent = "Drag to reorder. Tap Send all to start.";
      } else {
        pqReady.classList.add("hidden");
        pqHint.textContent = "Drag to reorder. Files will be sent in this order once the receiver joins.";
      }
    };

    const generateThumb = async (file: File): Promise<string | undefined> => {
      if (file.size > 100 * 1024 * 1024) return undefined;
      if (file.type.startsWith("image/")) {
        try { return URL.createObjectURL(file); } catch { return undefined; }
      }
      if (file.type.startsWith("video/")) {
        return await extractVideoFrame(file).catch(() => undefined);
      }
      return undefined;
    };

    /**
     * Extract first usable frame from a video file -> data URL.
     * Uses a hidden <video> + canvas; seeks ~0.1s to skip black frames.
     */
    const extractVideoFrame = (file: File): Promise<string | undefined> => {
      return new Promise((resolve) => {
        const url = URL.createObjectURL(file);
        const video = document.createElement("video");
        video.preload = "metadata";
        video.muted = true;
        video.playsInline = true;
        video.src = url;
        let settled = false;
        const cleanup = () => { URL.revokeObjectURL(url); };
        const fail = () => { if (settled) return; settled = true; cleanup(); resolve(undefined); };
        const grab = () => {
          if (settled) return;
          try {
            const w = Math.min(160, video.videoWidth || 160);
            const ratio = (video.videoHeight || 90) / (video.videoWidth || 160);
            const h = Math.round(w * ratio);
            const canvas = document.createElement("canvas");
            canvas.width = w; canvas.height = h;
            const ctx = canvas.getContext("2d");
            if (!ctx) return fail();
            ctx.drawImage(video, 0, 0, w, h);
            const dataUrl = canvas.toDataURL("image/jpeg", 0.7);
            settled = true; cleanup(); resolve(dataUrl);
          } catch { fail(); }
        };
        video.addEventListener("loadeddata", () => {
          try { video.currentTime = Math.min(0.1, (video.duration || 1) / 2); } catch { grab(); }
        });
        video.addEventListener("seeked", grab);
        video.addEventListener("error", fail);
        setTimeout(fail, 4000);
      });
    };

    const enqueuePending = async (files: FileList) => {
      const items: PendingItem[] = [];
      for (const f of Array.from(files)) {
        const id = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
        const thumbUrl = await generateThumb(f);
        items.push({ id, file: f, thumbUrl });
      }
      pendingQueue.push(...items);
      renderPendingQueue();
    };

    const flushPendingQueue = () => {
      if (pendingQueue.length === 0 || !transfer) return;
      const files = pendingQueue.map((it) => it.file);
      // Build a synthetic FileList via DataTransfer (only reliable cross-browser way)
      const dt = new DataTransfer();
      for (const f of files) dt.items.add(f);
      // Revoke thumb URLs now — rows are about to switch to the live sending UI
      revokeThumbs(pendingQueue);
      pendingQueue.length = 0;
      renderPendingQueue();
      transfer.sendMultiple(dt.files).catch((e) => addWarning(e.message));
    };

    pqClear.onclick = () => {
      revokeThumbs(pendingQueue);
      pendingQueue.length = 0;
      renderPendingQueue();
    };

    pqSend.onclick = () => {
      pqReady.classList.add("hidden");
      flushPendingQueue();
    };

    // ---------- File picker / DnD ----------
    const onPickFiles = (files: FileList | null) => {
      if (!files || files.length === 0) return;
      // New activity → hide the "All done" bar until next idle moment
      resetBar.classList.add("hidden");
      // If channel is live AND user hasn't queued anything yet → send immediately (legacy behavior)
      if (isChannelLive() && pendingQueue.length === 0) {
        transfer!.sendMultiple(files).catch((e) => addWarning(e.message));
        return;
      }
      // Otherwise enqueue (covers: pre-connection AND mid-session "queue more")
      enqueuePending(files).then(() => {
        // If channel is already live and auto-send preference is on, flush immediately
        if (isChannelLive() && pqAuto.checked) {
          flushPendingQueue();
        } else if (isChannelLive()) {
          // Channel live but user has stuff queued → show Send all CTA
          pqReady.classList.remove("hidden");
        }
      });
    };
    fileInput.addEventListener("change", () => {
      onPickFiles(fileInput.files);
      fileInput.value = "";
    });

    // ---------- Folder support ----------
    // Walks a FileSystemDirectoryEntry recursively, returns flat list of
    // [File, relativePath] tuples. Used by drag-drop of folders.
    type FsEntry = FileSystemEntry & {
      isFile: boolean;
      isDirectory: boolean;
      createReader?: () => { readEntries: (cb: (entries: FsEntry[]) => void, err?: (e: Error) => void) => void };
      file?: (cb: (f: File) => void, err?: (e: Error) => void) => void;
    };

    const walkEntry = async (entry: FsEntry, pathPrefix: string): Promise<{ file: File; path: string }[]> => {
      if (entry.isFile && entry.file) {
        return new Promise((resolve, reject) => {
          entry.file!((f) => resolve([{ file: f, path: `${pathPrefix}${f.name}` }]), reject);
        });
      }
      if (entry.isDirectory && entry.createReader) {
        const reader = entry.createReader();
        // readEntries returns up to 100 entries per call — must loop until empty
        const allEntries: FsEntry[] = [];
        await new Promise<void>((resolve, reject) => {
          const readBatch = () => {
            reader.readEntries((batch) => {
              if (batch.length === 0) resolve();
              else { allEntries.push(...batch); readBatch(); }
            }, reject);
          };
          readBatch();
        });
        const newPrefix = `${pathPrefix}${entry.name}/`;
        const nested = await Promise.all(allEntries.map((e) => walkEntry(e, newPrefix)));
        return nested.flat();
      }
      return [];
    };

    // Live zipping-progress UI: replaces the previous toast hint with a
    // visible bar so multi-hundred-file folder drops don't feel hung.
    const zipProgressContainer = document.createElement("div");
    zipProgressContainer.id = "zip-progress-rows";
    zipProgressContainer.className = "space-y-2";
    // Mounted next to fileList so it appears with other transfer activity
    fileList.parentElement?.insertBefore(zipProgressContainer, fileList);

    const makeZipRow = (label: string, totalBytes: number) => {
      const row = document.createElement("div");
      row.className = "rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-3";
      row.innerHTML = `
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 min-w-0">
            <svg class="text-[var(--color-fg-muted)] shrink-0 animate-pulse" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
            <span class="text-sm font-medium truncate" data-field="label"></span>
          </div>
          <span class="text-xs text-[var(--color-fg-muted)] tabular-nums" data-field="pct">0%</span>
        </div>
        <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-[var(--color-bg-muted)]">
          <div class="h-full w-0 bg-[var(--color-accent)] transition-[width] duration-150" data-field="bar"></div>
        </div>
        <p class="mt-2 text-xs text-[var(--color-fg-subtle)] tabular-nums" data-field="bytes">Zipping… preparing</p>
      `;
      (row.querySelector('[data-field="label"]') as HTMLElement).textContent = label;
      zipProgressContainer.appendChild(row);
      const bar = row.querySelector('[data-field="bar"]') as HTMLElement;
      const pct = row.querySelector('[data-field="pct"]') as HTMLElement;
      const bytes = row.querySelector('[data-field="bytes"]') as HTMLElement;
      return {
        el: row,
        update(soFar: number) {
          // We don't know total zip size upfront, so show "X / ~Y" using uncompressed total as approx
          const ratio = totalBytes > 0 ? Math.min(0.99, soFar / totalBytes) : 0;
          const p = (ratio * 100).toFixed(1);
          pct.textContent = `${p}%`;
          bar.style.width = `${p}%`;
          bytes.textContent = `Zipping… ${formatBytes(soFar)} of ~${formatBytes(totalBytes)}`;
        },
        done() {
          row.remove();
        },
      };
    };

    const zipFilesAndQueue = async (
      files: { file: File; path: string }[],
      zipName: string,
    ) => {
      if (files.length === 0) return;
      const totalUncompressed = files.reduce((acc, { file }) => acc + file.size, 0);
      const progressRow = makeZipRow(
        `${zipName} · ${files.length} file${files.length === 1 ? "" : "s"}`,
        totalUncompressed,
      );
      try {
        // client-zip returns a Response with a streamed ReadableStream of
        // the zip bytes. We need the full Blob (protocol needs meta.size
        // up front) but we can tee progress along the way.
        const zipResponse = downloadZip(
          files.map(({ file, path }) => ({ name: path, lastModified: new Date(file.lastModified), input: file })),
        );
        const reader = zipResponse.body!.getReader();
        const chunks: Uint8Array[] = [];
        let bytesSoFar = 0;
        let lastEmit = 0;
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          chunks.push(value);
          bytesSoFar += value.byteLength;
          const now = performance.now();
          if (now - lastEmit > 100) {
            progressRow.update(bytesSoFar);
            lastEmit = now;
          }
        }
        progressRow.update(bytesSoFar);
        const blob = new Blob(chunks as BlobPart[], { type: "application/zip" });
        const zipFile = new File([blob], zipName, { type: "application/zip", lastModified: Date.now() });
        progressRow.done();
        const dt = new DataTransfer();
        dt.items.add(zipFile);
        onPickFiles(dt.files);
      } catch (e) {
        progressRow.done();
        addWarning(`Failed to zip folder: ${(e as Error).message}`);
      }
    };

    folderInput.addEventListener("change", async () => {
      const files = folderInput.files;
      if (!files || files.length === 0) return;
      // webkitRelativePath gives us "FolderName/sub/file.ext"
      const arr = Array.from(files).map((f) => ({
        file: f,
        path: (f as File & { webkitRelativePath?: string }).webkitRelativePath || f.name,
      }));
      const rootName = arr[0]?.path.split("/")[0] || "folder";
      folderInput.value = "";
      await zipFilesAndQueue(arr, `${rootName}.zip`);
    });

    pickFolderBtn.addEventListener("click", () => folderInput.click());

    document.addEventListener("dragover", (e) => e.preventDefault());
    document.addEventListener("drop", async (e) => {
      e.preventDefault();
      if (role !== "sender") return; // ignore drops on receiver side
      const items = e.dataTransfer?.items;
      // Detect folder drops via DataTransferItem.webkitGetAsEntry
      if (items && items.length > 0) {
        const entries: FsEntry[] = [];
        for (const item of Array.from(items)) {
          const entry = (item as DataTransferItem & {
            webkitGetAsEntry?: () => FsEntry | null;
          }).webkitGetAsEntry?.();
          if (entry) entries.push(entry);
        }
        const hasFolder = entries.some((en) => en.isDirectory);
        if (hasFolder) {
          // Mixed or folder-only drop: walk everything, zip per top-level folder,
          // queue stand-alone files separately.
          const standalone: File[] = [];
          for (const entry of entries) {
            if (entry.isFile && entry.file) {
              const f: File = await new Promise((res, rej) => entry.file!(res, rej));
              standalone.push(f);
            } else if (entry.isDirectory) {
              const walked = await walkEntry(entry, "");
              // Re-prefix so the zip root matches the folder name
              const withRoot = walked.map(({ file, path }) => ({ file, path: `${entry.name}/${path}` }));
              await zipFilesAndQueue(withRoot, `${entry.name}.zip`);
            }
          }
          if (standalone.length > 0) {
            const dt = new DataTransfer();
            for (const f of standalone) dt.items.add(f);
            onPickFiles(dt.files);
          }
          return;
        }
      }
      // Plain files (no folders) — original path
      onPickFiles(e.dataTransfer?.files ?? null);
    });

    // Paste images from clipboard (sender only). Ctrl+V / Cmd+V with an
    // image on the clipboard auto-queues it as pasted-image-<ts>.<ext>.
    document.addEventListener("paste", (e) => {
      if (role !== "sender") return;
      // Skip if user is pasting into a text field (chat input, paranoid blobs).
      const target = e.target as HTMLElement | null;
      const tag = target?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA" || target?.isContentEditable) return;
      const items = e.clipboardData?.items;
      if (!items) return;
      const picked: File[] = [];
      for (const item of Array.from(items)) {
        if (item.kind !== "file") continue;
        const blob = item.getAsFile();
        if (!blob) continue;
        // Rename pasted images (browsers give them generic "image.png" names)
        // so multiple pastes don't clash.
        const ext = (blob.type.split("/")[1] || "bin").replace("+xml", "");
        const stamp = new Date().toISOString().replace(/[:.]/g, "-").slice(0, 19);
        const name = blob.type.startsWith("image/")
          ? `pasted-image-${stamp}.${ext}`
          : blob.name || `pasted-${stamp}.${ext}`;
        picked.push(new File([blob], name, { type: blob.type, lastModified: Date.now() }));
      }
      if (picked.length === 0) return;
      e.preventDefault();
      const dt = new DataTransfer();
      for (const f of picked) dt.items.add(f);
      onPickFiles(dt.files);
    });

    // ---------- Boot per role ----------
    const showStatus = () => statusCard.classList.remove("hidden");

    // ---------- Chat UI ----------
    const formatTime = (ts: number): string => {
      const d = new Date(ts);
      return d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    };

    const isNearBottom = () => {
      const slack = 80; // px
      return chatScroll.scrollHeight - chatScroll.scrollTop - chatScroll.clientHeight < slack;
    };

    const appendBubble = (msg: ChatMessage, mine: boolean) => {
      chatEmpty.classList.add("hidden");

      const stickToBottom = isNearBottom();
      const showTimestamp = msg.ts - lastMessageTs > 5 * 60 * 1000;
      lastMessageTs = msg.ts;

      const wrap = document.createElement("div");
      wrap.className = `flex flex-col ${mine ? "items-end" : "items-start"}`;

      const bubble = document.createElement("div");
      bubble.className = mine
        ? "max-w-[75%] rounded-2xl rounded-br-md bg-[var(--color-accent)] text-white px-3 py-2 text-sm break-words whitespace-pre-wrap"
        : "max-w-[75%] rounded-2xl rounded-bl-md bg-[var(--color-bg-muted)] text-[var(--color-fg)] px-3 py-2 text-sm break-words whitespace-pre-wrap";
      bubble.textContent = msg.text; // textContent — never innerHTML (XSS-safe)
      wrap.appendChild(bubble);

      if (showTimestamp) {
        const time = document.createElement("span");
        time.className = "mt-1 text-[10px] text-[var(--color-fg-subtle)] tabular-nums";
        time.textContent = formatTime(msg.ts);
        wrap.appendChild(time);
      }

      chatScroll.appendChild(wrap);
      if (stickToBottom) chatScroll.scrollTop = chatScroll.scrollHeight;
    };

    const wireChat = (c: ChatManager) => {
      c.emitter.on("message", (msg) => appendBubble(msg, false));
      c.emitter.on("peerTyping", (isTyping) => {
        typingIndicator.classList.toggle("hidden", !isTyping);
        if (isTyping && isNearBottom()) chatScroll.scrollTop = chatScroll.scrollHeight;
      });
      c.emitter.on("peerDisconnected", () => {
        typingIndicator.classList.add("hidden");
        const notice = document.createElement("div");
        notice.className = "text-center text-xs text-[var(--color-fg-subtle)] py-2";
        notice.textContent = "Peer left the chat";
        chatScroll.appendChild(notice);
        chatScroll.scrollTop = chatScroll.scrollHeight;
      });
      c.emitter.on("error", (e) => addWarning(e.message));
    };

    // Auto-grow textarea + send-button enable/disable + typing notification.
    // Resets to the 40px base height when empty so the input never collapses
    // to 0 (which happens if scrollHeight is read while the panel is hidden).
    const autoGrow = () => {
      if (chatInput.value.length === 0) {
        chatInput.style.height = "40px";
        return;
      }
      chatInput.style.height = "auto";
      const next = Math.max(40, Math.min(chatInput.scrollHeight, 128));
      chatInput.style.height = `${next}px`;
    };
    chatInput.addEventListener("input", () => {
      autoGrow();
      chatSend.disabled = chatInput.value.trim().length === 0;
      if (chat && chatInput.value.length > 0) chat.setTyping(true);
      else chat?.setTyping(false);
    });
    chatInput.addEventListener("keydown", (e) => {
      // Enter sends, Shift+Enter inserts newline.
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        chatForm.requestSubmit();
      }
    });
    chatForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const text = chatInput.value.trim();
      if (!text || !chat) return;
      try {
        const msg = chat.send(text);
        appendBubble(msg, true);
        chatInput.value = "";
        chatSend.disabled = true;
        autoGrow();
      } catch (err) {
        addWarning((err as Error).message);
      }
    });

    const resetChatUI = () => {
      chatPanel.classList.add("hidden");
      chatScroll.innerHTML = "";
      chatScroll.appendChild(chatEmpty);
      chatEmpty.classList.remove("hidden");
      typingIndicator.classList.add("hidden");
      chatInput.value = "";
      chatInput.disabled = false;
      chatInput.placeholder = "Type a message…";
      chatSend.disabled = true;
      lastMessageTs = 0;
      autoGrow();
    };

    let qrCurrentUrl = "";
    const renderQrCode = async (url: string) => {
      qrCurrentUrl = url;
      // Auto-expand the QR by default for invite links — most people scan
      // rather than copy/paste, and the extra click was friction.
      qrCanvasBox.innerHTML = "";
      try {
        const canvas = document.createElement("canvas");
        await QRCode.toCanvas(canvas, url, {
          width: 220,
          margin: 1,
          errorCorrectionLevel: "M",
          color: { dark: "#000000", light: "#ffffff" },
        });
        qrCanvasBox.appendChild(canvas);
        qrWrap.classList.remove("hidden");
        qrToggleLabel.textContent = "Hide QR code";
      } catch (e) {
        // Quietly fall back to the toggle UX if QR gen fails.
        qrWrap.classList.add("hidden");
        qrToggleLabel.textContent = "Show QR code";
        addWarning(`Failed to generate QR: ${(e as Error).message}`);
      }
    };

    qrToggle.addEventListener("click", async () => {
      if (!qrWrap.classList.contains("hidden")) {
        qrWrap.classList.add("hidden");
        qrToggleLabel.textContent = "Show QR code";
        return;
      }
      if (!qrCurrentUrl) return;
      try {
        // Re-render in case canvas was cleared.
        if (!qrCanvasBox.firstChild) {
          const canvas = document.createElement("canvas");
          await QRCode.toCanvas(canvas, qrCurrentUrl, {
            width: 220,
            margin: 1,
            errorCorrectionLevel: "M",
            color: { dark: "#000000", light: "#ffffff" },
          });
          qrCanvasBox.appendChild(canvas);
        }
        qrWrap.classList.remove("hidden");
        qrToggleLabel.textContent = "Hide QR code";
      } catch (e) {
        addWarning(`Failed to generate QR: ${(e as Error).message}`);
      }
    });

    const bootAutoSender = async () => {
      session = new TeleportSession({ signalingUrl: site.signalingUrl });
      wireSession(session);
      setStatus("signaling", "Share the link below — the connection opens automatically as soon as the receiver loads it.");
      const room = generateRoomId();
      const url = `${location.origin}${import.meta.env.BASE_URL}transfer?r=${room}`;
      shareLink.value = url;
      senderLink.classList.remove("hidden");
      renderQrCode(url);
      await session.hostAuto(room);
    };

    const bootAutoReceiver = async (room: string) => {
      session = new TeleportSession({ signalingUrl: site.signalingUrl });
      wireSession(session);
      setStatus("signaling", "Connecting to sender…");
      await session.joinAuto(room);
    };

    /**
     * Race ALL paired devices in parallel — for each pair, spin up a session
     * on the derived room (host or join depending on pair.iAmHost). The first
     * one to reach "connected" wins; the rest get destroyed.
     */
    let probeSessions: { session: TeleportSession; pair: Pair }[] = [];
    const bootDevicesAuto = async () => {
      if (!getAutoAccept()) {
        // User has explicitly disabled silent auto-connect — show the picker
        // instead so they can choose send/receive manually.
        rolePicker.classList.remove("hidden");
        return;
      }
      const pairs = listPairs();
      if (pairs.length === 0) {
        rolePicker.classList.remove("hidden");
        return;
      }
      // Show the status card with a "waiting" message + a "Pick role manually"
      // escape hatch so the user isn't stuck if no paired device comes online.
      statusCard.classList.remove("hidden");
      const names = pairs.map((p) => p.nickname).join(", ");
      setStatus("signaling", `Waiting for your devices to come online: ${names}`);

      // Show "or pick role manually" affordance after a few seconds.
      const manualEscape = setTimeout(() => {
        addWarning("No paired device online yet. You can also pick a role manually below.");
        rolePicker.classList.remove("hidden");
      }, 6000);

      // v1: probe pairs SEQUENTIALLY rather than in parallel. Each pair gets
      // ~12s to connect; on miss we destroy and move to the next. Sequential
      // probing keeps session/role correctly pinned to whichever pair wins
      // (parallel racing made wireSession's listeners attach to a session
      // that might lose, breaking previews + UI on the winner). Once one
      // connects, we stay on it forever — manual disconnect is the escape.
      let didConnect = false;
      for (const pair of pairs) {
        if (didConnect) break;
        try {
          const room = await deriveRoomId(pair.secret);
          const s = new TeleportSession({ signalingUrl: site.signalingUrl });
          probeSessions = [{ session: s, pair }];
          session = s;
          role = pair.iAmHost ? "sender" : "receiver";
          // wireSession MUST run before host/join — otherwise the "state"
          // event for "connected" fires before transferPanel/dropZone/preview
          // handlers are subscribed and the UI never reveals.
          wireSession(s);

          s.emitter.on("state", (state) => {
            if (state === "connected" && !didConnect) {
              didConnect = true;
              clearTimeout(manualEscape);
              rolePicker.classList.add("hidden");
              activePair = pair;
              const badge = document.getElementById("chat-trusted-badge");
              if (badge) badge.classList.remove("hidden");
              addWarning(`✓ Auto-connected to ${pair.nickname}`);
              renderDevices();
              const disc = document.getElementById("manual-disconnect");
              if (disc) disc.classList.remove("hidden");
            }
          });

          if (pair.iAmHost) {
            await s.hostAuto(room);
          } else {
            await s.joinAuto(room);
          }

          // Wait up to 12s for THIS pair to connect; if it doesn't, move on.
          await new Promise<void>((resolve) => {
            const t = setTimeout(resolve, 12_000);
            const off = s.emitter.on("state", (st) => {
              if (st === "connected" || st === "failed") {
                clearTimeout(t);
                off();
                resolve();
              }
            });
          });

          if (!didConnect) {
            try { s.destroy(); } catch {}
            session = null;
            role = null;
          }
        } catch (e) {
          addWarning(`Pair "${pair.nickname}" probe failed: ${(e as Error).message}`);
        }
      }

      if (!didConnect) {
        // Last fallback: surface the picker so the user isn't stuck.
        rolePicker.classList.remove("hidden");
      }
    };

    const resetParanoidUI = () => {
      psSender.classList.add("hidden");
      psRecv.classList.add("hidden");
      senderOfferBlob.value = "";
      senderAnswerBlob.value = "";
      recvOfferBlob.value = "";
      recvAnswerBlob.value = "";
      lockStep(psenderStep1, false);
      lockStep(psenderStep2, true);
      lockStep(precvStep1, false);
      lockStep(precvStep2, true);
      senderCopyOffer.disabled = true;
      senderShareOffer.disabled = true;
      senderMarkShared.disabled = true;
      senderSubmitAnswer.disabled = false;
      senderSubmitAnswer.textContent = "Connect";
      recvGenerateAnswer.disabled = false;
      recvGenerateAnswer.textContent = "Generate reply code";
    };

    const bootParanoidSender = async () => {
      session = new TeleportSession({ signalingUrl: site.signalingUrl });
      wireSession(session);
      paranoidPanel.classList.remove("hidden");
      resetParanoidUI();
      psSender.classList.remove("hidden");
      setStatus("signaling", "Generating your invite code…");

      const offer = await session.hostManual();
      senderOfferBlob.value = offer;
      senderCopyOffer.disabled = false;
      senderShareOffer.disabled = false;
      senderMarkShared.disabled = false;
      setStatus("signaling", "Step 1 — share the invite code with the receiver.");

      senderMarkShared.onclick = () => {
        lockStep(psenderStep1, true);
        lockStep(psenderStep2, false);
        setStatus("signaling", "Step 2 — paste the receiver's reply code below.");
        senderAnswerBlob.focus();
      };
      senderSubmitAnswer.onclick = async () => {
        const blob = senderAnswerBlob.value.trim();
        const kind = peekBlobType(blob);
        if (kind !== "answer") {
          addWarning(
            kind === "offer"
              ? "That looks like another invite code, not a reply code. The receiver needs to paste your invite first, then send you back the *reply* they generate."
              : kind === "empty"
              ? "Paste the receiver's reply code first."
              : "That doesn't look like a valid reply code. Ask the receiver to copy it again.",
          );
          return;
        }
        senderSubmitAnswer.disabled = true;
        senderSubmitAnswer.textContent = "Connecting…";
        try {
          await session!.acceptManualAnswer(blob);
        } catch (e) {
          addWarning((e as Error).message);
          senderSubmitAnswer.disabled = false;
          senderSubmitAnswer.textContent = "Connect";
        }
      };
    };

    const bootParanoidReceiver = async () => {
      session = new TeleportSession({ signalingUrl: site.signalingUrl });
      wireSession(session);
      paranoidPanel.classList.remove("hidden");
      resetParanoidUI();
      psRecv.classList.remove("hidden");
      setStatus("signaling", "Step 1 — paste the sender's invite code below.");

      recvGenerateAnswer.onclick = async () => {
        const blob = recvOfferBlob.value.trim();
        const kind = peekBlobType(blob);
        if (kind !== "offer") {
          addWarning(
            kind === "answer"
              ? "That looks like a reply code, not an invite. Reply codes go on the sender's side."
              : kind === "empty"
              ? "Paste the invite code from the sender first."
              : "That doesn't look like a valid invite code. Ask the sender to copy it again.",
          );
          return;
        }
        recvGenerateAnswer.disabled = true;
        recvGenerateAnswer.textContent = "Generating…";
        try {
          const answer = await session!.joinManual(blob);
          recvAnswerBlob.value = answer;
          lockStep(precvStep1, true);
          lockStep(precvStep2, false);
          setStatus("signaling", "Step 2 — copy the reply code and send it back to the sender.");
        } catch (e) {
          addWarning((e as Error).message);
          recvGenerateAnswer.disabled = false;
          recvGenerateAnswer.textContent = "Generate reply code";
        }
      };
    };

    const bootRole = () => {
      session?.destroy();
      session = null;
      transfer = null;
      chat = null;
      lastSessionState = "idle";
      sendingRows.length = 0;
      receivingRows.length = 0;
      activeSendRow = null;
      activeRecvRow = null;
      completedSendCount = 0;
      completedSendBytes = 0;
      completedRecvCount = 0;
      completedRecvBytes = 0;
      receivedItems.length = 0;
      saveAllBar.classList.add("hidden");
      resetBar.classList.add("hidden");
      peerHiddenBanner.classList.add("hidden");
      fileList.innerHTML = "";
      warnings.innerHTML = "";
      transferPanel.classList.add("hidden");
      senderLink.classList.add("hidden");
      retryPanel.classList.add("hidden");
      paranoidPanel.classList.add("hidden");
      // Reset pending queue UI (but only if switching role — preserve on paranoid toggle re-boot)
      // Easiest: just clear it. Re-picking files takes one tap.
      revokeThumbs(pendingQueue);
      pendingQueue.length = 0;
      renderPendingQueue();
      resetChatUI();
      showStatus();
      // Reset peer identity — new connection means new (possibly same) peer
      peerName = "";
      refreshIdentityLabels();

      // Sender: show drop zone + transfer panel IMMEDIATELY so files can be queued
      // before the receiver joins. Receiver doesn't get drop zone.
      if (role === "sender") {
        transferPanel.classList.remove("hidden");
        dropZone.classList.remove("hidden");
        receiverWait.classList.add("hidden");
      }

      const paranoid = paranoidToggle.checked;
      if (role === "sender") {
        if (paranoid) bootParanoidSender();
        else bootAutoSender();
      } else {
        if (paranoid) bootParanoidReceiver();
        else {
          const room = new URL(location.href).searchParams.get("r") || location.hash.replace(/^#/, "");
          if (!room) {
            addWarning("Receiver needs an invite link from the sender. Ask them to copy and send you their link.");
            return;
          }
          bootAutoReceiver(room);
        }
      }
    };

    // ---------- Role picker ----------
    const params = new URL(location.href);
    // Pair fragment takes priority over the legacy hash-as-room-id fallback.
    const incomingPair = parsePairFragment(location.hash);
    // Only treat the hash as a bare room ID when it looks like one (12 hex chars).
    const bareHashRoom = /^[0-9a-f]{12}$/i.test(location.hash.replace(/^#/, ""))
      ? location.hash.replace(/^#/, "")
      : "";
    const presetRoom = params.searchParams.get("r") || bareHashRoom;
    const sharedFlag = params.searchParams.get("shared") === "1";

    // ---------- My Devices wiring ----------
    const devicesAddBtn = $<HTMLButtonElement>("devices-add");
    const devicesAddPanel = $("devices-add-panel");
    const devicesAddDone = $<HTMLButtonElement>("devices-add-done");
    const devicesPairUrl = $<HTMLInputElement>("devices-pair-url");
    const devicesPairCopy = $<HTMLButtonElement>("devices-pair-copy");
    const devicesPairQr = $("devices-pair-qr");
    const devicesList = $<HTMLUListElement>("devices-list");
    const devicesCount = $("devices-count");
    const devicesAutoAccept = $<HTMLInputElement>("devices-auto-accept");
    const pairIncoming = $("pair-incoming");
    const pairIncomingName = $<HTMLInputElement>("pair-incoming-name");
    const pairIncomingDetail = $("pair-incoming-detail");
    const pairIncomingAccept = $<HTMLButtonElement>("pair-incoming-accept");
    const pairIncomingCancel = $<HTMLButtonElement>("pair-incoming-cancel");

    const renderDevices = () => {
      const pairs = listPairs();
      devicesCount.textContent = pairs.length ? `· ${pairs.length}` : "";
      devicesList.innerHTML = "";
      if (pairs.length === 0) {
        const empty = document.createElement("li");
        empty.className = "text-xs text-[var(--color-fg-subtle)] italic";
        empty.textContent = "No devices paired yet.";
        devicesList.appendChild(empty);
        return;
      }
      for (const p of pairs) {
        const li = document.createElement("li");
        li.className = "flex items-center gap-3 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-3";
        const dot = document.createElement("span");
        const isActive = activePair?.secret === p.secret;
        dot.className = `size-2 rounded-full shrink-0 ${isActive ? "bg-[var(--color-success)]" : "bg-[var(--color-fg-subtle)]"}`;
        dot.title = isActive ? "Connected" : "Offline";
        dot.dataset.field = "presence";
        li.appendChild(dot);
        const label = document.createElement("span");
        label.className = "flex-1 text-sm font-medium truncate";
        label.textContent = p.nickname + (isActive ? " · connected" : "");
        li.appendChild(label);
        const meta = document.createElement("span");
        meta.className = "text-xs text-[var(--color-fg-subtle)]";
        meta.textContent = `Added ${new Date(p.addedAt).toLocaleDateString()}`;
        li.appendChild(meta);
        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className = "text-xs text-[var(--color-fg-subtle)] hover:text-[var(--color-danger)] px-2 py-1";
        removeBtn.textContent = "Remove";
        removeBtn.onclick = () => {
          if (confirm(`Remove "${p.nickname}" from paired devices?`)) {
            removePair(p.secret);
            renderDevices();
          }
        };
        li.appendChild(removeBtn);
        devicesList.appendChild(li);
      }
    };

    devicesAutoAccept.checked = getAutoAccept();
    devicesAutoAccept.onchange = () => setAutoAccept(devicesAutoAccept.checked);

    let pendingPairSecret = "";
    devicesAddBtn.onclick = async () => {
      pendingPairSecret = generatePairSecret();
      const myName = (localStorage.getItem("p2pds:name") || "").trim();
      const url = buildPairUrl(location.origin, import.meta.env.BASE_URL, pendingPairSecret, myName);
      devicesPairUrl.value = url;
      devicesAddPanel.classList.remove("hidden");
      devicesPairQr.innerHTML = "";
      try {
        const canvas = document.createElement("canvas");
        await QRCode.toCanvas(canvas, url, {
          width: 220, margin: 1, errorCorrectionLevel: "M",
          color: { dark: "#000000", light: "#ffffff" },
        });
        devicesPairQr.appendChild(canvas);
      } catch (e) {
        addWarning(`QR generation failed: ${(e as Error).message}`);
      }
    };

    devicesPairCopy.onclick = async () => {
      try {
        await navigator.clipboard.writeText(devicesPairUrl.value);
        const orig = devicesPairCopy.textContent;
        devicesPairCopy.textContent = "Copied ✓";
        setTimeout(() => { devicesPairCopy.textContent = orig; }, 1500);
      } catch {
        devicesPairUrl.select();
        document.execCommand("copy");
      }
    };

    devicesAddDone.onclick = () => {
      // Save the secret locally even if the other side hasn't opened the URL yet.
      // The pair is one-sided until the other device opens it — but storing here
      // means auto-host will start looking for it immediately.
      if (pendingPairSecret) {
        const myName = (localStorage.getItem("p2pds:name") || "").trim();
        upsertPair(pendingPairSecret, myName ? `${myName}'s other device` : "Other device", true);
      }
      pendingPairSecret = "";
      devicesAddPanel.classList.add("hidden");
      renderDevices();
    };

    // ---------- Incoming pair (URL fragment) ----------
    if (incomingPair) {
      // Strip the fragment IMMEDIATELY so a refresh doesn't re-pair and the
      // secret doesn't linger in window.location during the session.
      history.replaceState({}, "", `${location.pathname}${location.search}`);
      pairIncoming.classList.remove("hidden");
      if (incomingPair.nickname) {
        pairIncomingDetail.textContent = `"${incomingPair.nickname}" wants to pair with this device for auto-connect.`;
      }
      pairIncomingName.value = "";
      pairIncomingAccept.onclick = () => {
        const label = pairIncomingName.value.trim() || incomingPair.nickname || "Other device";
        upsertPair(incomingPair.secret, label, false);
        pairIncoming.classList.add("hidden");
        renderDevices();
      };
      pairIncomingCancel.onclick = () => {
        pairIncoming.classList.add("hidden");
      };
    }

    renderDevices();


    // Web Share Target: files were POSTed via SW, retrieve them from cache
    if (sharedFlag) {
      // Strip the query string so a reload doesn't re-trigger
      history.replaceState({}, "", `${location.pathname}`);
      (async () => {
        try {
          const res = await fetch("/__shared__");
          if (!res.ok) return;
          const form = await res.formData();
          const files = form.getAll("files").filter((f): f is File => f instanceof File);
          if (files.length === 0) return;
          // Auto-pick sender role and queue the shared files
          role = "sender";
          rolePicker.classList.add("hidden");
          bootRole();
          // bootRole runs async (bootAutoSender) — wait a tick then enqueue
          setTimeout(() => {
            const dt = new DataTransfer();
            for (const f of files) dt.items.add(f);
            onPickFiles(dt.files);
          }, 50);
        } catch (e) {
          addWarning(`Could not load shared files: ${(e as Error).message}`);
        }
      })();
    } else if (presetRoom) {
      // Auto-detect: someone gave us an invite link → we're the receiver.
      role = "receiver";
      bootRole();
    } else if (listPairs().length > 0 && !incomingPair) {
      // Paired-device auto-connect: race all known pairs in parallel and
      // hand control to the first one whose peer comes online.
      bootDevicesAuto();
    } else {
      rolePicker.classList.remove("hidden");
    }

    roleSendBtn.onclick = () => {
      role = "sender";
      rolePicker.classList.add("hidden");
      bootRole();
    };
    roleRecvBtn.onclick = () => {
      // Mark role immediately so paranoid toggle works while the user
      // is still on the "paste invite link" sub-step.
      role = "receiver";
      statusRole.textContent = "Receiver";
      refreshIdentityLabels();
      // If paranoid is already on, jump straight into the paranoid flow.
      if (paranoidToggle.checked) {
        rolePicker.classList.add("hidden");
        bootRole();
        return;
      }
      // Reveal the "paste link" input. We don't actually boot until the
      // user clicks Join (or switches to paranoid mode).
      roleReceiveInput.classList.remove("hidden");
      roleReceiveLink.focus();
    };

    /** Extract a room ID from a pasted invite link OR a bare ID. */
    const extractRoomId = (input: string): string | null => {
      const v = input.trim();
      if (!v) return null;
      // Try parsing as URL first.
      try {
        const u = new URL(v);
        const fromQuery = u.searchParams.get("r");
        if (fromQuery) return fromQuery;
        const fromHash = u.hash.replace(/^#/, "");
        if (fromHash) return fromHash;
      } catch {
        /* not a URL — fall through to bare-ID handling */
      }
      // Accept a bare room ID (12 hex chars per generateRoomId).
      if (/^[\w-]{4,128}$/.test(v)) return v;
      return null;
    };

    const updateJoinBtn = () => {
      roleReceiveGo.disabled = extractRoomId(roleReceiveLink.value) === null;
    };
    roleReceiveLink.addEventListener("input", updateJoinBtn);
    roleReceiveLink.addEventListener("paste", () => setTimeout(updateJoinBtn, 0));
    roleReceiveLink.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        roleReceiveGo.click();
      }
    });

    roleReceiveGo.onclick = () => {
      const room = extractRoomId(roleReceiveLink.value);
      if (!room) {
        addWarning("Couldn't read a room ID from that. Paste the full link or just the room ID after ?r=");
        return;
      }
      role = "receiver";
      rolePicker.classList.add("hidden");
      // Inject as URL param so re-bootRole picks it up cleanly.
      const u = new URL(location.href);
      u.searchParams.set("r", room);
      history.replaceState(null, "", u.toString());
      bootRole();
    };

    roleReceiveParanoid.onclick = () => {
      role = "receiver";
      paranoidToggle.checked = true;
      rolePicker.classList.add("hidden");
      bootRole();
    };

    // Retry handlers (sender side, after a connection failure)
    retryBtn.onclick = () => {
      // Same role, same mode — just rebuild from scratch with a fresh room.
      retryPanel.classList.add("hidden");
      autoReconnectAttempted = false;
      bootRole();
    };
    retryParanoidBtn.onclick = () => {
      retryPanel.classList.add("hidden");
      paranoidToggle.checked = true;
      bootRole();
    };

    paranoidToggle.addEventListener("change", () => {
      if (role) {
        rolePicker.classList.add("hidden");
        bootRole();
      }
    });

    // ---------- Misc ----------
    const canShare = typeof navigator !== "undefined" && typeof navigator.share === "function";
    async function tryShare(btn: HTMLButtonElement, data: ShareData, fallbackText: string, restoreLabel: string) {
      try {
        await navigator.share(data);
        btn.textContent = "Shared!";
      } catch (err: any) {
        if (err && err.name === "AbortError") return; // user cancelled
        // fallback to clipboard
        try { await navigator.clipboard.writeText(fallbackText); btn.textContent = "Copied!"; } catch { return; }
      }
      setTimeout(() => (btn.textContent = restoreLabel), 1500);
    }
    if (canShare) {
      shareLinkBtn.classList.remove("hidden");
      senderShareOffer.classList.remove("hidden");
      recvShareAnswer.classList.remove("hidden");
    }
    shareLinkBtn.addEventListener("click", () =>
      tryShare(shareLinkBtn, { title: "Teleport invite", text: "Join my secure file transfer:", url: shareLink.value }, shareLink.value, "Share")
    );
    senderShareOffer.addEventListener("click", () =>
      tryShare(senderShareOffer, { title: "Teleport invite code", text: senderOfferBlob.value }, senderOfferBlob.value, "Share")
    );
    recvShareAnswer.addEventListener("click", () =>
      tryShare(recvShareAnswer, { title: "Teleport reply code", text: recvAnswerBlob.value }, recvAnswerBlob.value, "Share")
    );
    copyLinkBtn.addEventListener("click", async () => {
      await navigator.clipboard.writeText(shareLink.value);
      copyLinkBtn.textContent = "Copied!";
      setTimeout(() => (copyLinkBtn.textContent = "Copy"), 1500);
    });
    senderCopyOffer.addEventListener("click", async () => {
      await navigator.clipboard.writeText(senderOfferBlob.value);
      senderCopyOffer.textContent = "Copied!";
      setTimeout(() => (senderCopyOffer.textContent = "Copy invite code"), 1500);
    });
    recvCopyAnswer.addEventListener("click", async () => {
      await navigator.clipboard.writeText(recvAnswerBlob.value);
      recvCopyAnswer.textContent = "Copied!";
      setTimeout(() => (recvCopyAnswer.textContent = "Copy reply code"), 1500);
    });

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") {
        // Page came back from background — wake the signaling socket
        // if it got killed by iOS/Android while we were away.
        session?.resumeIfStale();
      } else if (activeSendRow) {
        addWarning("Tab moved to background — transfer may slow until you return.");
      }
    });

    // ---------- Keyboard shortcut help overlay ----------
    const kbdOverlay = document.getElementById("kbd-overlay") as HTMLDivElement;
    const kbdOverlayClose = document.getElementById("kbd-overlay-close") as HTMLButtonElement;
    const helpToggleBtn = document.getElementById("help-toggle") as HTMLButtonElement | null;
    const showKbdHelp = () => kbdOverlay.classList.remove("hidden");
    const hideKbdHelp = () => kbdOverlay.classList.add("hidden");
    kbdOverlayClose.addEventListener("click", hideKbdHelp);
    helpToggleBtn?.addEventListener("click", () => {
      if (kbdOverlay.classList.contains("hidden")) showKbdHelp();
      else hideKbdHelp();
    });
    kbdOverlay.addEventListener("click", (e) => {
      if (e.target === kbdOverlay) hideKbdHelp();
    });
    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement | null;
      const tag = t?.tagName;
      const inField = tag === "INPUT" || tag === "TEXTAREA" || t?.isContentEditable;
      if (e.key === "Escape" && !kbdOverlay.classList.contains("hidden")) {
        hideKbdHelp();
        e.preventDefault();
        return;
      }
      if (inField) return;
      if (e.key === "?") {
        e.preventDefault();
        if (kbdOverlay.classList.contains("hidden")) showKbdHelp();
        else hideKbdHelp();
      }
    });

    // ---------- Manual disconnect ----------
    const discBtn = document.getElementById("manual-disconnect") as HTMLButtonElement | null;
    discBtn?.addEventListener("click", () => {
      if (!confirm("Disconnect from this peer? You'll need to reconnect manually (or auto-reconnect if paired).")) return;
      try { session?.destroy(); } catch {}
      session = null;
      role = null;
      activePair = null;
      // Hide UI bits that don't make sense post-disconnect.
      discBtn.classList.add("hidden");
      const badge = document.getElementById("chat-trusted-badge");
      if (badge) badge.classList.add("hidden");
      // Stop the uptime ticker + reset chat input state.
      setStatus("disconnected", "You disconnected manually. Refresh the page to reconnect.");
      chatInput.disabled = true;
      chatInput.placeholder = "Disconnected — refresh to reconnect";
      chatSend.disabled = true;
      renderDevices();
      addWarning("Disconnected. Refresh the page (or close the tab) to reset.");
    });

    // ---------- Theme toggle ----------
    const themeBtn = document.getElementById("theme-toggle") as HTMLButtonElement | null;
    const themeIconSun = document.getElementById("theme-icon-sun");
    const themeIconMoon = document.getElementById("theme-icon-moon");
    const syncThemeIcons = () => {
      const t = (window as any).__getTheme?.() || "dark";
      // In dark mode show the SUN (click to go light); in light show MOON.
      themeIconSun?.classList.toggle("hidden", t !== "dark");
      themeIconMoon?.classList.toggle("hidden", t !== "light");
    };
    syncThemeIcons();
    themeBtn?.addEventListener("click", () => {
      const cur = (window as any).__getTheme?.() || "dark";
      (window as any).__setTheme?.(cur === "dark" ? "light" : "dark");
    });
    window.addEventListener("themechange", syncThemeIcons);
  </script>
</Layout>
