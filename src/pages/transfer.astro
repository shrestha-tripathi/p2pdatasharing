---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { site } from "../site.config";
---

<Layout
  title="Someone wants to send you files"
  description="Open this link to receive files directly from the sender — no uploads, no signup, end-to-end encrypted."
  noindex
>
  <Nav />

  <main class="mx-auto max-w-[1000px] px-4 md:px-8 py-10 md:py-16">
    <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <p class="text-sm uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">Workspace</p>
        <h1 class="mt-2 text-3xl md:text-4xl font-semibold tracking-tight">Transfer files now</h1>
      </div>
      <div class="flex items-center gap-5 flex-wrap">
        <label class="inline-flex items-center gap-2 text-sm">
          <span class="text-[var(--color-fg-muted)]">I'm</span>
          <input
            id="my-name"
            type="text"
            maxlength="40"
            placeholder="Your nickname"
            class="h-8 w-32 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-2 text-sm focus:outline-none focus:border-[var(--color-accent)]"
          />
        </label>
        <button id="sound-toggle" type="button" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] transition-colors" aria-label="Toggle sounds" title="Toggle sounds & vibration">
          <svg id="sound-icon-on" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M11 5 6 9H2v6h4l5 4zM15.5 8.5a5 5 0 0 1 0 7M19 5a9 9 0 0 1 0 14"/></svg>
          <svg id="sound-icon-off" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M11 5 6 9H2v6h4l5 4zM22 9l-6 6M16 9l6 6"/></svg>
        </button>
        <button id="help-toggle" type="button" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] transition-colors" aria-label="Keyboard shortcuts" title="Keyboard shortcuts (?)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><circle cx="12" cy="17" r="0.5" fill="currentColor"/></svg>
        </button>
        <!--
          Document Picture-in-Picture toggle. Hidden by default; init script
          unhides on browsers where `documentPictureInPicture` exists
          (Chromium 116+ on desktop only). Hand-inlined Lucide
          `picture-in-picture-2` icon — zero dep, themes via currentColor.
          The "exit" variant is hidden until PiP is open; init script
          swaps the .hidden class on the two SVGs in concert.
        -->
        <button id="pip-toggle" type="button" class="hidden text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] transition-colors" aria-label="Pop out into floating window" title="Pop out into floating window">
          <svg id="pip-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7"/><path d="M10 19H4a2 2 0 0 1-2-2v-2"/><rect x="2" y="13" width="10" height="8" rx="2"/></svg>
          <svg id="pip-icon-close" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7"/><path d="M10 19H4a2 2 0 0 1-2-2v-2"/><rect x="2" y="13" width="10" height="8" rx="2"/><path d="m5 16 4 4M9 16l-4 4"/></svg>
        </button>
        <label class="inline-flex items-center gap-3 text-sm cursor-pointer select-none group" title="Skip our signaling server — copy/paste the handshake yourself">
          <span class="text-[var(--color-fg-muted)] group-hover:text-[var(--color-fg)] transition-colors">Paranoid mode</span>
          <span class="relative inline-block">
            <input id="paranoid-toggle" type="checkbox" class="peer sr-only" />
            <span class="block w-11 h-6 rounded-full bg-[var(--color-bg-muted)] border border-[var(--color-border-strong)] transition-colors peer-checked:bg-[var(--color-accent)] peer-checked:border-[var(--color-accent)]"></span>
            <span class="absolute top-[3px] left-[3px] size-4 rounded-full bg-[var(--color-bg)] border border-[var(--color-border-strong)] transition-transform shadow-sm peer-checked:translate-x-5 peer-checked:border-[var(--color-accent)]"></span>
          </span>
        </label>
      </div>
    </header>

    <!-- My Devices panel — standalone (NOT inside role-picker) so it stays
         visible during active connections, showing live presence dots. -->
    <details id="devices-panel" class="rounded-lg border border-[var(--color-border)] mb-4 group">
      <summary class="cursor-pointer p-4 flex items-center justify-between gap-3 flex-wrap hover:bg-[var(--color-bg-subtle)] transition-colors select-none">
        <div class="flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="4" width="14" height="12" rx="1"/><path d="M17 9h3v8a1 1 0 0 1-1 1h-2"/><path d="M8 20h8"/></svg>
          <h3 class="font-semibold text-sm">My Devices <span id="devices-count" class="text-[var(--color-fg-muted)] font-normal"></span></h3>
        </div>
        <svg class="text-[var(--color-fg-subtle)] transition-transform group-open:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </summary>
      <div class="p-4 pt-0 border-t border-[var(--color-border)]">
        <div class="flex justify-end mt-4">
          <button id="devices-add" class="h-9 rounded-md border border-[var(--color-border)] px-3 text-sm hover:bg-[var(--color-bg-muted)] inline-flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Add device
          </button>
        </div>
        <p class="mt-2 text-xs text-[var(--color-fg-muted)]">
          Link your phone and laptop once. After that, they auto-connect whenever both open this page — no link sharing needed.
        </p>

        <!-- This device — shown so user always knows / can edit how
             they appear in their other paired devices' rosters. -->
        <div class="mt-4 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-3 flex items-center gap-3">
          <span class="size-2 rounded-full bg-[var(--color-fg-muted)] shrink-0"></span>
          <div class="flex-1 min-w-0">
            <div class="text-[10px] uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">This device</div>
            <div class="font-medium text-sm truncate" id="this-device-name">My device</div>
          </div>
          <button id="this-device-rename" class="h-8 rounded-md border border-[var(--color-border)] px-3 text-xs hover:bg-[var(--color-bg-muted)] shrink-0">Rename</button>
        </div>

        <!-- Add-device flow: shows QR + URL for pairing -->
        <div id="devices-add-panel" class="hidden mt-4 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4">
          <label class="block text-xs text-[var(--color-fg-muted)]">
            Name this device (so you can recognize it later)
            <input id="devices-add-name" type="text" maxlength="40" placeholder="e.g. My Laptop, Work Mac, Tablet"
              class="mt-1 w-full h-10 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-3 text-sm focus:outline-none focus:border-[var(--color-accent)]" />
          </label>
          <p class="mt-4 text-sm">Then open this on that device to pair:</p>
          <div class="mt-3 flex gap-2">
            <input id="devices-pair-url" type="text" readonly
              class="flex-1 h-10 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-3 font-mono text-xs focus:outline-none" />
            <button id="devices-pair-copy" class="h-10 rounded-md border border-[var(--color-border)] px-3 text-sm hover:bg-[var(--color-bg-muted)] shrink-0">Copy</button>
          </div>
          <div id="devices-pair-qr" class="mt-4 flex justify-center"></div>
          <p class="mt-3 text-xs text-[var(--color-fg-subtle)]">
            🔒 The secret is in the URL fragment — it never reaches our server.
          </p>
          <div class="mt-4 flex justify-end">
            <button id="devices-add-done" class="h-9 rounded-md border border-[var(--color-border)] px-3 text-sm hover:bg-[var(--color-bg-muted)]">Done</button>
          </div>
        </div>

        <ul id="devices-list" class="mt-4 space-y-2"></ul>

        <label class="mt-4 flex items-center gap-2 text-xs text-[var(--color-fg-muted)] cursor-pointer">
          <input id="devices-auto-accept" type="checkbox" class="size-4" />
          Auto-accept transfers from my devices (recommended)
        </label>
      </div>
    </details>

    <!-- ROLE PICKER (shown when no role chosen yet) -->
    <section id="role-picker" class="hidden">

      <!-- Incoming pair request — shown when URL contains #pair=... -->
      <div id="pair-incoming" class="hidden rounded-lg border border-[var(--color-accent)] bg-[var(--color-bg-subtle)] p-5 mb-4">
        <h3 class="font-semibold flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="2" y="7" width="20" height="10" rx="2"/><path d="M6 12h.01M10 12h.01M14 12h.01M18 12h.01"/></svg>
          Pair this device
        </h3>
        <p id="pair-incoming-detail" class="mt-2 text-sm text-[var(--color-fg-muted)]">
          Another device wants to pair with this one for direct auto-connect.
        </p>
        <label class="block mt-3 text-xs text-[var(--color-fg-muted)]">
          Label this device (e.g. "Laptop", "iPhone")
          <input id="pair-incoming-name" type="text" maxlength="40" placeholder="My Laptop"
            class="mt-1 w-full h-10 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-3 text-sm focus:outline-none focus:border-[var(--color-accent)]" />
        </label>
        <div class="mt-4 flex flex-wrap gap-2">
          <button id="pair-incoming-accept" class="h-10 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Pair devices</button>
          <button id="pair-incoming-cancel" class="h-10 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)]">Cancel</button>
        </div>
      </div>

      <!-- My Devices panel was here originally — moved out of role-picker
           so the panel + presence dots stay visible after a connection
           forms (role-picker hides on connect). -->

      <!-- Connect-mode toggle — only shown when user has paired devices.
           Lets them pick between fast-path paired connect and the
           generic link-sharing flow for sending to someone new. -->
      <div id="role-paired-banner" class="hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4 mb-4">
        <div class="flex gap-1 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] p-1 text-sm">
          <button id="connect-mode-paired" type="button"
            class="flex-1 rounded px-3 py-1.5 text-[var(--color-fg-muted)] hover:text-[var(--color-fg)]">
            My paired device
          </button>
          <button id="connect-mode-stranger" type="button"
            class="flex-1 rounded px-3 py-1.5 font-medium bg-[var(--color-bg-muted)] text-[var(--color-fg)]">
            Someone else (link)
          </button>
        </div>
        <p id="connect-mode-help" class="mt-3 text-xs text-[var(--color-fg-muted)]">
          Pick <strong>Send</strong> on one device and <strong>Receive</strong> on the other — they'll auto-connect. No link needed.
        </p>
        <!-- Hidden placeholder retained for backwards-compat with JS that
             writes to #role-paired-banner-name. Not displayed. -->
        <span id="role-paired-banner-name" class="hidden"></span>
      </div>

      <div class="rounded-lg border border-[var(--color-border)] p-6 mb-6">
        <h2 class="text-xl font-semibold mb-1">What do you want to do?</h2>
        <p class="text-sm text-[var(--color-fg-muted)] mb-5">
          Pick a role. You can switch later by refreshing this page.
        </p>
        <div class="grid sm:grid-cols-2 gap-3">
          <button id="role-send" class="text-left rounded-lg border border-[var(--color-border)] p-5 transition-colors hover:border-[var(--color-accent)] hover:bg-[var(--color-bg-muted)]">
            <div class="flex items-center gap-3">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              <span class="font-semibold">Send files</span>
            </div>
            <p class="mt-2 text-sm text-[var(--color-fg-muted)]">I have files to share. Give me a link to send to my peer.</p>
          </button>
          <button id="role-receive" class="text-left rounded-lg border border-[var(--color-border)] p-5 transition-colors hover:border-[var(--color-accent)] hover:bg-[var(--color-bg-muted)]">
            <div class="flex items-center gap-3">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
              <span class="font-semibold">Receive files</span>
            </div>
            <p class="mt-2 text-sm text-[var(--color-fg-muted)]">Someone is sending me files. I'll connect manually (paranoid mode).</p>
          </button>
        </div>
      </div>
      <!-- Auto-mode role picker: receiver also needs a way to paste an invite link -->
      <div id="role-receive-input" class="hidden mt-4 rounded-lg border border-[var(--color-border)] p-5">
        <h3 class="font-semibold mb-1">Enter the sender's 4-character code</h3>
        <p class="text-sm text-[var(--color-fg-muted)] mb-3">
          Ask the sender to read out the 4-character code from their screen — or paste their invite link below.
        </p>

        <!--
          Short-code claim block — PRIMARY input. 4 boxes, autoadvance,
          paste-aware. Sender displays a 4-char Crockford Base32 code
          beside their QR; receiver types it here, we POST /code/claim
          → roomId → join the same room as if they'd pasted the link.
          See docs/specs/local-network-code-pairing.md.
        -->
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <div id="claim-code-boxes" class="flex gap-2">
              <input class="claim-code-box w-12 h-14 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] text-center font-mono text-2xl font-semibold uppercase tracking-tight focus:outline-none focus:border-[var(--color-accent)]" maxlength="1" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" aria-label="Pairing code character 1" />
              <input class="claim-code-box w-12 h-14 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] text-center font-mono text-2xl font-semibold uppercase tracking-tight focus:outline-none focus:border-[var(--color-accent)]" maxlength="1" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" aria-label="Pairing code character 2" />
              <input class="claim-code-box w-12 h-14 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] text-center font-mono text-2xl font-semibold uppercase tracking-tight focus:outline-none focus:border-[var(--color-accent)]" maxlength="1" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" aria-label="Pairing code character 3" />
              <input class="claim-code-box w-12 h-14 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] text-center font-mono text-2xl font-semibold uppercase tracking-tight focus:outline-none focus:border-[var(--color-accent)]" maxlength="1" inputmode="text" autocapitalize="characters" autocomplete="off" spellcheck="false" aria-label="Pairing code character 4" />
            </div>
            <button
              id="claim-code-submit"
              type="button"
              class="h-10 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90 disabled:opacity-40"
              disabled
            >Connect</button>
            <span id="claim-code-status" class="text-xs text-[var(--color-fg-subtle)]"></span>
          </div>
        </div>

        <!--
          Invite-link / room-ID paste — SECONDARY input. Below the code
          boxes because the most common flow is in-person/voice-call
          ("type the 4 chars I see"). Link paste is the right move when
          the sender already messaged you a URL — those users land here
          with the URL on clipboard and naturally click the field.
        -->
        <div class="mt-5 pt-5 border-t border-[var(--color-border)]">
          <p class="text-sm text-[var(--color-fg-muted)] mb-3">
            Or paste the invite link the sender shared (e.g.
            <code class="font-mono text-xs">https://…/transfer?r=abc123</code>) —
            or just the room ID, or scan their QR.
          </p>
          <div class="flex gap-2">
            <input
              id="role-receive-link"
              type="text"
              placeholder="https://… or just the room ID"
              class="flex-1 min-w-0 h-10 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-3 font-mono text-sm focus:outline-none focus:border-[var(--color-accent)]"
            />
            <button
              id="role-receive-scan"
              type="button"
              class="h-10 px-3 rounded-md border border-[var(--color-border)] text-sm font-medium hover:bg-[var(--color-bg-muted)] inline-flex items-center gap-1.5 shrink-0"
              title="Scan the sender's QR code with your camera"
              aria-label="Scan QR code"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M3 7V5a2 2 0 0 1 2-2h2"/>
                <path d="M17 3h2a2 2 0 0 1 2 2v2"/>
                <path d="M21 17v2a2 2 0 0 1-2 2h-2"/>
                <path d="M7 21H5a2 2 0 0 1-2-2v-2"/>
                <rect x="7" y="7" width="10" height="10" rx="1"/>
              </svg>
              <span class="hidden sm:inline">Scan QR</span>
            </button>
            <button id="role-receive-go" class="h-10 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90 disabled:opacity-40 shrink-0" disabled>Join</button>
          </div>
        </div>

        <p class="mt-3 text-xs text-[var(--color-fg-subtle)]">
          No code or link yet? Ask the sender to start their session, or use
          <button id="role-receive-paranoid" class="underline hover:text-[var(--color-fg)]">paranoid mode</button>
          to exchange a manual handshake instead.
        </p>
      </div>

      <!--
        QR scanner modal — opens when the Scan button above is tapped.
        Uses native BarcodeDetector with a jsQR fallback. Pulled into its
        own dialog so the camera preview can fill a sensible area on phones
        without disrupting the rest of the role picker.
      -->
      <div
        id="qr-scan-modal"
        class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/70 backdrop-blur-sm px-4"
        role="dialog"
        aria-modal="true"
        aria-labelledby="qr-scan-title"
      >
        <div class="w-full max-w-md max-h-[90vh] overflow-y-auto rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] shadow-2xl overflow-hidden">
          <div class="flex items-center justify-between px-5 py-3 border-b border-[var(--color-border)]">
            <h3 id="qr-scan-title" class="font-semibold">Scan invite QR code</h3>
            <button
              id="qr-scan-close"
              type="button"
              class="size-8 inline-flex items-center justify-center rounded-md text-[var(--color-fg-muted)] hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)]"
              aria-label="Close scanner"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="relative bg-black aspect-square">
            <!-- Live camera preview -->
            <video id="qr-scan-video" class="w-full h-full object-cover" playsinline muted></video>
            <!-- Centered framing reticle so users know where to point -->
            <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
              <div class="size-2/3 max-w-[260px] max-h-[260px] border-2 border-white/80 rounded-lg shadow-[0_0_0_9999px_rgba(0,0,0,0.35)]"></div>
            </div>
            <div id="qr-scan-status" class="hidden absolute inset-0 flex items-center justify-center text-center px-6 text-white text-sm bg-black/85"></div>
          </div>
          <div class="px-5 py-3 text-xs text-[var(--color-fg-muted)] border-t border-[var(--color-border)]">
            Point your camera at the sender's QR code. We'll join automatically when it's detected.
          </div>
        </div>
      </div>

    </section>
    <!-- LOBBY: sender's "pick an online device to send to" view ─────── -->
    <div id="lobby-sender" class="hidden mt-4 rounded-lg border border-[var(--color-border)] p-5">
      <div class="flex items-center justify-between mb-1">
        <h3 class="font-semibold">Online devices</h3>
        <span class="text-xs text-[var(--color-fg-muted)]">Tap to send</span>
      </div>
      <p class="text-sm text-[var(--color-fg-muted)] mb-4">
        These are your paired devices currently online and ready to receive.
      </p>
      <ul id="lobby-sender-list" class="space-y-2"></ul>
      <p id="lobby-sender-empty" class="hidden text-sm text-[var(--color-fg-muted)] italic py-4 text-center">
        No paired devices online right now. Open {site.shortName} on your other device and tap <strong>Receive files</strong>.
      </p>
      <div class="mt-4 pt-4 border-t border-[var(--color-border)] text-xs text-[var(--color-fg-subtle)]">
        Or <button id="lobby-sender-switch-link" class="underline hover:text-[var(--color-fg)]">share a one-time link</button> with someone else.
      </div>
    </div>

    <!-- LOBBY: receiver's "you're online, waiting for invite" view ─── -->
    <div id="lobby-receiver" class="hidden mt-4 rounded-lg border border-[var(--color-border)] p-5">
      <div class="flex items-start gap-3">
        <span class="size-2.5 rounded-full bg-[var(--color-online)] mt-1.5 shrink-0 presence-dot-online"></span>
        <div class="flex-1 text-sm">
          <div class="font-semibold">You're online and ready to receive</div>
          <div class="text-[var(--color-fg-muted)] mt-0.5">
            Visible to your paired devices as: <strong id="lobby-receiver-nickname" class="text-[var(--color-fg)]">My device</strong>
            <button id="lobby-receiver-rename" class="ml-2 text-xs text-[var(--color-accent)] underline hover:no-underline">Rename</button>
          </div>
        </div>
      </div>
      <div id="lobby-receiver-status" class="mt-4 text-sm text-[var(--color-fg-muted)]">
        Waiting for a sender to invite you…
      </div>
      <div class="mt-4">
        <button id="lobby-receiver-cancel" class="h-10 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)]">Cancel — go offline</button>
      </div>
    </div>

    <!-- LOBBY: incoming invite confirm dialog (only when auto-accept OFF) -->
    <div id="lobby-invite-confirm" class="hidden mt-4 rounded-lg border border-[var(--color-accent)] bg-[var(--color-bg-subtle)] p-5">
      <h3 class="font-semibold">Incoming connection</h3>
      <p class="mt-2 text-sm">
        <strong id="lobby-invite-from">A device</strong> wants to send you files.
      </p>
      <div class="mt-4 flex gap-2">
        <button id="lobby-invite-accept" class="h-10 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Accept</button>
        <button id="lobby-invite-decline" class="h-10 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)]">Decline</button>
      </div>
    </div>

    <!-- Status card (hidden until a role is picked) -->
    <div id="status-card" class="hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5 mb-6">
      <div class="flex items-center gap-3">
        <span id="status-dot" class="size-2.5 rounded-full bg-[var(--color-fg-subtle)]"></span>
        <span id="status-label" class="font-medium">Initializing…</span>
        <span id="status-uptime" class="hidden text-xs tabular-nums text-[var(--color-fg-muted)]" title="Time connected"></span>
        <span id="status-role" class="ml-auto text-xs uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]"></span>
      </div>
      <p id="status-detail" class="mt-2 text-sm text-[var(--color-fg-muted)]"></p>

      <!--
        Connection-progress bar — appears only during state==="connecting"
        (i.e. ICE handshake / TURN allocation window). Animates 0% → 100%
        over CONNECT_TIMEOUT_MS via pure CSS, no JS interval. The duration
        is driven by a CSS custom property set at boot via JS so the
        bar always tracks the actual timeout constant in teleportSession.ts.
        Hidden by default; setStatus() toggles visibility + restarts the
        animation when entering "connecting" from another state.
      -->
      <div
        id="status-progress"
        class="hidden mt-3 h-[3px] w-full overflow-hidden rounded-full bg-[var(--color-bg-muted)]"
        role="progressbar"
        aria-label="Establishing peer connection"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <div id="status-progress-fill" class="status-progress-fill h-full w-0 bg-[var(--color-accent)]"></div>
      </div>

      <!-- Manual disconnect — surfaces whenever there's an active session
           (paired auto-connect, normal sender/receiver, or paranoid). -->
      <div class="mt-3">
        <button id="manual-disconnect" type="button"
          class="hidden inline-flex items-center gap-2 h-8 rounded-md border border-[var(--color-border)] px-3 text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-danger)] hover:border-[var(--color-danger)] transition-colors">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.36 6.64a9 9 0 1 1-12.73 0M12 2v10"/></svg>
          Disconnect
        </button>
      </div>

      <details class="mt-4 text-xs">
        <summary class="cursor-pointer text-[var(--color-fg-subtle)] hover:text-[var(--color-fg)] select-none">
          Show technical details
        </summary>
        <div id="diag-grid" class="mt-3 grid grid-cols-2 sm:grid-cols-3 gap-2 font-mono">
          <!-- populated by JS -->
        </div>
        <p class="mt-3 text-[10px] text-[var(--color-fg-subtle)] italic">
          Updates live. Useful for debugging connection issues — paste a screenshot if you report a bug.
        </p>
      </details>
    </div>

    <!-- AUTO MODE: Sender share link -->
    <section id="sender-link" class="hidden rounded-lg border border-[var(--color-border)] p-5 mb-6">
      <p class="text-sm text-[var(--color-fg-muted)]">Send this link to the receiver:</p>
      <div class="mt-3 flex gap-2">
        <input id="share-link" type="text" readonly class="flex-1 h-10 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-3 font-mono text-sm" />
        <button id="share-link-btn" class="hidden h-10 rounded-md border border-[var(--color-border)] px-4 text-sm font-medium hover:bg-[var(--color-bg-muted)]">Share</button>
        <button id="copy-link" class="h-10 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-90">Copy</button>
      </div>
      <div class="mt-4 flex items-center gap-4 flex-wrap">
        <button id="qr-toggle" type="button" class="text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] inline-flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM20 14h1M14 20h1M20 20h1"/></svg>
          <span id="qr-toggle-label">Show QR code</span>
        </button>
        <span class="text-xs text-[var(--color-fg-subtle)]">Tap to scan from another device 📱</span>
      </div>
      <div id="qr-wrap" class="hidden mt-4 flex flex-col items-center gap-2">
        <div id="qr-canvas-box" class="rounded-lg bg-white p-3 border border-[var(--color-border)]"></div>
        <p class="text-xs text-[var(--color-fg-subtle)]">Scan with your phone camera</p>
      </div>

      <!--
        Short-code pairing block — sits below the QR. Receiver types the
        4-char code on their device → CodeDO returns the same roomId →
        handshake proceeds over the existing room. See
        docs/specs/local-network-code-pairing.md.

        Mint-always policy: code appears on role-boot, in parallel with QR.
        Countdown ticks down; at 0s we auto-mint a fresh code. On peer
        connect the block fades and the countdown stops.
      -->
      <div id="pair-code-wrap" class="hidden mt-5 pt-5 border-t border-[var(--color-border)] flex flex-wrap items-center gap-x-5 gap-y-3">
        <div class="flex items-center gap-3">
          <span class="text-xs uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">Or pair with code</span>
          <code
            id="pair-code"
            class="font-mono text-2xl font-semibold tracking-[0.35em] text-[var(--color-fg)] select-all"
            aria-label="4-character pairing code"
          >····</code>
        </div>
        <span id="pair-code-status" class="text-xs text-[var(--color-fg-subtle)]">expires in 1:00</span>
        <button
          id="pair-code-copy"
          type="button"
          class="text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] underline disabled:opacity-40 disabled:no-underline"
          disabled
        >Copy code</button>
      </div>

      <p class="mt-3 text-xs text-[var(--color-fg-subtle)]">
        Keep this tab open. Once the receiver loads the link, you can drop files.
      </p>
    </section>

    <!-- AUTO MODE: Retry button (shown only when connection actually failed) -->
    <section id="retry-panel" class="hidden rounded-lg border border-[var(--color-danger)] p-5 mb-6">
      <h3 class="font-semibold">Connection failed</h3>
      <p class="mt-2 text-sm text-[var(--color-fg-muted)]">
        Couldn't reach the peer over WebRTC. This usually happens on strict mobile networks
        (carrier NAT) or corporate firewalls. Try a different network, or switch to paranoid mode.
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <button id="retry-btn" class="h-10 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Try again</button>
        <button id="retry-paranoid" class="h-10 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)]">Switch to paranoid mode</button>
      </div>
    </section>

    <!-- PARANOID MODE: role-aware stepper -->
    <section id="paranoid-panel" class="hidden mb-6">
      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5 mb-4">
        <p class="text-sm text-[var(--color-fg-muted)]">
          <span class="font-medium text-[var(--color-fg)]">Paranoid mode active.</span>
          The signaling server is bypassed — you'll exchange a one-time handshake string with your peer over a channel you trust. The file transfer itself is fully end-to-end encrypted and direct.
        </p>
      </div>

      <!-- SENDER FLOW -->
      <div id="paranoid-sender" class="hidden space-y-4">
        <div id="psender-step1" class="rounded-lg border-2 border-[var(--color-accent)] p-5 transition-opacity">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex size-7 items-center justify-center rounded-full bg-[var(--color-accent)] text-white text-sm font-semibold">1</span>
            <h3 class="font-semibold">Send your invite code to the receiver</h3>
          </div>
          <p class="text-sm text-[var(--color-fg-muted)] mb-3">
            Copy the code below and send it to your peer — over Signal, email, WhatsApp, or any channel you trust.
          </p>
          <textarea id="sender-offer-blob" readonly class="w-full h-28 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] p-3 font-mono text-xs" placeholder="Generating invite code…"></textarea>
          <div class="mt-3 flex gap-2">
            <button id="sender-share-offer" class="hidden h-9 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)] disabled:opacity-50" disabled>Share</button>
            <button id="sender-copy-offer" class="h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90 disabled:opacity-50" disabled>Copy invite code</button>
            <button id="sender-mark-shared" class="h-9 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)] disabled:opacity-50" disabled>I've shared it →</button>
          </div>
        </div>

        <div id="psender-step2" class="rounded-lg border border-[var(--color-border)] p-5 opacity-40 pointer-events-none transition-opacity">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex size-7 items-center justify-center rounded-full bg-[var(--color-bg-muted)] border border-[var(--color-border-strong)] text-sm font-semibold">2</span>
            <h3 class="font-semibold">Paste the receiver's reply code</h3>
          </div>
          <p class="text-sm text-[var(--color-fg-muted)] mb-3">
            The receiver generates a reply code after opening your invite. Paste it here to finish the handshake.
          </p>
          <textarea id="sender-answer-blob" class="w-full h-28 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] p-3 font-mono text-xs" placeholder="Paste the reply code from the receiver here…"></textarea>
          <button id="sender-submit-answer" class="mt-3 h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Connect</button>
        </div>
      </div>

      <!-- RECEIVER FLOW -->
      <div id="paranoid-receiver" class="hidden space-y-4">
        <div id="precv-step1" class="rounded-lg border-2 border-[var(--color-accent)] p-5 transition-opacity">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex size-7 items-center justify-center rounded-full bg-[var(--color-accent)] text-white text-sm font-semibold">1</span>
            <h3 class="font-semibold">Paste the sender's invite code</h3>
          </div>
          <p class="text-sm text-[var(--color-fg-muted)] mb-3">
            Your peer should have sent you a long string. Paste it here.
          </p>
          <textarea id="recv-offer-blob" class="w-full h-28 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] p-3 font-mono text-xs" placeholder="Paste the invite code from the sender here…"></textarea>
          <button id="recv-generate-answer" class="mt-3 h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Generate reply code</button>
        </div>

        <div id="precv-step2" class="rounded-lg border border-[var(--color-border)] p-5 opacity-40 pointer-events-none transition-opacity">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex size-7 items-center justify-center rounded-full bg-[var(--color-bg-muted)] border border-[var(--color-border-strong)] text-sm font-semibold">2</span>
            <h3 class="font-semibold">Send the reply code back to the sender</h3>
          </div>
          <p class="text-sm text-[var(--color-fg-muted)] mb-3">
            Copy the code below and send it back to the sender. Connection opens automatically once they paste it.
          </p>
          <textarea id="recv-answer-blob" readonly class="w-full h-28 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-3 font-mono text-xs"></textarea>
          <div class="mt-3 flex gap-2">
            <button id="recv-share-answer" class="hidden h-9 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)]">Share</button>
            <button id="recv-copy-answer" class="h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Copy reply code</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Transfer workspace -->
    <section id="transfer-panel" class="hidden rounded-lg border border-[var(--color-border)] p-5">
      <!-- Sender drop zone -->
      <div id="drop-zone" class="hidden">
        <label
          for="file-input"
          id="drop-zone-label"
          class="drop-zone-label group block cursor-pointer rounded-xl border-2 border-dashed border-[var(--color-border-strong)] py-12 px-6 text-center transition-all duration-200 hover:bg-[var(--color-bg-muted)] hover:border-[var(--color-fg-muted)]"
        >
          <!--
            Big "+" icon as the empty-state focal point. Pulses on idle,
            grows + glows when a file is dragged over. Matches the
            ToffeeShare/WeTransfer "drop bull's-eye" pattern.
          -->
          <div class="drop-plus mx-auto mb-4 flex items-center justify-center size-16 rounded-full border-2 border-[var(--color-border-strong)] text-[var(--color-fg-muted)] transition-all duration-200">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M12 5v14M5 12h14"/>
            </svg>
          </div>
          <p class="text-lg font-medium">Drop files or click to pick</p>
          <p class="mt-1 text-sm text-[var(--color-fg-muted)]">Any size. Multiple files OK. Streamed directly to the receiver.</p>
          <input id="file-input" type="file" multiple class="hidden" />
          <input id="folder-input" type="file" webkitdirectory multiple class="hidden" />
        </label>
        <div class="mt-3 flex items-center justify-center gap-3 flex-wrap">
          <button id="pick-folder-btn" type="button" class="text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] inline-flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            Pick folder
          </button>
          <span class="text-[var(--color-fg-subtle)]">·</span>
          <span class="text-xs text-[var(--color-fg-subtle)]">Folder structure is preserved on receiver</span>
        </div>
        <p class="mt-3 text-xs text-[var(--color-fg-subtle)] text-center">
          You can keep dropping more files after the current one finishes. Press <kbd class="px-1 py-0.5 rounded border border-[var(--color-border)] bg-[var(--color-bg-subtle)] text-[10px] font-mono">Ctrl/⌘ + V</kbd> to paste screenshots.
        </p>
      </div>

      <!-- Pending queue (sender, before peer joins) -->
      <section id="pending-queue-section" class="hidden mt-5">
        <div class="flex items-center justify-between mb-2 gap-3 flex-wrap">
          <h3 class="text-sm font-semibold">Queued <span id="pq-count" class="text-[var(--color-fg-muted)] font-normal"></span></h3>
          <button id="pq-clear" type="button" class="text-xs text-[var(--color-fg-subtle)] hover:text-[var(--color-fg)]">Clear all</button>
        </div>
        <p id="pq-hint" class="text-xs text-[var(--color-fg-subtle)] mb-3">
          Drag to reorder. Files will be sent in this order once the receiver joins.
        </p>
        <ul id="pending-queue" class="space-y-2"></ul>
        <div id="pq-ready" class="hidden mt-4 rounded-lg border border-[var(--color-accent)] bg-[var(--color-bg-subtle)] p-4 flex items-center justify-between gap-3 flex-wrap">
          <div>
            <p class="text-sm font-medium">✓ Receiver joined</p>
            <p class="text-xs text-[var(--color-fg-muted)] mt-0.5"><span id="pq-ready-count"></span> ready to send.</p>
          </div>
          <div class="flex items-center gap-4">
            <label class="text-xs flex items-center gap-1.5 cursor-pointer select-none">
              <input id="pq-auto" type="checkbox" class="size-3.5 cursor-pointer" />
              Auto-send next time
            </label>
            <button id="pq-send" type="button" class="h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Send all</button>
          </div>
        </div>
      </section>

      <!-- Receiver waiting -->
      <div id="receiver-wait" class="hidden text-center py-10">
        <div class="inline-block size-6 rounded-full border-2 border-[var(--color-border-strong)] border-t-[var(--color-accent)] animate-spin"></div>
        <p class="mt-4 text-sm text-[var(--color-fg-muted)]">Connected. Waiting for sender to drop a file…</p>
      </div>

      <!-- Per-file rows -->
      <ul id="file-list" class="mt-4 space-y-3"></ul>

      <!-- "Save all" — appears when 2+ files received. Two buttons:
           - "Save all to folder" (Chromium-only, uses showDirectoryPicker → preserves tree)
           - "Download as .zip" (always available, single zip file via client-zip) -->
      <div id="save-all-bar" class="hidden mt-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-3 flex items-center justify-between gap-3 flex-wrap">
        <div class="flex items-center gap-2 min-w-0">
          <svg class="text-[var(--color-fg-muted)] shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          <p class="text-sm text-[var(--color-fg-muted)]">
            <span id="save-all-summary">2 files ready</span>
          </p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <button id="save-all-zip-btn" type="button" class="h-9 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-3 text-sm font-medium text-[var(--color-fg)] hover:bg-[var(--color-bg-subtle)] inline-flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Download as .zip
          </button>
          <button id="save-all-btn" type="button" class="hidden h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Save all to folder</button>
        </div>
      </div>

      <!-- Peer-tab-hidden banner: shown when peer's tab is backgrounded -->
      <div id="peer-hidden-banner" class="hidden mt-4 rounded-lg border border-amber-500/40 bg-amber-500/10 p-3 flex items-center gap-3">
        <svg class="text-amber-500 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        <p class="text-sm text-[var(--color-fg)]">
          <span id="peer-hidden-text">Peer's tab is in the background.</span>
          <span class="text-[var(--color-fg-muted)]">Mobile browsers throttle hidden tabs — ask them to keep this tab open for steady transfers.</span>
        </p>
      </div>

      <!-- "Send another / Clear" reset after transfers complete -->
      <div id="reset-bar" class="hidden mt-4 flex items-center justify-between gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-3 flex-wrap">
        <p class="text-sm text-[var(--color-fg-muted)]">
          <span id="reset-summary">All sent.</span> Drop more files or clear the list.
        </p>
        <div class="flex items-center gap-2">
          <button id="reset-clear" type="button" class="h-9 rounded-md border border-[var(--color-border)] px-3 text-sm hover:bg-[var(--color-bg-muted)]">Clear list</button>
          <button id="reset-send-more" type="button" class="h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Send more files</button>
        </div>
      </div>
    </section>

    <!-- Chat panel (only shown after connection) -->
    <section id="chat-panel" class="hidden mt-6 rounded-lg border border-[var(--color-border)] overflow-hidden flex flex-col">
      <header class="px-5 py-3 border-b border-[var(--color-border)] bg-[var(--color-bg-subtle)] flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-[var(--color-fg-muted)]">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <h2 class="text-sm font-semibold">Chat <span id="chat-peer-label" class="font-normal text-[var(--color-fg-muted)]"></span></h2>
        <span id="chat-trusted-badge" class="hidden inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full bg-[var(--color-bg-muted)] border border-[var(--color-accent)] text-[var(--color-accent)] uppercase tracking-[0.06em] font-medium">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
          Trusted
        </span>
        <span class="ml-auto text-xs text-[var(--color-fg-subtle)]">End-to-end encrypted · Not saved anywhere</span>
      </header>

      <div id="chat-scroll" class="px-5 py-4 h-72 overflow-y-auto space-y-2 bg-[var(--color-bg)]">
        <p id="chat-empty" class="text-center text-sm text-[var(--color-fg-subtle)] py-12">
          No messages yet. Say hi 👋
        </p>
      </div>

      <div id="typing-indicator" class="hidden px-5 pb-2 flex items-center gap-2 text-xs text-[var(--color-fg-muted)]">
        <span class="inline-flex gap-1">
          <span class="size-1.5 rounded-full bg-[var(--color-fg-muted)] animate-pulse" style="animation-delay: 0ms"></span>
          <span class="size-1.5 rounded-full bg-[var(--color-fg-muted)] animate-pulse" style="animation-delay: 150ms"></span>
          <span class="size-1.5 rounded-full bg-[var(--color-fg-muted)] animate-pulse" style="animation-delay: 300ms"></span>
        </span>
        Peer is typing…
      </div>

      <form id="chat-form" class="border-t border-[var(--color-border)] p-3 flex gap-2 items-end bg-[var(--color-bg-subtle)]">
        <textarea
          id="chat-input"
          rows="1"
          placeholder="Type a message…"
          maxlength="2000"
          class="flex-1 resize-none rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2 text-sm leading-[1.4] min-h-10 max-h-32 focus:outline-none focus:border-[var(--color-accent)]"
          style="height: 40px;"
        ></textarea>
        <button
          id="chat-send"
          type="submit"
          disabled
          class="h-10 px-4 rounded-md bg-[var(--color-fg)] text-sm font-medium text-[var(--color-bg)] hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed transition-opacity"
        >Send</button>
