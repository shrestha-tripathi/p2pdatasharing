        <div id="pq-ready" class="hidden mt-4 rounded-lg border border-[var(--color-accent)] bg-[var(--color-bg-subtle)] p-4 flex items-center justify-between gap-3 flex-wrap">
          <div>
            <p class="text-sm font-medium">✓ Receiver joined</p>
            <p class="text-xs text-[var(--color-fg-muted)] mt-0.5"><span id="pq-ready-count"></span> ready to send.</p>
