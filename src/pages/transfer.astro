---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { site } from "../site.config";
---

<Layout
  title="Someone wants to send you files"
  description="Open this link to receive files directly from the sender — no uploads, no signup, end-to-end encrypted."
  noindex
>
  <Nav />

  <main class="mx-auto max-w-[1000px] px-4 md:px-8 py-10 md:py-16">
    <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <p class="text-sm uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">Workspace</p>
        <h1 class="mt-2 text-3xl md:text-4xl font-semibold tracking-tight">Teleport files</h1>
      </div>
      <div class="flex items-center gap-5 flex-wrap">
        <label class="inline-flex items-center gap-2 text-sm">
          <span class="text-[var(--color-fg-muted)]">I'm</span>
          <input
            id="my-name"
            type="text"
            maxlength="40"
            placeholder="Your nickname"
            class="h-8 w-32 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-2 text-sm focus:outline-none focus:border-[var(--color-accent)]"
          />
        </label>
        <button id="sound-toggle" type="button" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] transition-colors" aria-label="Toggle sounds" title="Toggle sounds & vibration">
          <svg id="sound-icon-on" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M11 5 6 9H2v6h4l5 4zM15.5 8.5a5 5 0 0 1 0 7M19 5a9 9 0 0 1 0 14"/></svg>
          <svg id="sound-icon-off" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M11 5 6 9H2v6h4l5 4zM22 9l-6 6M16 9l6 6"/></svg>
        </button>
        <button id="theme-toggle" type="button" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] transition-colors" aria-label="Toggle theme" title="Toggle light/dark mode">
          <!-- moon (shown in light theme to suggest 'go dark') -->
          <svg id="theme-icon-moon" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <!-- sun (shown in dark theme to suggest 'go light') -->
          <svg id="theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        </button>
        <button id="help-toggle" type="button" class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] transition-colors" aria-label="Keyboard shortcuts" title="Keyboard shortcuts (?)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><circle cx="12" cy="17" r="0.5" fill="currentColor"/></svg>
        </button>
        <label class="inline-flex items-center gap-3 text-sm cursor-pointer select-none group" title="Skip our signaling server — copy/paste the handshake yourself">
          <span class="text-[var(--color-fg-muted)] group-hover:text-[var(--color-fg)] transition-colors">Paranoid mode</span>
          <span class="relative inline-block">
            <input id="paranoid-toggle" type="checkbox" class="peer sr-only" />
            <span class="block w-11 h-6 rounded-full bg-[var(--color-bg-muted)] border border-[var(--color-border-strong)] transition-colors peer-checked:bg-[var(--color-accent)] peer-checked:border-[var(--color-accent)]"></span>
            <span class="absolute top-[3px] left-[3px] size-4 rounded-full bg-[var(--color-bg)] border border-[var(--color-border-strong)] transition-transform shadow-sm peer-checked:translate-x-5 peer-checked:border-[var(--color-accent)]"></span>
          </span>
        </label>
      </div>
    </header>

    <!-- ROLE PICKER (shown when no role chosen yet) -->
    <section id="role-picker" class="hidden">

      <!-- Incoming pair request — shown when URL contains #pair=... -->
      <div id="pair-incoming" class="hidden rounded-lg border border-[var(--color-accent)] bg-[var(--color-bg-subtle)] p-5 mb-4">
        <h3 class="font-semibold flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="2" y="7" width="20" height="10" rx="2"/><path d="M6 12h.01M10 12h.01M14 12h.01M18 12h.01"/></svg>
          Pair this device
        </h3>
        <p id="pair-incoming-detail" class="mt-2 text-sm text-[var(--color-fg-muted)]">
          Another device wants to pair with this one for direct auto-connect.
        </p>
        <label class="block mt-3 text-xs text-[var(--color-fg-muted)]">
          Label this device (e.g. "Laptop", "iPhone")
          <input id="pair-incoming-name" type="text" maxlength="40" placeholder="My Laptop"
            class="mt-1 w-full h-10 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-3 text-sm focus:outline-none focus:border-[var(--color-accent)]" />
        </label>
        <div class="mt-4 flex flex-wrap gap-2">
          <button id="pair-incoming-accept" class="h-10 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Pair devices</button>
          <button id="pair-incoming-cancel" class="h-10 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)]">Cancel</button>
        </div>
      </div>

      <!-- My Devices panel -->
      <div class="rounded-lg border border-[var(--color-border)] p-5 mb-4">
        <div class="flex items-center justify-between gap-3 flex-wrap">
          <div class="flex items-center gap-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="4" width="14" height="12" rx="1"/><path d="M17 9h3v8a1 1 0 0 1-1 1h-2"/><path d="M8 20h8"/></svg>
            <h3 class="font-semibold">My Devices <span id="devices-count" class="text-[var(--color-fg-muted)] font-normal text-sm"></span></h3>
          </div>
          <button id="devices-add" class="h-9 rounded-md border border-[var(--color-border)] px-3 text-sm hover:bg-[var(--color-bg-muted)] inline-flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Add device
          </button>
        </div>
        <p class="mt-2 text-xs text-[var(--color-fg-muted)]">
          Link your phone and laptop once. After that, they auto-connect whenever both open this page — no link sharing needed.
        </p>

        <!-- Add-device flow: shows QR + URL for pairing -->
        <div id="devices-add-panel" class="hidden mt-4 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4">
          <p class="text-sm">Open this on your other device to pair:</p>
          <div class="mt-3 flex gap-2">
            <input id="devices-pair-url" type="text" readonly
              class="flex-1 h-10 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-3 font-mono text-xs focus:outline-none" />
            <button id="devices-pair-copy" class="h-10 rounded-md border border-[var(--color-border)] px-3 text-sm hover:bg-[var(--color-bg-muted)] shrink-0">Copy</button>
          </div>
          <div id="devices-pair-qr" class="mt-4 flex justify-center"></div>
          <p class="mt-3 text-xs text-[var(--color-fg-subtle)]">
            🔒 The secret is in the URL fragment — it never reaches our server.
          </p>
          <div class="mt-4 flex justify-end">
            <button id="devices-add-done" class="h-9 rounded-md border border-[var(--color-border)] px-3 text-sm hover:bg-[var(--color-bg-muted)]">Done</button>
          </div>
        </div>

        <!-- Paired-devices list -->
        <ul id="devices-list" class="mt-4 space-y-2"></ul>

        <label class="mt-4 flex items-center gap-2 text-xs text-[var(--color-fg-muted)] cursor-pointer">
          <input id="devices-auto-accept" type="checkbox" class="size-4" />
          Auto-accept transfers from my devices (recommended)
        </label>
      </div>

      <div class="rounded-lg border border-[var(--color-border)] p-6 mb-6">
        <h2 class="text-xl font-semibold mb-1">What do you want to do?</h2>
        <p class="text-sm text-[var(--color-fg-muted)] mb-5">
          Pick a role. You can switch later by refreshing this page.
        </p>
        <div class="grid sm:grid-cols-2 gap-3">
          <button id="role-send" class="text-left rounded-lg border border-[var(--color-border)] p-5 transition-colors hover:border-[var(--color-accent)] hover:bg-[var(--color-bg-muted)]">
            <div class="flex items-center gap-3">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              <span class="font-semibold">Send files</span>
            </div>
            <p class="mt-2 text-sm text-[var(--color-fg-muted)]">I have files to share. Give me a link to send to my peer.</p>
          </button>
          <button id="role-receive" class="text-left rounded-lg border border-[var(--color-border)] p-5 transition-colors hover:border-[var(--color-accent)] hover:bg-[var(--color-bg-muted)]">
            <div class="flex items-center gap-3">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
              <span class="font-semibold">Receive files</span>
            </div>
            <p class="mt-2 text-sm text-[var(--color-fg-muted)]">Someone is sending me files. I'll connect manually (paranoid mode).</p>
          </button>
        </div>
      </div>
      <!-- Auto-mode role picker: receiver also needs a way to paste an invite link -->
      <div id="role-receive-input" class="hidden mt-4 rounded-lg border border-[var(--color-border)] p-5">
        <h3 class="font-semibold mb-1">Paste your invite link</h3>
        <p class="text-sm text-[var(--color-fg-muted)] mb-3">
          The sender should have given you a link like
          <code class="font-mono text-xs">https://…/transfer?r=abc123</code>.
          You can also just paste the room ID (the part after <code class="font-mono text-xs">?r=</code>).
        </p>
        <div class="flex gap-2">
          <input
            id="role-receive-link"
            type="text"
            placeholder="https://… or just the room ID"
            class="flex-1 h-10 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-3 font-mono text-sm focus:outline-none focus:border-[var(--color-accent)]"
          />
          <button id="role-receive-go" class="h-10 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90 disabled:opacity-40" disabled>Join</button>
        </div>
        <p class="mt-3 text-xs text-[var(--color-fg-subtle)]">
          No link yet? Ask the sender to copy theirs, or use
          <button id="role-receive-paranoid" class="underline hover:text-[var(--color-fg)]">paranoid mode</button>
          to exchange a manual handshake instead.
        </p>
      </div>
    </section>
    <!-- Status card (hidden until a role is picked) -->
    <div id="status-card" class="hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5 mb-6">
      <div class="flex items-center gap-3">
        <span id="status-dot" class="size-2.5 rounded-full bg-[var(--color-fg-subtle)]"></span>
        <span id="status-label" class="font-medium">Initializing…</span>
        <span id="status-uptime" class="hidden text-xs tabular-nums text-[var(--color-fg-muted)]" title="Time connected"></span>
        <span id="status-role" class="ml-auto text-xs uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]"></span>
      </div>
      <p id="status-detail" class="mt-2 text-sm text-[var(--color-fg-muted)]"></p>

      <!-- Manual disconnect — surfaces whenever there's an active session
           (paired auto-connect, normal sender/receiver, or paranoid). -->
      <div class="mt-3">
        <button id="manual-disconnect" type="button"
          class="hidden inline-flex items-center gap-2 h-8 rounded-md border border-[var(--color-border)] px-3 text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-danger)] hover:border-[var(--color-danger)] transition-colors">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.36 6.64a9 9 0 1 1-12.73 0M12 2v10"/></svg>
          Disconnect
        </button>
      </div>

      <details class="mt-4 text-xs">
        <summary class="cursor-pointer text-[var(--color-fg-subtle)] hover:text-[var(--color-fg)] select-none">
          Show technical details
        </summary>
        <div id="diag-grid" class="mt-3 grid grid-cols-2 sm:grid-cols-3 gap-2 font-mono">
          <!-- populated by JS -->
        </div>
        <p class="mt-3 text-[10px] text-[var(--color-fg-subtle)] italic">
          Updates live. Useful for debugging connection issues — paste a screenshot if you report a bug.
        </p>
      </details>
    </div>

    <!-- AUTO MODE: Sender share link -->
    <section id="sender-link" class="hidden rounded-lg border border-[var(--color-border)] p-5 mb-6">
      <p class="text-sm text-[var(--color-fg-muted)]">Send this link to the receiver:</p>
      <div class="mt-3 flex gap-2">
        <input id="share-link" type="text" readonly class="flex-1 h-10 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-3 font-mono text-sm" />
        <button id="share-link-btn" class="hidden h-10 rounded-md border border-[var(--color-border)] px-4 text-sm font-medium hover:bg-[var(--color-bg-muted)]">Share</button>
        <button id="copy-link" class="h-10 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-90">Copy</button>
      </div>
      <div class="mt-4 flex items-center gap-4 flex-wrap">
        <button id="qr-toggle" type="button" class="text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] inline-flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM20 14h1M14 20h1M20 20h1"/></svg>
          <span id="qr-toggle-label">Show QR code</span>
        </button>
        <span class="text-xs text-[var(--color-fg-subtle)]">Tap to scan from another device 📱</span>
      </div>
      <div id="qr-wrap" class="hidden mt-4 flex flex-col items-center gap-2">
        <div id="qr-canvas-box" class="rounded-lg bg-white p-3 border border-[var(--color-border)]"></div>
        <p class="text-xs text-[var(--color-fg-subtle)]">Scan with your phone camera</p>
      </div>
      <p class="mt-3 text-xs text-[var(--color-fg-subtle)]">
        Keep this tab open. Once the receiver loads the link, you can drop files.
      </p>
    </section>

    <!-- AUTO MODE: Retry button (shown only when connection actually failed) -->
    <section id="retry-panel" class="hidden rounded-lg border border-[var(--color-danger)] p-5 mb-6">
      <h3 class="font-semibold">Connection failed</h3>
      <p class="mt-2 text-sm text-[var(--color-fg-muted)]">
        Couldn't reach the peer over WebRTC. This usually happens on strict mobile networks
        (carrier NAT) or corporate firewalls. Try a different network, or switch to paranoid mode.
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <button id="retry-btn" class="h-10 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Try again</button>
        <button id="retry-paranoid" class="h-10 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)]">Switch to paranoid mode</button>
      </div>
    </section>

    <!-- PARANOID MODE: role-aware stepper -->
    <section id="paranoid-panel" class="hidden mb-6">
      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5 mb-4">
        <p class="text-sm text-[var(--color-fg-muted)]">
          <span class="font-medium text-[var(--color-fg)]">Paranoid mode active.</span>
          The signaling server is bypassed — you'll exchange a one-time handshake string with your peer over a channel you trust. The file transfer itself is fully end-to-end encrypted and direct.
        </p>
      </div>

      <!-- SENDER FLOW -->
      <div id="paranoid-sender" class="hidden space-y-4">
        <div id="psender-step1" class="rounded-lg border-2 border-[var(--color-accent)] p-5 transition-opacity">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex size-7 items-center justify-center rounded-full bg-[var(--color-accent)] text-white text-sm font-semibold">1</span>
            <h3 class="font-semibold">Send your invite code to the receiver</h3>
          </div>
          <p class="text-sm text-[var(--color-fg-muted)] mb-3">
            Copy the code below and send it to your peer — over Signal, email, WhatsApp, or any channel you trust.
          </p>
          <textarea id="sender-offer-blob" readonly class="w-full h-28 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] p-3 font-mono text-xs" placeholder="Generating invite code…"></textarea>
          <div class="mt-3 flex gap-2">
            <button id="sender-share-offer" class="hidden h-9 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)] disabled:opacity-50" disabled>Share</button>
            <button id="sender-copy-offer" class="h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90 disabled:opacity-50" disabled>Copy invite code</button>
            <button id="sender-mark-shared" class="h-9 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)] disabled:opacity-50" disabled>I've shared it →</button>
          </div>
        </div>

        <div id="psender-step2" class="rounded-lg border border-[var(--color-border)] p-5 opacity-40 pointer-events-none transition-opacity">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex size-7 items-center justify-center rounded-full bg-[var(--color-bg-muted)] border border-[var(--color-border-strong)] text-sm font-semibold">2</span>
            <h3 class="font-semibold">Paste the receiver's reply code</h3>
          </div>
          <p class="text-sm text-[var(--color-fg-muted)] mb-3">
            The receiver generates a reply code after opening your invite. Paste it here to finish the handshake.
          </p>
          <textarea id="sender-answer-blob" class="w-full h-28 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] p-3 font-mono text-xs" placeholder="Paste the reply code from the receiver here…"></textarea>
          <button id="sender-submit-answer" class="mt-3 h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Connect</button>
        </div>
      </div>

      <!-- RECEIVER FLOW -->
      <div id="paranoid-receiver" class="hidden space-y-4">
        <div id="precv-step1" class="rounded-lg border-2 border-[var(--color-accent)] p-5 transition-opacity">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex size-7 items-center justify-center rounded-full bg-[var(--color-accent)] text-white text-sm font-semibold">1</span>
            <h3 class="font-semibold">Paste the sender's invite code</h3>
          </div>
          <p class="text-sm text-[var(--color-fg-muted)] mb-3">
            Your peer should have sent you a long string. Paste it here.
          </p>
          <textarea id="recv-offer-blob" class="w-full h-28 rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] p-3 font-mono text-xs" placeholder="Paste the invite code from the sender here…"></textarea>
          <button id="recv-generate-answer" class="mt-3 h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Generate reply code</button>
        </div>

        <div id="precv-step2" class="rounded-lg border border-[var(--color-border)] p-5 opacity-40 pointer-events-none transition-opacity">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-flex size-7 items-center justify-center rounded-full bg-[var(--color-bg-muted)] border border-[var(--color-border-strong)] text-sm font-semibold">2</span>
            <h3 class="font-semibold">Send the reply code back to the sender</h3>
          </div>
          <p class="text-sm text-[var(--color-fg-muted)] mb-3">
            Copy the code below and send it back to the sender. Connection opens automatically once they paste it.
          </p>
          <textarea id="recv-answer-blob" readonly class="w-full h-28 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-3 font-mono text-xs"></textarea>
          <div class="mt-3 flex gap-2">
            <button id="recv-share-answer" class="hidden h-9 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)]">Share</button>
            <button id="recv-copy-answer" class="h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">Copy reply code</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Transfer workspace -->
    <section id="transfer-panel" class="hidden rounded-lg border border-[var(--color-border)] p-5">
      <!-- Sender drop zone -->
      <div id="drop-zone" class="hidden">
        <label
          for="file-input"
          class="block cursor-pointer rounded-lg border-2 border-dashed border-[var(--color-border-strong)] p-10 text-center transition-colors hover:bg-[var(--color-bg-muted)]"
        >
          <p class="text-lg font-medium">Drop files or click to pick</p>
          <p class="mt-1 text-sm text-[var(--color-fg-muted)]">Any size. Multiple files OK. Streamed directly to the receiver.</p>
          <input id="file-input" type="file" multiple class="hidden" />
          <input id="folder-input" type="file" webkitdirectory multiple class="hidden" />
        </label>
        <div class="mt-3 flex items-center justify-center gap-3 flex-wrap">
          <button id="pick-folder-btn" type="button" class="text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] inline-flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            Pick folder (zipped)
          </button>
          <span class="text-[var(--color-fg-subtle)]">·</span>
          <span class="text-xs text-[var(--color-fg-subtle)]">Drop a folder to zip & send</span>
        </div>
        <p class="mt-3 text-xs text-[var(--color-fg-subtle)] text-center">
          You can keep dropping more files after the current one finishes. Press <kbd class="px-1 py-0.5 rounded border border-[var(--color-border)] bg-[var(--color-bg-subtle)] text-[10px] font-mono">Ctrl/⌘ + V</kbd> to paste screenshots.
        </p>
      </div>

      <!-- Pending queue (sender, before peer joins) -->
      <section id="pending-queue-section" class="hidden mt-5">
        <div class="flex items-center justify-between mb-2 gap-3 flex-wrap">
