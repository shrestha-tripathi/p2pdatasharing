  <!--
    Placeholder shown in the origin tab while the transfer UI is floating
    in a PiP window. Hidden by default; pipWindow.openPip() flips the
    `hidden` class on open, restores on close.
  -->
  <div id="pip-placeholder" class="hidden mx-auto max-w-[1000px] px-4 md:px-8 py-16">
    <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-8 text-center">
