      <h2 class="text-xl font-semibold mb-2">Floating in a Picture-in-Picture window</h2>
      <p class="text-sm text-[var(--color-fg-muted)] mb-6">Your transfer UI is now in a small always-on-top window. Close it (or click below) to bring it back here.</p>
      <button id="pip-placeholder-bring-back" type="button" class="h-10 rounded-md border border-[var(--color-border)] px-4 text-sm hover:bg-[var(--color-bg-muted)] inline-flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 14-4 4M5 18l4 4M5 18h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8"/></svg>
        Bring back to this tab
      </button>
    </div>
  </div>

  <script>
    import { TeleportSession, type PeerConnState, type DiagSnapshot, CONNECT_TIMEOUT_MS } from "../lib/teleportSession";
    import { FileTransfer, saveFileToDisk } from "../lib/fileTransfer";
    import { ChatManager, type ChatMessage } from "../lib/chat";
    import { generateRoomId, formatBytes, formatRate, formatEta } from "../lib/format";
    import {
      listPairs, listPairsDeduped, upsertPair, removePair, generatePairSecret,
      buildPairUrl, parsePairFragment, getAutoAccept, setAutoAccept,
      deriveRoomId, deriveLobbyId, generateSessionRoomId,
      setPartnerDeviceId, syncPeerNickname,
      getDeviceId, getMyNickname, setMyNickname, hasCustomNickname,
      type Pair,
    } from "../lib/devicePairs";
    import { DeviceLobby, type RosterEntry } from "../lib/deviceLobby";
    import { acquireWakeLock, releaseWakeLock } from "../lib/wakeLock";
    import { mintCode, claimCode } from "../lib/pairCode";
    import {
      trackBackgroundTransfer,
      untrackBackgroundTransfer,
      clearBackgroundNotification,
    } from "../lib/backgroundWarning";
    import { site } from "../site.config";
    import QRCode from "qrcode";
    import { downloadZip } from "client-zip";
    import { startQrScanner, type ScannerController } from "../lib/qrScanner";
    import { isPipSupported, isPipOpen, openPip, closePip } from "../lib/pipWindow";
    import { initPipTour } from "../lib/pipTour";
    import { maybeShowConnectionAdvisory } from "../lib/connectionAdvisory";
    import { canShareFile, shareFile } from "../lib/shareSheet";

    // ---------- DOM ----------
    const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
      document.getElementById(id) as T;

    const rolePicker = $("role-picker");
    const roleSendBtn = $<HTMLButtonElement>("role-send");
    const roleRecvBtn = $<HTMLButtonElement>("role-receive");
    const roleReceiveInput = $("role-receive-input");
    const roleReceiveLink = $<HTMLInputElement>("role-receive-link");
    const roleReceiveGo = $<HTMLButtonElement>("role-receive-go");
    const roleReceiveScan = $<HTMLButtonElement>("role-receive-scan");
    const roleReceiveParanoid = $<HTMLButtonElement>("role-receive-paranoid");
    // QR scanner modal refs
    const qrScanModal = $("qr-scan-modal");
    const qrScanClose = $<HTMLButtonElement>("qr-scan-close");
    const qrScanVideo = $<HTMLVideoElement>("qr-scan-video");
    const qrScanStatus = $("qr-scan-status");
    const statusCard = $("status-card");
    const statusDot = $("status-dot");
    const statusLabel = $("status-label");
    const statusDetail = $("status-detail");
    const statusRole = $("status-role");
    const statusUptime = $("status-uptime") as HTMLSpanElement;
    const statusProgress = $("status-progress");
    const statusProgressFill = $("status-progress-fill");

    // ---------- Connection uptime ticker ----------
    let connectedSince = 0;
    let uptimeTimer: number | null = null;
    const fmtUptime = (ms: number) => {
      const s = Math.floor(ms / 1000);
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      const sec = s % 60;
      const pad = (n: number) => String(n).padStart(2, "0");
      return h > 0 ? `${h}:${pad(m)}:${pad(sec)}` : `${m}:${pad(sec)}`;
    };
    const tickUptime = () => {
      if (!connectedSince) return;
      statusUptime.textContent = fmtUptime(Date.now() - connectedSince);
    };
    const startUptime = () => {
      if (uptimeTimer) return;
      connectedSince = Date.now();
      statusUptime.classList.remove("hidden");
      tickUptime();
      uptimeTimer = window.setInterval(tickUptime, 1000);
    };
    const stopUptime = () => {
      if (uptimeTimer) { clearInterval(uptimeTimer); uptimeTimer = null; }
      connectedSince = 0;
      statusUptime.classList.add("hidden");
      statusUptime.textContent = "";
    };
    const diagGrid = $("diag-grid");
    const senderLink = $("sender-link");
    const shareLink = $<HTMLInputElement>("share-link");
    const copyLinkBtn = $<HTMLButtonElement>("copy-link");
    const shareLinkBtn = $<HTMLButtonElement>("share-link-btn");
    const qrToggle = $<HTMLButtonElement>("qr-toggle");
    const qrToggleLabel = $("qr-toggle-label");
    const qrWrap = $("qr-wrap");
    const qrCanvasBox = $("qr-canvas-box");
    // Short-code pairing — refs live alongside QR since they're rendered
    // together inside #sender-link. See sender pair-code block below.
    const pairCodeWrap = $("pair-code-wrap");
    const pairCodeEl = $("pair-code");
    const pairCodeStatus = $("pair-code-status");
    const pairCodeCopy = $<HTMLButtonElement>("pair-code-copy");
    const retryPanel = $("retry-panel");
    const retryBtn = $<HTMLButtonElement>("retry-btn");
    const retryParanoidBtn = $<HTMLButtonElement>("retry-paranoid");
    const paranoidToggle = $<HTMLInputElement>("paranoid-toggle");
    const paranoidPanel = $("paranoid-panel");
    const psSender = $("paranoid-sender");
    const psRecv = $("paranoid-receiver");
    const senderOfferBlob = $<HTMLTextAreaElement>("sender-offer-blob");
    const senderCopyOffer = $<HTMLButtonElement>("sender-copy-offer");
    const senderShareOffer = $<HTMLButtonElement>("sender-share-offer");
    const senderMarkShared = $<HTMLButtonElement>("sender-mark-shared");
    const psenderStep1 = $("psender-step1");
    const psenderStep2 = $("psender-step2");
    const senderAnswerBlob = $<HTMLTextAreaElement>("sender-answer-blob");
    const senderSubmitAnswer = $<HTMLButtonElement>("sender-submit-answer");
    const recvOfferBlob = $<HTMLTextAreaElement>("recv-offer-blob");
    const recvGenerateAnswer = $<HTMLButtonElement>("recv-generate-answer");
    const precvStep1 = $("precv-step1");
    const precvStep2 = $("precv-step2");
    const recvAnswerBlob = $<HTMLTextAreaElement>("recv-answer-blob");
    const recvCopyAnswer = $<HTMLButtonElement>("recv-copy-answer");
    const recvShareAnswer = $<HTMLButtonElement>("recv-share-answer");
    const transferPanel = $("transfer-panel");
    const dropZone = $("drop-zone");
    const fileInput = $<HTMLInputElement>("file-input");
    const folderInput = $<HTMLInputElement>("folder-input");
    const pickFolderBtn = $<HTMLButtonElement>("pick-folder-btn");
    const pendingQueueSection = $("pending-queue-section");
    const pendingQueueList = $<HTMLUListElement>("pending-queue");
    const pqCount = $("pq-count");
    const pqClear = $<HTMLButtonElement>("pq-clear");
    const pqReady = $("pq-ready");
    const pqReadyCount = $("pq-ready-count");
    const pqSend = $<HTMLButtonElement>("pq-send");
    const pqAuto = $<HTMLInputElement>("pq-auto");
    const pqHint = $("pq-hint");
    const receiverWait = $("receiver-wait");
    const fileList = $<HTMLUListElement>("file-list");
    const resetBar = $("reset-bar");
    const resetSummary = $("reset-summary");
    const resetClearBtn = $<HTMLButtonElement>("reset-clear");
    const resetSendMoreBtn = $<HTMLButtonElement>("reset-send-more");
    const peerHiddenBanner = $("peer-hidden-banner");
    const peerHiddenText = $("peer-hidden-text");
    const saveAllBar = $("save-all-bar");
    const saveAllSummary = $("save-all-summary");
    const saveAllBtn = $<HTMLButtonElement>("save-all-btn");
    const saveAllZipBtn = $<HTMLButtonElement>("save-all-zip-btn");
    const warnings = $("warnings");
    // Chat
    const chatPanel = $("chat-panel");
    const chatScroll = $<HTMLDivElement>("chat-scroll");
    const chatEmpty = $("chat-empty");
    const typingIndicator = $("typing-indicator");
    const chatForm = $<HTMLFormElement>("chat-form");
    const chatInput = $<HTMLTextAreaElement>("chat-input");
    const chatSend = $<HTMLButtonElement>("chat-send");

    // ---------- UI phase machine ----------
    /**
     * The transfer page has ~10 major panels (role picker, sender link,
     * receiver wait, retry, paranoid, transfer, lobby sender, lobby
     * receiver, lobby invite confirm, paired banner, status card,
     * chat, drop zone) that toggle independently across ~40 sites.
     *
     * Pre-this: each transition mutated panels individually. Easy to
     * forget one → multiple stale panels show at once (rolePicker + senderLink
     * + receiverWait + retryPanel all visible simultaneously after a retry).
     *
     * Now: one helper, single source of truth. Pass a "phase" → it sets
     * the visibility of EVERY major panel atomically. Call sites that
     * still ad-hoc-toggle panels keep working; this is purely additive.
     *
     * Mapping is intentionally explicit (no inheritance / merging) so
     * reading any one branch tells you exactly what's on screen.
     */
    type UIPhase =
      | "booting"          // initial load / bootRole reset — clear slate
      | "role-picker"      // user needs to pick send/receive
      | "paired-waiting"   // auto-connecting to paired devices
      | "sender-link"      // sender showing QR/link, waiting for receiver
      | "receiver-wait"    // receiver waiting for sender's handshake
      | "connected"        // session live — show transfer + chat
      | "failed";          // hard fail — show retry panel only

    const showOnly = (phase: UIPhase) => {
      // Get the panels that aren't aliased as consts elsewhere.
      const rolePairedBanner = document.getElementById("role-paired-banner");
      // Visibility set for each phase. Booleans → classList.add/remove("hidden").
      // If a panel isn't listed in `visible`, it's HIDDEN.
      const allPanels: Array<{ el: Element | null; key: string }> = [
        { el: rolePicker, key: "rolePicker" },
        { el: rolePairedBanner, key: "rolePairedBanner" },
        { el: lobbySenderPanel, key: "lobbySenderPanel" },
        { el: lobbyReceiverPanel, key: "lobbyReceiverPanel" },
        { el: lobbyInviteConfirm, key: "lobbyInviteConfirm" },
        { el: senderLink, key: "senderLink" },
        { el: receiverWait, key: "receiverWait" },
        { el: retryPanel, key: "retryPanel" },
        { el: paranoidPanel, key: "paranoidPanel" },
        { el: transferPanel, key: "transferPanel" },
        { el: dropZone, key: "dropZone" },
        { el: chatPanel, key: "chatPanel" },
      ];

      const visibleByPhase: Record<UIPhase, Set<string>> = {
        // Pristine — clear everything. Subsequent boot* call decides what to show.
        "booting": new Set(),
        // User must choose send/receive. Nothing else allowed.
        "role-picker": new Set(["rolePicker"]),
        // Auto-connect in progress — lobby cards drive the UX.
        "paired-waiting": new Set(["lobbySenderPanel", "lobbyReceiverPanel"]),
        // Sender ready, waiting for receiver. Show link + drop-zone so files queue.
        "sender-link": new Set(["senderLink", "transferPanel", "dropZone"]),
        // Receiver ready, waiting for sender's offer.
        "receiver-wait": new Set(["receiverWait"]),
        // Session live — show transfer + chat. Hide all setup UI.
        "connected": new Set(["transferPanel", "chatPanel"]),
        // Hard fail — retry panel only, lets user reboot cleanly.
        "failed": new Set(["retryPanel"]),
      };

      const visible = visibleByPhase[phase];
      for (const p of allPanels) {
        if (!p.el) continue;
        if (visible.has(p.key)) p.el.classList.remove("hidden");
        else p.el.classList.add("hidden");
      }
    };

    // ---------- State ----------
    type Role = "sender" | "receiver";
    let role: Role | null = null;
    let session: TeleportSession | null = null;
    /** When auto-connect succeeds, we remember which pair "won" so the UI
     *  can surface the trusted badge + disconnect button. Cleared on
     *  destroy/disconnect. */
    let activePair: Pair | null = null;

    /**
     * Centralized "this device is now idle" hook, captured by closure
     * over `lobbies` (declared later in this script). Assigned during
     * lobby init below; defaults to a no-op so cleanup paths can call
     * it unconditionally even before lobbies exist.
     *
     * Why this exists: every session-cleanup site (failure recovery,
     * manual disconnect, declined invite, paired-probe failure, bootRole
     * reset, beforeunload) MUST broadcast role="available" to peers AND
     * clear the local receiverBusy flag. Without it, a refresh on one
     * side leaves the other peer's roster showing us in "sending"/
     * "receiving" forever — making our row appear disabled with
     * "Receiving…" or triggering the misleading "already active in
     * another session" decline.
     *
     * Centralizing into one helper means new cleanup paths don't need
     * to remember the two-step (setRole + receiverBusy) reset.
     */
    let markIdle: () => void = () => { /* no-op until lobbies are wired up */ };
    // One-shot auto-recovery: if a sender's connection fails, rebuild on a fresh
    // room without bothering the user. Reset on manual retry or successful link.
    let autoReconnectAttempted = false;
    // Tracks whether the current session ever reached "connected" — used
    // to decide whether a "failed" event means "couldn't connect, try
    // fresh room" (haven't connected yet) or "established session dropped,
    // keep the same room so the peer can rejoin without a new link".
    let everConnectedThisSession = false;
    let transfer: FileTransfer | null = null;
    let chat: ChatManager | null = null;
    let lastSessionState: PeerConnState | "idle" = "idle";
    let lastMessageTs = 0;
    /**
     * Set true when an ICE restart has been initiated and the session
     * has dropped back to "signaling" from "connected". Used to swap
     * the status copy from "Waiting for peer to join…" to the friendlier
     * "Reconnecting over new network…" and to fire a "✓ Reconnected"
     * toast once we're back. Cleared on successful reconnect.
     */
    let renegotiating = false;

    // ---------- "Send another / Clear" reset bar ----------
    // Tracks completed transfer counts so we can show a helpful summary.
    let completedSendCount = 0;
    let completedSendBytes = 0;
    let completedRecvCount = 0;
    let completedRecvBytes = 0;

    const maybeShowResetBar = () => {
      // Show when nothing is actively transferring and at least one file finished
      const idle = !activeSendRow && !activeRecvRow && pendingQueue.length === 0;
      const anyCompleted = completedSendCount + completedRecvCount > 0;
      if (idle && anyCompleted) {
        const parts: string[] = [];
        if (completedSendCount > 0) {
          parts.push(`Sent ${completedSendCount} file${completedSendCount === 1 ? "" : "s"} (${formatBytes(completedSendBytes)})`);
        }
        if (completedRecvCount > 0) {
          parts.push(`Received ${completedRecvCount} file${completedRecvCount === 1 ? "" : "s"} (${formatBytes(completedRecvBytes)})`);
        }
        resetSummary.textContent = `${parts.join(" · ")}.`;
        // Sender gets the "Send more" CTA; receiver only gets "Clear list".
        resetSendMoreBtn.classList.toggle("hidden", role !== "sender");
        resetBar.classList.remove("hidden");
      } else {
        resetBar.classList.add("hidden");
      }
    };

    const clearCompletedRows = () => {
      // Remove all finished rows from the file list, reset counters.
      fileList.innerHTML = "";
      sendingRows.length = 0;
      receivingRows.length = 0;
      completedSendCount = 0;
      completedSendBytes = 0;
      completedRecvCount = 0;
      completedRecvBytes = 0;
      receivedItems.length = 0;
      saveAllBar.classList.add("hidden");
      resetBar.classList.add("hidden");
      // Receiver: re-show the "waiting for files" indicator so the user
      // knows the connection is still live and ready for more transfers.
      // Without this, clearing collapses the panel into an empty void
      // and looks like the session ended.
      if (role === "receiver" && lastSessionState === "connected") {
        receiverWait.classList.remove("hidden");
      }
    };

    resetClearBtn.addEventListener("click", clearCompletedRows);
    resetSendMoreBtn.addEventListener("click", () => {
      clearCompletedRows();
      // Reopen file picker on click (same gesture chain — works on iOS too)
      fileInput.click();
    });

    // ---------- "Save all to folder" (receiver) ----------
    // Buffer received files until either user saves individually or
    // taps "Save all to folder" (uses showDirectoryPicker — Chromium-only).
    type ReceivedItem = { file: File; name: string; saved: boolean; path?: string };
    const receivedItems: ReceivedItem[] = [];
    const supportsDirectoryPicker = typeof (window as unknown as { showDirectoryPicker?: unknown }).showDirectoryPicker === "function";

    const refreshSaveAllBar = () => {
      const unsaved = receivedItems.filter((r) => !r.saved);
      // Bar appears for ANY 2+ unsaved files — zip button always works.
      // Folder-picker button is shown only on Chromium browsers that support
      // the showDirectoryPicker API; everyone else still gets the zip option.
      if (unsaved.length < 2) {
        saveAllBar.classList.add("hidden");
        return;
      }
      // Toggle folder button visibility (only render if browser supports it).
      if (supportsDirectoryPicker) {
        saveAllBtn.classList.remove("hidden");
      } else {
        saveAllBtn.classList.add("hidden");
      }
      const totalBytes = unsaved.reduce((a, r) => a + r.file.size, 0);
      // Detect folder-aware items so we can advertise the tree-preserving
      // behavior. Mixed batches (some with path, some without) get the
      // folder label too — the flat ones just land at the picked root.
      const anyFolder = unsaved.some((r) => r.path);
      const rootFolders = anyFolder
        ? new Set(unsaved.filter((r) => r.path).map((r) => r.path!.split("/")[0]))
        : new Set<string>();
      const detail = anyFolder
        ? `${unsaved.length} files · ${formatBytes(totalBytes)} · ${rootFolders.size} folder${rootFolders.size === 1 ? "" : "s"} preserved`
        : `${unsaved.length} files ready (${formatBytes(totalBytes)})`;
      saveAllSummary.textContent = detail;
      saveAllBar.classList.remove("hidden");
    };

    saveAllBtn.addEventListener("click", async () => {
      const unsaved = receivedItems.filter((r) => !r.saved);
      if (unsaved.length === 0) return;
      saveAllBtn.disabled = true;
      const originalText = saveAllBtn.textContent;
      saveAllBtn.textContent = "Picking folder…";
      try {
        const pickFn = (window as unknown as {
          showDirectoryPicker: (opts?: { mode?: "read" | "readwrite" }) => Promise<FileSystemDirectoryHandle>;
        }).showDirectoryPicker;
        const dir = await pickFn({ mode: "readwrite" });
        saveAllBtn.textContent = `Saving 0/${unsaved.length}…`;
        let saved = 0;
        for (const item of unsaved) {
          try {
            // Items with a meta.path (e.g. "MyPhotos/2024/IMG_1.jpg") write
            // into recreated subdirectories. Items without a path land flat
            // at the picked root. uniqueName() is called against the FINAL
            // target dir so collisions are per-subdir (foo/bar/x.jpg and
            // foo/baz/x.jpg don't collide).
            const fh = item.path
              ? await ensureSubdirsAndGetFileHandle(dir, item.path)
              : await dir.getFileHandle(await uniqueName(dir, item.name), { create: true });
            const w = await fh.createWritable();
            await item.file.stream().pipeTo(w);
            item.saved = true;
            saved += 1;
            saveAllBtn.textContent = `Saving ${saved}/${unsaved.length}…`;
          } catch (e) {
            addWarning(`Failed to save ${item.path ?? item.name}: ${(e as Error).message}`);
          }
        }
        saveAllBtn.textContent = `✓ Saved ${saved} files`;
        playDingComplete();
        vibrate(120);
        // Update individual row Save buttons to show they're already saved
        for (const item of receivedItems) {
          if (item.saved) markRowAsSaved(item.path ?? item.name);
        }
        setTimeout(() => {
          saveAllBtn.disabled = false;
          saveAllBtn.textContent = originalText || "Save all to folder";
          refreshSaveAllBar();
        }, 2000);
      } catch (e) {
        // User cancelled the picker — silent.
        if ((e as DOMException).name !== "AbortError") {
          addWarning(`Save all failed: ${(e as Error).message}`);
        }
        saveAllBtn.disabled = false;
        saveAllBtn.textContent = originalText || "Save all to folder";
      }
    });

    /**
     * "Download as .zip" — universal fallback that works on every browser
     * (no showDirectoryPicker dependency). Uses client-zip to stream files
     * into a single .zip blob, then triggers a normal browser download.
     *
     * For folder-aware items, the path (e.g. "MyPhotos/2024/IMG_1.jpg") is
     * preserved INSIDE the zip — extracting recreates the directory tree
     * exactly the same way "Save all to folder" would.
     *
     * Streamed: we read the client-zip Response body chunk-by-chunk into
     * a Blob so we can show progress without holding the whole zip in memory
     * twice. Final blob is what gets handed to the download anchor.
     */
    saveAllZipBtn.addEventListener("click", async () => {
      const unsaved = receivedItems.filter((r) => !r.saved);
      if (unsaved.length === 0) return;
      saveAllZipBtn.disabled = true;
      const originalText = saveAllZipBtn.textContent;
      saveAllZipBtn.textContent = "Zipping…";
      try {
        // client-zip wants { name, lastModified, input }. We use the file's
        // path (if folder-aware) so extraction recreates the tree, else
        // just the bare filename.
        const zipResponse = downloadZip(
          unsaved.map((r) => ({
            name: r.path || r.name,
            lastModified: new Date(r.file.lastModified),
            input: r.file,
          })),
        );
        const totalUncompressed = unsaved.reduce((a, r) => a + r.file.size, 0);
        const reader = zipResponse.body!.getReader();
        const chunks: Uint8Array[] = [];
        let bytesSoFar = 0;
        let lastEmit = 0;
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          chunks.push(value);
          bytesSoFar += value.byteLength;
          const now = performance.now();
          if (now - lastEmit > 100) {
            // Estimate progress against UNCOMPRESSED total — zip ratio
            // varies wildly (already-compressed media ≈ 1.0, text/code ≈ 0.3),
            // so progress can briefly cap and then jump as compression
            // ratio reveals itself. Good enough for a button label.
            const pct = Math.min(99, Math.round((bytesSoFar / totalUncompressed) * 100));
            saveAllZipBtn.textContent = `Zipping ${pct}%…`;
            lastEmit = now;
          }
        }
        const blob = new Blob(chunks as BlobPart[], { type: "application/zip" });

        // Filename: if everything came from one root folder, use that name.
        // Otherwise generic "filetransfernow-N-files-YYYY-MM-DD.zip".
        const anyFolder = unsaved.some((r) => r.path);
        const rootFolders = anyFolder
          ? new Set(unsaved.filter((r) => r.path).map((r) => r.path!.split("/")[0]))
          : new Set<string>();
        const ts = new Date().toISOString().slice(0, 10);
        const zipName =
          rootFolders.size === 1
            ? `${[...rootFolders][0]}.zip`
            : `filetransfernow-${unsaved.length}-files-${ts}.zip`;

        // Trigger download via temporary anchor — universal, no APIs needed.
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = zipName;
        document.body.appendChild(a);
        a.click();
        a.remove();
        // Revoke after a tick — some browsers (Safari) need the URL alive
        // briefly after click to actually trigger the download.
        setTimeout(() => URL.revokeObjectURL(url), 1000);

        // Mark all included items as saved so the bar collapses naturally.
        // Note: this is a soft mark — user got the zip, but their individual
        // download buttons still work if they want copies (item.saved gates
        // visibility in the "Save all" bar only, not the per-row buttons).
        for (const item of unsaved) item.saved = true;
        saveAllZipBtn.textContent = `✓ Downloaded ${zipName}`;
        setTimeout(() => {
          saveAllZipBtn.disabled = false;
          saveAllZipBtn.textContent = originalText || "Download as .zip";
          refreshSaveAllBar();
        }, 2000);
      } catch (e) {
        addWarning(`Zip download failed: ${(e as Error).message}`);
        saveAllZipBtn.disabled = false;
        saveAllZipBtn.textContent = originalText || "Download as .zip";
      }
    });

    /** Probe for an unused filename in a directory: foo.png → foo-1.png if foo.png exists. */
    const uniqueName = async (dir: FileSystemDirectoryHandle, name: string): Promise<string> => {
      const dot = name.lastIndexOf(".");
      const stem = dot > 0 ? name.slice(0, dot) : name;
      const ext = dot > 0 ? name.slice(dot) : "";
      let candidate = name;
      let i = 0;
      while (i < 1000) {
        try {
          await dir.getFileHandle(candidate, { create: false });
          // Exists — try next
          i += 1;
          candidate = `${stem}-${i}${ext}`;
        } catch {
          return candidate;
        }
      }
      return `${stem}-${Date.now()}${ext}`;
    };

    /**
     * Walk a relative path like "MyPhotos/2024/IMG_1.jpg" inside rootDir,
     * creating intermediate directories as needed, and return a file handle
     * for the final segment (collision-safe via uniqueName on the leaf dir).
     *
     * Empty path segments are skipped (handles leading/trailing slashes
     * and double-slashes defensively). Throws if the path is empty or
     * pure separators.
     */
    const ensureSubdirsAndGetFileHandle = async (
      rootDir: FileSystemDirectoryHandle,
      relativePath: string,
    ): Promise<FileSystemFileHandle> => {
      const segments = relativePath.split("/").filter((s) => s.length > 0);
      if (segments.length === 0) {
        throw new Error("ensureSubdirsAndGetFileHandle: empty path");
      }
      const fileName = segments.pop()!;
      let dir = rootDir;
      for (const seg of segments) {
        // Filesystem-safe per-segment: getDirectoryHandle({create:true})
        // creates the subdir if missing, or hands back the existing one.
        dir = await dir.getDirectoryHandle(seg, { create: true });
      }
      const safe = await uniqueName(dir, fileName);
      return dir.getFileHandle(safe, { create: true });
    };

    /** Find the row showing this filename and mark its Save button as done. */
    const markRowAsSaved = (name: string) => {
      // Each row's action area has a Save button — find by walking receivingRows.
      for (const row of receivingRows) {
        if (row.name !== name) continue;
        const btn = row.action.querySelector('[data-act="save"]') as HTMLButtonElement | null;
        const hint = row.action.querySelector('[data-act="hint"]') as HTMLElement | null;
        if (btn && !btn.disabled) {
          btn.disabled = true;
          btn.textContent = "✓ Saved to folder";
        }
        if (hint) hint.textContent = "Saved via Save all.";
      }
    };


    // ---------- Local tab visibility → notify peer ----------
    // Fires whenever this tab goes background/foreground. Peer shows a
    // banner so they understand why throughput may drop on mobile.
    let lastVisibility: boolean | null = null;
    document.addEventListener("visibilitychange", () => {
      const hidden = document.visibilityState === "hidden";
      if (hidden === lastVisibility) return;
      lastVisibility = hidden;
      chat?.sendVisibility(hidden);
    });


    const SOUND_KEY = "p2pds:sound";

    // ---------- Device nickname ----------
    const NAME_KEY = "p2pds:name";
    const myNameInput = $<HTMLInputElement>("my-name");
    let myName: string = "";
    try { myName = localStorage.getItem(NAME_KEY) || ""; } catch {}
    myNameInput.value = myName;
    let peerName: string = "";

    const refreshIdentityLabels = () => {
      // Header status pill: "You · Shrestha" or fallback to Sender/Receiver
      if (myName && peerName) {
        statusRole.textContent = `${myName} ↔ ${peerName}`;
      } else if (myName) {
        statusRole.textContent = `${myName} · ${role === "receiver" ? "Receiver" : "Sender"}`;
      } else if (peerName) {
        statusRole.textContent = `${role === "receiver" ? "Receiver" : "Sender"} ↔ ${peerName}`;
      } else {
        statusRole.textContent = role === "receiver" ? "Receiver" : "Sender";
      }
      // Chat header "End-to-end encrypted · Not saved anywhere" — append peer name
      const chatPeerLabel = document.getElementById("chat-peer-label");
      if (chatPeerLabel) {
        chatPeerLabel.textContent = peerName ? `with ${peerName}` : "";
      }
    };

    myNameInput.addEventListener("input", () => {
      const v = myNameInput.value.trim().slice(0, 40);
      myName = v;
      try { localStorage.setItem(NAME_KEY, myName); } catch {}
      refreshIdentityLabels();
      // Push update to peer if chat already exists
      if (chat) chat.setMyName(myName);
    });

    let soundOn = true;
    try { soundOn = localStorage.getItem(SOUND_KEY) !== "0"; } catch {}
    const soundToggle = $<HTMLButtonElement>("sound-toggle");
    const soundIconOn = $("sound-icon-on");
    const soundIconOff = $("sound-icon-off");
    const refreshSoundIcon = () => {
      soundIconOn.classList.toggle("hidden", !soundOn);
      soundIconOff.classList.toggle("hidden", soundOn);
    };
    refreshSoundIcon();
    soundToggle.addEventListener("click", () => {
      soundOn = !soundOn;
      try { localStorage.setItem(SOUND_KEY, soundOn ? "1" : "0"); } catch {}
      refreshSoundIcon();
      // Tiny ping on enable so user gets feedback the sound works
      if (soundOn) playTone(660, 0.08, 0.04);
    });

    // Lazy AudioContext — Safari blocks creation until a user gesture, so
    // we create on first toggle/play attempt.
    let audioCtx: AudioContext | null = null;
    const ensureCtx = (): AudioContext | null => {
      if (audioCtx) return audioCtx;
      try {
        const Ctx = (window as unknown as { AudioContext?: typeof AudioContext; webkitAudioContext?: typeof AudioContext }).AudioContext
          || (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (Ctx) audioCtx = new Ctx();
      } catch { /* ignore */ }
      return audioCtx;
    };

    /** Play a short tone. freq Hz, duration s, volume 0..1 */
    const playTone = (freq: number, duration: number, volume = 0.06) => {
      if (!soundOn) return;
      const ctx = ensureCtx();
      if (!ctx) return;
      try {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.value = freq;
        // Smooth attack/decay — no clicks
        const now = ctx.currentTime;
        gain.gain.setValueAtTime(0, now);
        gain.gain.linearRampToValueAtTime(volume, now + 0.01);
        gain.gain.linearRampToValueAtTime(0, now + duration);
        osc.connect(gain).connect(ctx.destination);
        osc.start(now);
        osc.stop(now + duration + 0.02);
      } catch { /* AudioContext suspended or failed — silent */ }
    };

    const vibrate = (pattern: number | number[]) => {
      if (!soundOn) return;
      try { navigator.vibrate?.(pattern); } catch { /* ignore */ }
    };

    /** Major-third "ding" — friendly for "done" notifications */
    const playDingComplete = () => {
      playTone(880, 0.12, 0.06);
      setTimeout(() => playTone(1108, 0.18, 0.05), 90); // C#6 follow
    };
    /** Short rising chirp — peer just joined */
    const playConnectChirp = () => {
      playTone(523, 0.08, 0.05); // C5
      setTimeout(() => playTone(784, 0.10, 0.05), 70); // G5
    };
    /** Low buzz — something went wrong */
    const playFailBuzz = () => {
      playTone(220, 0.18, 0.06);
    };

    // ---------- Tab title progress ----------
    const originalTitle = document.title;
    let titleResetTimer: number | undefined;
    const setTabTitle = (text: string, autoResetMs?: number) => {
      document.title = text;
      if (titleResetTimer) clearTimeout(titleResetTimer);
      if (autoResetMs) {
        titleResetTimer = window.setTimeout(() => { document.title = originalTitle; }, autoResetMs);
      }
    };

    // Throttle title updates during transfer so we don't thrash on every progress event
    let lastTitlePct = -1;
    const updateTitleProgress = (bytes: number, total: number, prefix: string) => {
      const pct = total > 0 ? Math.round((bytes / total) * 100) : 0;
      if (pct === lastTitlePct) return;
      lastTitlePct = pct;
      setTabTitle(`(${pct}%) ${prefix} · ${originalTitle.split(" | ")[1] || site.shortName}`);
    };


    // ---------- Helpers ----------

    // Sync the connect-progress bar's animation duration with the actual
    // CONNECT_TIMEOUT_MS constant from teleportSession.ts. Done once at
    // boot via CSS custom property so the bar fill rate is the SINGLE
    // source of truth tied to the timeout — no magic 15s duplicate in CSS.
    // If the constant ever bumps to 20s, the bar matches automatically
    // without anyone editing CSS.
    if (statusProgressFill) {
      statusProgressFill.style.setProperty("--connect-timeout-ms", `${CONNECT_TIMEOUT_MS}ms`);
    }

    /**
     * Show/hide/reset the connect-progress bar based on the new state.
     * Idempotent — re-entering "connecting" from itself is a no-op
     * (avoids spurious reset on every diag tick); transitioning IN
     * from any non-connecting state restarts the fill animation.
     */
    let progressBarVisibleState: PeerConnState | null = null;
    const updateProgressBar = (s: PeerConnState) => {
      if (!statusProgress || !statusProgressFill) return;
      if (s === "connecting") {
        if (progressBarVisibleState === "connecting") return; // idempotent
        progressBarVisibleState = "connecting";
        statusProgress.classList.remove("hidden");
        statusProgress.setAttribute("aria-valuenow", "0");
        // Force animation restart: removing then re-adding the class on
        // the next frame is the canonical CSS-only reset pattern (without
        // it, re-entering "connecting" mid-animation would NOT restart).
        statusProgressFill.classList.remove("is-filling");
        // Trigger reflow so the class removal takes effect before re-add.
        void statusProgressFill.offsetWidth;
        statusProgressFill.classList.add("is-filling");
      } else {
        if (progressBarVisibleState === null) return; // already hidden
        progressBarVisibleState = null;
        statusProgress.classList.add("hidden");
        statusProgressFill.classList.remove("is-filling");
        statusProgress.setAttribute("aria-valuenow", "0");
      }
    };

    const setStatus = (s: PeerConnState, detail = "") => {
      const map: Record<PeerConnState, { label: string; color: string }> = {
        idle: { label: "Idle", color: "var(--color-fg-subtle)" },
        signaling: { label: "Waiting for peer to join…", color: "var(--color-warning)" },
        connecting: { label: "Connecting…", color: "var(--color-warning)" },
        connected: { label: "Connected — peer linked", color: "var(--color-success)" },
        disconnected: { label: "Disconnected", color: "var(--color-fg-subtle)" },
        failed: { label: "Connection failed", color: "var(--color-danger)" },
      };
      const { label, color } = map[s];
      statusLabel.textContent = label;
      statusDot.style.background = color;
      statusDetail.textContent = detail;
      updateProgressBar(s);
      if (s === "connected") startUptime(); else stopUptime();
    };

    /**
     * Render a much more honest status line based on the live diag snapshot.
     * Walks through the actual handshake stages so the user (and we) can
     * tell exactly where things are stuck.
     */
    const updateLiveStatus = (d: DiagSnapshot) => {
      // Already connected? Show the HONEST connection type by reading
      // the actual selected candidate pair via getStats() (DiagSnapshot
      // .selectedPair). Counting gathered candidate types is misleading
      // because one peer can gather a relay candidate "just in case"
      // while the live connection uses host↔srflx — leading to asymmetric
      // labels between sender and receiver. The selected pair is the
      // single source of truth both peers agree on.
      if (d.peerConnection === "connected") {
        const pairLabel = d.selectedPair
          ? d.selectedPair.summary === "relay"
            ? `Relayed via TURN (${d.selectedPair.local}↔${d.selectedPair.remote})`
            : d.selectedPair.summary === "direct"
            ? `Direct P2P (${d.selectedPair.local}↔${d.selectedPair.remote})`
            : "Connection type unknown"
          : "Detecting connection type…";
        setStatus("connected", `${pairLabel} · ${d.candidatesGathered} local / ${d.candidatesReceived} remote candidates`);
        return;
      }
      if (d.peerConnection === "failed") {
        setStatus(
          "failed",
          `ICE could not find a working path. Local: ${candSummary(d.candidateTypes)} · Got ${d.candidatesReceived} candidates from peer. Likely cause: strict NAT or no TURN.`,
        );
        return;
      }

      // Sender flow
      if (role === "sender") {
        if (d.ws === "idle" || d.ws === "connecting") {
          setStatus("signaling", `Connecting to signaling server (${d.ws})…`);
        } else if (d.ws === "open" && d.candidatesGathered === 0) {
          setStatus("signaling", "Gathering your network candidates (STUN/TURN)…");
        } else if (d.ws === "open" && d.candidatesReceived === 0 && d.peerConnection !== "connecting") {
          setStatus(
            "signaling",
            `Waiting for receiver to open your link. Your handshake is ready (${d.candidatesGathered} candidates, ${candSummary(d.candidateTypes)}).`,
          );
        } else if (d.peerConnection === "connecting" || d.peerConnection === "new") {
          setStatus(
            "connecting",
            `Receiver joined. Negotiating direct path — got ${d.candidatesReceived} of their candidates so far (ICE: ${d.iceConnection}).`,
          );
        } else if (d.ws === "closed") {
          setStatus("signaling", "Signaling offline — will auto-reconnect when you return to this tab.");
        } else {
          setStatus("signaling", `WS:${d.ws} ICE:${d.iceConnection} Peer:${d.peerConnection}`);
        }
      } else {
        // Receiver flow
        if (d.ws === "idle" || d.ws === "connecting") {
          setStatus("signaling", "Connecting to signaling server…");
        } else if (d.ws === "open" && d.candidatesReceived === 0 && !d.peerHasOffer) {
          setStatus("signaling", "Connected to room — waiting for sender's invite to arrive…");
        } else if (d.peerHasOffer && d.candidatesGathered === 0) {
          setStatus("signaling", "Got the invite. Gathering your network candidates…");
        } else if (d.peerConnection === "connecting" || d.peerConnection === "new") {
          setStatus(
            "connecting",
            `Negotiating with sender — ${d.candidatesGathered} local / ${d.candidatesReceived} remote candidates (ICE: ${d.iceConnection}).`,
          );
        } else if (d.ws === "closed") {
          setStatus("signaling", "Signaling offline — will reconnect.");
        } else {
          setStatus("signaling", `WS:${d.ws} ICE:${d.iceConnection} Peer:${d.peerConnection}`);
        }
      }
    };

    const candSummary = (t: DiagSnapshot["candidateTypes"]) => {
      const bits: string[] = [];
      if (t.host) bits.push(`${t.host} local`);
      if (t.srflx) bits.push(`${t.srflx} STUN`);
      if (t.relay) bits.push(`${t.relay} TURN`);
      if (t.prflx) bits.push(`${t.prflx} reflexive`);
      return bits.length ? bits.join(", ") : "none yet";
    };

    const renderDiag = (d: DiagSnapshot) => {
      const cell = (k: string, v: string, color = "var(--color-fg)") => `
        <div class="rounded border border-[var(--color-border)] bg-[var(--color-bg)] px-2 py-1.5">
          <div class="text-[10px] uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">${k}</div>
          <div class="text-xs truncate" style="color:${color}">${v}</div>
        </div>
      `;
      const colorFor = (v: string, good: string[], bad: string[]) =>
        good.includes(v) ? "var(--color-success)" : bad.includes(v) ? "var(--color-danger)" : "var(--color-fg-muted)";
      diagGrid.innerHTML =
        cell("Signaling WS", d.ws, colorFor(d.ws, ["open"], ["closed"])) +
        cell("ICE gathering", d.iceGathering, colorFor(d.iceGathering, ["complete"], [])) +
        cell("ICE connection", d.iceConnection, colorFor(d.iceConnection, ["connected", "completed"], ["failed", "disconnected"])) +
        cell("Peer connection", d.peerConnection, colorFor(d.peerConnection, ["connected"], ["failed"])) +
        cell("Data channel", d.dataChannel, colorFor(d.dataChannel, ["open"], ["closed"])) +
        cell("Has offer", d.peerHasOffer ? "yes" : "no") +
        cell("Local candidates", `${d.candidatesGathered}`) +
        cell("Remote candidates", `${d.candidatesReceived}`) +
        cell("Cand types", candSummary(d.candidateTypes)) +
        cell("Selected pair",
          d.selectedPair
            ? `${d.selectedPair.local}↔${d.selectedPair.remote}`
            : "—",
          d.selectedPair?.summary === "relay"
            ? "var(--color-warning, var(--color-fg))"
            : d.selectedPair?.summary === "direct"
            ? "var(--color-success)"
            : "var(--color-fg-muted)") +
        cell("Peak throughput", peakRatePerSec > 0 ? formatRate(peakRatePerSec) : "—",
          peakRatePerSec > 0 ? "var(--color-success)" : "var(--color-fg-muted)") +
        cell("Session ↑ sent",
          sessionBytesSent > 0 ? formatBytes(sessionBytesSent) : "—",
          sessionBytesSent > 0 ? "var(--color-fg)" : "var(--color-fg-muted)") +
        cell("Session ↓ recv",
          sessionBytesRecv > 0 ? formatBytes(sessionBytesRecv) : "—",
          sessionBytesRecv > 0 ? "var(--color-fg)" : "var(--color-fg-muted)");
    };

    const addWarning = (msg: string) => {
      const el = document.createElement("div");
      el.className =
        "rounded-md border border-[var(--color-warning)] bg-[color-mix(in_srgb,var(--color-warning)_10%,transparent)] p-3 text-sm";
      el.textContent = msg;
      warnings.appendChild(el);
    };

    /**
     * Neutral / progress-info banner — same machinery as addWarning but
     * accent-colored. Used for "Reconnecting over new network…" style
     * messages where nothing is broken yet.
     */
    const addInfo = (msg: string) => {
      const el = document.createElement("div");
      el.className =
        "rounded-md border border-[var(--color-accent)] bg-[color-mix(in_srgb,var(--color-accent)_10%,transparent)] p-3 text-sm";
      el.textContent = msg;
      warnings.appendChild(el);
    };

    const lockStep = (el: HTMLElement, locked: boolean) => {
      if (locked) {
        el.classList.add("opacity-40", "pointer-events-none");
        el.classList.remove("border-2", "border-[var(--color-accent)]");
        el.classList.add("border", "border-[var(--color-border)]");
      } else {
        el.classList.remove("opacity-40", "pointer-events-none");
        el.classList.remove("border", "border-[var(--color-border)]");
        el.classList.add("border-2", "border-[var(--color-accent)]");
      }
    };

    const peekBlobType = (blob: string): "offer" | "answer" | "empty" | "invalid" => {
      if (!blob || !blob.trim()) return "empty";
      try {
        const json = JSON.parse(decodeURIComponent(escape(atob(blob.trim()))));
        if (json?.type === "offer" || json?.type === "answer") return json.type;
        return "invalid";
      } catch {
        return "invalid";
      }
    };

    // ---------- File row UI ----------
    type Row = {
      el: HTMLLIElement;
      bar: HTMLElement;
      pct: HTMLElement;
      bytes: HTMLElement;
      rate: HTMLElement;
      eta: HTMLElement;
      action: HTMLElement;
      resume: HTMLElement;
      /** Retry / status pill on the row (e.g. "Reconnecting 3/8…"). */
      status: HTMLElement;
      /** Cancel button (sender rows only — receiver doesn't initiate). */
      cancel: HTMLButtonElement;
      name: string;
      /** File UUID — populated for sender rows so cancel() can target it. */
      id?: string;
    };
    const sendingRows: Row[] = [];
    let activeSendRow: Row | null = null;
    const receivingRows: Row[] = [];
    let activeRecvRow: Row | null = null;
    // Cancel watchdog — armed when user hits Cancel, cleared by the next
    // sendCancelled/error/sendComplete event. Single-row scope: only one
    // file sends at a time today.
    let cancelWatchdog: ReturnType<typeof setTimeout> | null = null;
    let cancelWatchdogId: string | null = null;

    const makeRow = (name: string, kind: "send" | "recv"): Row => {
      const el = document.createElement("li");
      el.className = "rounded-lg border border-[var(--color-border)] p-4";
      el.innerHTML = `
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 min-w-0 flex-wrap">
            <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-bg-muted)] uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">
              ${kind === "send" ? "Sending" : "Receiving"}
            </span>
            <span class="font-medium truncate" data-field="name"></span>
            <span class="hidden text-[10px] px-1.5 py-0.5 rounded-full bg-[var(--color-bg-muted)] text-[var(--color-accent)] border border-[var(--color-accent)] uppercase tracking-[0.06em] font-medium shrink-0" data-field="resume"></span>
            <span class="hidden text-[10px] px-1.5 py-0.5 rounded-full bg-[var(--color-bg-muted)] text-[var(--color-warning,#f59e0b)] border border-[var(--color-warning,#f59e0b)] uppercase tracking-[0.06em] font-medium shrink-0" data-field="status"></span>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <span class="text-sm text-[var(--color-fg-muted)] tabular-nums" data-field="pct">0%</span>
            ${kind === "send" ? `
              <button type="button" data-field="cancel"
                class="hidden h-7 rounded-md border border-[var(--color-border)] px-2 text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-danger,#ef4444)] hover:border-[var(--color-danger,#ef4444)]"
                title="Cancel transfer">Cancel</button>
            ` : ""}
          </div>
        </div>
        <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-[var(--color-bg-muted)]">
          <div class="h-full w-0 bg-[var(--color-accent)] transition-[width] duration-150" data-field="bar"></div>
        </div>
        <div class="mt-3 flex justify-between items-baseline gap-3 text-xs text-[var(--color-fg-muted)] tabular-nums">
          <span data-field="bytes" class="truncate">0 B / —</span>
          <span data-field="rate" class="text-sm font-semibold text-[var(--color-fg)] tabular-nums whitespace-nowrap" data-rate-active="0">0 B/s</span>
          <span data-field="eta" class="whitespace-nowrap">ETA —</span>
        </div>
        <div data-field="action" class="mt-3 hidden"></div>
      `;
      const q = (s: string) => el.querySelector(`[data-field="${s}"]`) as HTMLElement;
      q("name").textContent = name;
      fileList.appendChild(el);
      const cancelBtn = (el.querySelector('[data-field="cancel"]') as HTMLButtonElement | null);
      return {
        el, name,
        bar: q("bar"),
        pct: q("pct"),
        bytes: q("bytes"),
        rate: q("rate"),
        eta: q("eta"),
        action: q("action"),
        resume: q("resume"),
        status: q("status"),
        cancel: cancelBtn ?? document.createElement("button"),
      };
    };

    /** Highest sustained throughput observed this session, in bytes/sec.
     *  Updated from every progress tick; surfaced in the diagnostics panel
     *  so the user can see what their network actually achieved. */
    let peakRatePerSec = 0;
    /** Total bytes moved across all completed + in-flight rows this session,
     *  for both send and receive. Used by the diagnostics "Session total" cell. */
    let sessionBytesSent = 0;
    let sessionBytesRecv = 0;
    /** Per-row last-seen bytes so we can compute deltas without double-counting. */
    const lastRowBytes = new WeakMap<Row, number>();

    const updateRow = (row: Row, p: { bytes: number; total: number; ratePerSec: number; etaSec: number }) => {
      const pct = p.total > 0 ? Math.min(100, (p.bytes / p.total) * 100) : 0;
      row.pct.textContent = `${pct.toFixed(1)}%`;
      row.bar.style.width = `${pct}%`;
      row.bytes.textContent = `${formatBytes(p.bytes)} / ${formatBytes(p.total)}`;
      row.rate.textContent = formatRate(p.ratePerSec);
      // Visually highlight the rate when actively moving — accent color for
      // live throughput, muted when stalled or paused. Makes "the transfer
      // is happening RIGHT NOW" obvious at a glance.
      if (p.ratePerSec > 1024) {
        row.rate.style.color = "var(--color-accent)";
      } else {
        row.rate.style.color = "";
      }
      row.eta.textContent = `ETA ${formatEta(p.etaSec)}`;
      // Track peak — ignore the initial 0s and any wildly-spiking single-tick
      // values during channel buffering by only counting rates above 1 KB/s.
      if (p.ratePerSec > peakRatePerSec && p.ratePerSec > 1024) {
        peakRatePerSec = p.ratePerSec;
      }
      // Track session totals as monotonic deltas per row.
      const prev = lastRowBytes.get(row) ?? 0;
      const delta = Math.max(0, p.bytes - prev);
      if (delta > 0) {
        lastRowBytes.set(row, p.bytes);
        // Sender rows live in sendRowsById; receiver rows in recvRowsById.
        // Cheaper than a lookup: rely on the row's text label set at creation.
        if (row.el.textContent?.includes("Sending")) sessionBytesSent += delta;
        else sessionBytesRecv += delta;
      }
    };

    // ---------- File preview ----------
    /**
     * Detect what kind of preview we can render for a received file.
     * Returns the HTML markup; wirePreview() attaches handlers after insert.
     */
    type PreviewKind = "image" | "svg" | "video" | "audio" | "pdf" | "text" | "none";

    const detectPreviewKind = (file: File, name: string): PreviewKind => {
      const ext = name.toLowerCase().split(".").pop() ?? "";
      const mime = file.type.toLowerCase();
      // MIME-based detection (works for memory-blob files)
      if (mime.startsWith("image/") && mime !== "image/svg+xml") return "image";
      if (mime === "image/svg+xml" || ext === "svg") return "svg";
      if (mime.startsWith("video/")) return "video";
      if (mime.startsWith("audio/")) return "audio";
      if (mime === "application/pdf" || ext === "pdf") return "pdf";
      // Extension fallback — OPFS-backed Files lose their MIME type, so
      // a received .jpg / .mp4 / .mp3 has empty file.type and would
      // otherwise fall through to "none" and skip rendering a preview.
      const imageExts = ["jpg", "jpeg", "png", "gif", "webp", "avif", "bmp", "ico", "heic", "heif"];
      const videoExts = ["mp4", "webm", "mov", "m4v", "mkv", "avi", "ogv"];
      const audioExts = ["mp3", "wav", "ogg", "m4a", "aac", "flac", "opus"];
      if (imageExts.includes(ext)) return "image";
      if (videoExts.includes(ext)) return "video";
      if (audioExts.includes(ext)) return "audio";
      if (
        mime.startsWith("text/") ||
        mime === "application/json" ||
        mime === "application/xml" ||
        ["txt", "md", "csv", "tsv", "json", "xml", "yaml", "yml", "ts", "js", "tsx", "jsx", "py", "sh", "html", "css", "log", "ini", "conf", "toml"].includes(ext)
      ) {
        return "text";
      }
      return "none";
    };

    // Cap previews so we don't churn through huge files in-browser.
    const MAX_IMAGE_PREVIEW = 25 * 1024 * 1024; // 25 MB
    const MAX_VIDEO_PREVIEW = 200 * 1024 * 1024; // 200 MB
    const MAX_TEXT_PREVIEW = 1 * 1024 * 1024; // 1 MB

    const buildPreview = (file: File, meta: { size: number; name: string }): string => {
      const kind = detectPreviewKind(file, meta.name);
      const wrap = (inner: string) =>
        `<div class="mt-3 rounded-lg border border-[var(--color-border)] overflow-hidden bg-[var(--color-bg-subtle)]" data-preview="${kind}">${inner}</div>`;

      switch (kind) {
        case "image":
        case "svg":
          if (meta.size > MAX_IMAGE_PREVIEW) {
            return wrap(`<p class="p-4 text-xs text-[var(--color-fg-subtle)] text-center">Image too large to preview (${formatBytes(meta.size)}) — save and open instead.</p>`);
          }
          return wrap(`<img data-pv="img" alt="${escapeAttr(meta.name)}" class="block max-h-80 w-auto mx-auto" />`);

        case "video":
          if (meta.size > MAX_VIDEO_PREVIEW) {
            return wrap(`<p class="p-4 text-xs text-[var(--color-fg-subtle)] text-center">Video too large to preview (${formatBytes(meta.size)}) — save and open instead.</p>`);
          }
          return wrap(`<video data-pv="video" controls preload="metadata" class="block max-h-80 w-full bg-black"></video>`);

        case "audio":
          return wrap(`<audio data-pv="audio" controls preload="metadata" class="block w-full"></audio>`);

        case "pdf":
          return wrap(`
            <div class="p-3 flex items-center gap-3">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-[var(--color-fg-muted)] shrink-0">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium truncate">${escapeText(meta.name)}</p>
                <p class="text-xs text-[var(--color-fg-subtle)]">PDF · ${formatBytes(meta.size)}</p>
              </div>
              <button data-pv="pdf-open" class="h-8 rounded-md border border-[var(--color-border)] px-3 text-xs hover:bg-[var(--color-bg-muted)]">Open in new tab</button>
            </div>
          `);

        case "text":
          if (meta.size > MAX_TEXT_PREVIEW) {
            return wrap(`<p class="p-4 text-xs text-[var(--color-fg-subtle)] text-center">Text file too large to preview (${formatBytes(meta.size)}) — save and open instead.</p>`);
          }
          return wrap(`
            <div class="flex items-center justify-between px-3 py-2 border-b border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
              <span class="text-[10px] uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">Text preview</span>
              <button data-pv="copy-text" class="h-7 rounded-md border border-[var(--color-border)] px-2.5 text-xs font-medium hover:bg-[var(--color-bg-muted)] inline-flex items-center gap-1.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span data-pv="copy-text-label">Copy</span>
              </button>
            </div>
            <pre data-pv="text" class="m-0 p-3 text-xs font-mono leading-relaxed max-h-80 overflow-auto whitespace-pre-wrap break-words text-[var(--color-fg)]">Loading…</pre>
          `);

        default:
          return ""; // no preview for unknown / binary types
      }
    };

    /**
     * Hook up post-insertion logic for any preview that needs JS — sets
     * blob URLs on media tags, fills text content, wires the PDF button.
     * Uses one URL per preview and revokes it when the row is removed.
     */
    const wirePreview = (container: HTMLElement, file: File, meta: { name: string }) => {
      const pv = container.querySelector("[data-preview]") as HTMLElement | null;
      if (!pv) return;
      const kind = pv.dataset.preview as PreviewKind;

      const makeUrl = () => URL.createObjectURL(file);
      let createdUrl: string | null = null;

      if (kind === "image" || kind === "svg") {
        const img = pv.querySelector('[data-pv="img"]') as HTMLImageElement;
        createdUrl = makeUrl();
        img.src = createdUrl;
        img.onload = img.onerror = () => {
          if (createdUrl) setTimeout(() => URL.revokeObjectURL(createdUrl!), 60_000);
        };
      } else if (kind === "video") {
        const vid = pv.querySelector('[data-pv="video"]') as HTMLVideoElement;
        createdUrl = makeUrl();
        vid.src = createdUrl;
      } else if (kind === "audio") {
        const audio = pv.querySelector('[data-pv="audio"]') as HTMLAudioElement;
        createdUrl = makeUrl();
        audio.src = createdUrl;
      } else if (kind === "pdf") {
        const btn = pv.querySelector('[data-pv="pdf-open"]') as HTMLButtonElement;
        btn.onclick = () => {
          const u = makeUrl();
          window.open(u, "_blank", "noopener");
          // Revoke after a minute so the new tab has time to load.
          setTimeout(() => URL.revokeObjectURL(u), 60_000);
        };
      } else if (kind === "text") {
        const pre = pv.querySelector('[data-pv="text"]') as HTMLPreElement;
        const copyBtn = pv.querySelector('[data-pv="copy-text"]') as HTMLButtonElement | null;
        const copyLabel = pv.querySelector('[data-pv="copy-text-label"]') as HTMLElement | null;
        let fullText = "";
        file.text()
          .then((text) => {
            fullText = text;
            // Cap rendered length so a 1MB JSON doesn't lock the UI.
            const MAX_RENDER = 50_000;
            pre.textContent = text.length > MAX_RENDER
              ? `${text.slice(0, MAX_RENDER)}\n\n… (${formatBytes(file.size - MAX_RENDER)} more — save to see full file)`
              : text;
          })
          .catch((e) => {
            pre.textContent = `(Could not read text: ${(e as Error).message})`;
          });
        if (copyBtn && copyLabel) {
          copyBtn.addEventListener("click", async () => {
            if (!fullText) return;
            try {
              await navigator.clipboard.writeText(fullText);
              copyLabel.textContent = `✓ Copied (${formatBytes(new Blob([fullText]).size)})`;
              setTimeout(() => { copyLabel.textContent = "Copy"; }, 2000);
            } catch (err) {
              copyLabel.textContent = "Failed";
              addWarning(`Copy failed: ${(err as Error).message}`);
              setTimeout(() => { copyLabel.textContent = "Copy"; }, 2000);
            }
          });
        }
      }
    };

    const escapeText = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
    const escapeAttr = (s: string) => escapeText(s);

    // ---------- Wire session ----------
    const wireSession = (s: TeleportSession) => {
      transfer = new FileTransfer(s);
      chat = new ChatManager(s);
      wireChat(chat);
      // Push current local nickname to peer (no-op if empty)
      if (myName) chat.setMyName(myName);
      // Push current local visibility so peer's banner is correct from t=0
      chat.sendVisibility(document.visibilityState === "hidden");
      // Listen for peer's nickname announcement
      chat.emitter.on("peerHello", ({ name }) => {
        const isFirst = !peerName;
        peerName = name;
        refreshIdentityLabels();
        if (isFirst) {
          addWarning(`👋 ${name} connected`);
          // Auto-clear that toast after 5s
          setTimeout(() => {
            const toasts = warnings.querySelectorAll("div");
            toasts.forEach((t) => {
              if (t.textContent?.includes(`👋 ${name} connected`)) t.remove();
            });
          }, 5000);
        }
      });

      // Listen for peer's tab visibility — show banner so user knows
      // why a transfer might suddenly slow down (mobile bg throttling).
      chat.emitter.on("peerVisibility", ({ hidden }) => {
        if (hidden) {
          const who = peerName ? `${peerName}'s tab` : "Peer's tab";
          peerHiddenText.textContent = `${who} is in the background.`;
          peerHiddenBanner.classList.remove("hidden");
        } else {
          peerHiddenBanner.classList.add("hidden");
        }
      });

      // Layer 4 — heartbeat stall: peer JS got throttled (backgrounded,
      // OS suspended, etc.) and stopped responding even though the data
      // channel still claims open. Show a toast so the user knows why a
      // transfer froze, and let the reconnect logic take over.
      s.emitter.on("stalled", ({ silentForMs }) => {
        const sec = Math.round(silentForMs / 1000);
        addWarning(
          `⚠ Peer is unresponsive (no heartbeat for ${sec}s). Reconnecting…`,
        );
      });

      // Friendly toast when the adaptive relay-only retry kicks in.
      // teleportSession emits this specific log line right before
      // tearing down + rebuilding the peer with iceTransportPolicy=relay.
      // Without this, the user just sees the status pill flip back to
      // "signaling" with no explanation of WHY (their network needed
      // a relay path because direct/srflx pairs failed).
      s.emitter.on("log", (msg) => {
        if (msg === "switching-to-relay") {
          setStatus("connecting", "Your network needs a relay — switching to TURN…");
          addInfo("Switching to relay path (your network blocked direct P2P).");
        }
      });

      s.emitter.on("diag", (d) => {
        renderDiag(d);
        updateLiveStatus(d);
      });

      s.emitter.on("state", (state) => {
        const prevState = lastSessionState;
        lastSessionState = state;
        // Detect ICE restart / renegotiation — fires when the session
        // briefly drops back to "signaling" from a healthy "connected"
        // state (vs the initial handshake which goes idle → signaling).
        // Surfaces friendlier copy than the default "Waiting for peer
        // to join…" status pill, and a "✓ Reconnected" toast on success
        // so the user knows what just happened.
        if (state === "signaling" && prevState === "connected") {
          renegotiating = true;
          setStatus("connecting", "Reconnecting over new network…");
          addInfo("Network changed — renegotiating the connection…");
        } else if (state === "connected" && renegotiating) {
          renegotiating = false;
          setStatus("connected", "Reconnected");
          addInfo("✓ Reconnected — transfer continuing");
        } else {
          setStatus(state);
        }
        if (state === "connected") {
          everConnectedThisSession = true;
          // Audio chirp + buzz only on the FIRST connect (not on reconnect),
          // to avoid spamming on flaky networks.
          if (prevState !== "connected") {
            playConnectChirp();
            vibrate(80);
            // Mobile-only advisory: warn user to keep the tab open during
            // transfer (iOS Safari + in-app browsers aggressively suspend
            // backgrounded tabs). Self-gates: mobile-only, once per
            // session, opt-out checkbox for forever-dismiss. Symmetric:
            // both sender and receiver fire this hook on first connect.
            maybeShowConnectionAdvisory();
          }
          transferPanel.classList.remove("hidden");
          senderLink.classList.add("hidden");
          retryPanel.classList.add("hidden");
          paranoidPanel.classList.add("hidden");
          // Stop the pair-code countdown — peer is connected, code no longer needed.
          // (senderLink hides the wrapper visually; this clears the timer.)
          hidePairCode();
          // Successful link — re-arm one-shot auto-recovery for next failure.
          autoReconnectAttempted = false;
          // Surface the manual-disconnect button on every successful connect.
          const discBtn = document.getElementById("manual-disconnect");
          if (discBtn) discBtn.classList.remove("hidden");
          chatPanel.classList.remove("hidden");
          // Re-enable chat in case it was disabled by a transient disconnect.
          chatInput.disabled = false;
          chatInput.placeholder = "Type a message…";
          chatSend.disabled = chatInput.value.trim().length === 0;
          if (role === "receiver") {
            dropZone.classList.add("hidden");
            receiverWait.classList.remove("hidden");
          } else {
            receiverWait.classList.add("hidden");
            dropZone.classList.remove("hidden");
            // Sender: if there's a pre-queued batch, either auto-flush or show "Send all" CTA
            if (pendingQueue.length > 0) {
              if (pqAuto.checked) {
                flushPendingQueue();
              } else {
                pqReady.classList.remove("hidden");
                pqHint.textContent = "Drag to reorder. Tap Send all to start.";
              }
            }
          }
        }
        if (state === "disconnected") {
          // Safety-net trigger for ICE restart — if the OS-level
          // online/connectionchange listeners missed it (e.g. silent NAT
          // timeout where the network never actually changed), the PC
          // is our last signal that the path is dead. Give it a 2s
          // grace in case it self-recovers, then restart ICE if still
          // disconnected. Sender-only / live-channel guards are in
          // maybeRestartIce itself.
          setTimeout(() => {
            if (
              session &&
              session.currentRole === "sender" &&
              session.peer.connectionState === "disconnected"
            ) {
              maybeRestartIce("disconnected-state");
            }
          }, 2_000);
        }
        if (state === "failed") {
          // Hard failure recovery — there are three distinct paths:
          //
          //   (1) Paired auto-connect was active → the peer probably just
          //       refreshed/closed their tab. Don't show error UI; just
          //       destroy this session, hide the trusted/transfer bits,
          //       and re-run bootDevicesAuto so we get back to "Waiting
          //       for your devices..." and reconnect when the peer returns.
          //   (2) Sender on a random ?r= room, first failure of this session
          //       → mint a fresh room transparently (existing behavior).
          //   (3) Anything else → manual retry panel.
          if (activePair) {
            const lostPair = activePair;
            try { session?.destroy(); } catch {}
            session = null;
            role = null;
            activePair = null;
            // Reset lobby role to "available" + clear receiverBusy so the
            // OTHER peer (who's still in the lobby) sees us as idle, and
            // so future invites are accepted. Without this, refreshing
            // one side leaves the other side's roster showing us
            // "Receiving…" or "Busy sending" forever.
            markIdle();
            // Reset UI bits that only make sense when connected.
            transferPanel.classList.add("hidden");
            chatPanel.classList.add("hidden");
            senderLink.classList.add("hidden");
            dropZone.classList.add("hidden");
            receiverWait.classList.add("hidden");
            const badge = document.getElementById("chat-trusted-badge");
            if (badge) badge.classList.add("hidden");
            const discBtn = document.getElementById("manual-disconnect");
            if (discBtn) discBtn.classList.add("hidden");
            renderDevices();
            addWarning(`${lostPair.nickname} disconnected — waiting for it to come back…`);
            setStatus("signaling", `Lost connection to ${lostPair.nickname}. Will auto-reconnect when it returns.`);
            // Restart paired auto-connect after a brief settle.
            setTimeout(() => { bootDevicesAuto(); }, 800);
            return;
          }
          if (role === "sender" && !autoReconnectAttempted && !everConnectedThisSession) {
            autoReconnectAttempted = true;
            senderLink.classList.add("hidden");
            paranoidPanel.classList.add("hidden");
            retryPanel.classList.add("hidden");
            setStatus("connecting", "Connection failed — rebuilding on a fresh room…");
            // Brief delay so the user sees the message + the session can settle.
            setTimeout(() => {
              try { session?.close(); } catch {}
              // Strip the stale ?r= so bootRole mints a fresh one.
              const cleanUrl = `${location.origin}${import.meta.env.BASE_URL}transfer`;
              history.replaceState({}, "", cleanUrl);
              bootRole();
            }, 800);
            return;
          }
          // Established sender session that dropped (peer backgrounded /
          // minimized / went to sleep) — keep the same room so the receiver
          // can rejoin on their existing link. Show a friendly waiting state
          // instead of minting a new QR + invalidating their old one.
          if (role === "sender" && everConnectedThisSession) {
            setStatus("signaling", "Peer disconnected — waiting for them to come back on the same link…");
            addWarning("Peer disconnected. Same link still works when they return.");
            chatSend.disabled = true;
            chatInput.disabled = true;
            chatInput.placeholder = "Peer disconnected — waiting for reconnect…";
            return;
          }
          // Already auto-recovered once, or we're the receiver — surface the
          // manual retry UI like before. showOnly("failed") atomically hides
          // every other panel (sender-link, lobby cards, receiver-wait,
          // role-picker) so the retry panel is the only thing the user sees.
          showOnly("failed");
          chatSend.disabled = true;
          chatInput.disabled = true;
          chatInput.placeholder = "Peer disconnected";
          playFailBuzz();
          vibrate([100, 60, 100]);
          setTabTitle(`✗ Disconnected · ${originalTitle.split(" | ")[1] || site.shortName}`, 5000);
        }
        // NOTE: 'disconnected' is transient on mobile networks (ICE
        // renegotiation) — we deliberately do NOT disable chat on it.
        // Only 'failed' is terminal.
      });

      s.emitter.on("error", (e) => {
        addWarning(e.message);
        // Show the retry UI on ANY error during signaling (not just
        // hard ICE failures). Hides the share link so user doesn't
        // keep sending out a dead URL.
        if (statusLabel.textContent !== "Connected — peer linked") {
          senderLink.classList.add("hidden");
          paranoidPanel.classList.add("hidden");
          retryPanel.classList.remove("hidden");
          setStatus("failed", e.message);
        }
      });

      // Track rows by file id so retries reuse the existing row
      // instead of stacking duplicates on every reconnect.
      const sendRowsById = new Map<string, Row>();
      const recvRowsById = new Map<string, Row>();

      const showResumeBadge = (row: Row, resumedFrom: number, total: number) => {
        if (resumedFrom > 0) {
          const pct = total > 0 ? Math.round((resumedFrom / total) * 100) : 0;
          row.resume.textContent = `Resumed at ${pct}%`;
          row.resume.classList.remove("hidden");
        }
      };

      transfer.emitter.on("sendQueued", ({ id, name, size, position, total, path }) => {
        // A multi-file batch just started — render a queued row right now so
        // the user can cancel files 2..N before file 1 has even sent its
        // meta frame. Skip if only one file in batch (no point — single-file
        // sends are already covered by sendStart's row creation).
        if (total < 2) return;
        // Idempotency guard — if we somehow already have a row for this id
        // (e.g. resend after a transient error in a future flow) just bail.
        if (sendRowsById.get(id)) return;
        const row = makeRow(path ?? name, "send");
        row.id = id;
        sendingRows.push(row);
        sendRowsById.set(id, row);
        // Show "Queued · 2 of 5" in the status pill so the user knows this
        // row hasn't started yet — distinct from the "Reconnecting" pill
        // copy that sendRetry uses (same pill, different message).
        row.status.textContent = `Queued · ${position} of ${total}`;
        row.status.classList.remove("hidden");
        // Pre-fill the size in the bytes line so the row isn't just "0 B / —"
        // for queued items — gives the user a feel for what's coming.
        row.bytes.textContent = `0 B / ${formatBytes(size)}`;
        // Reveal cancel button + wire handler. Queued cancels resolve
        // synchronously inside the sendMultiple loop (next iteration after
        // the current file finishes / errors), so we flip the row UI to
        // "✕ Cancelled" immediately rather than parking it on "Cancelling…"
        // for potentially many seconds while preceding files drain.
        row.cancel.classList.remove("hidden");
        row.cancel.onclick = () => {
          if (!confirm(`Cancel queued file "${name}"?`)) return;
          transfer.cancel(id);
          // Immediate flip — sendQueueCancelled will fire later but its
          // handler is idempotent.
          row.status.classList.add("hidden");
          row.cancel.classList.add("hidden");
          row.action.classList.remove("hidden");
          row.action.innerHTML = `<span class="text-sm text-[var(--color-fg-muted)]">✕ Cancelled before sending</span>`;
        };
      });

      transfer.emitter.on("sendQueueCancelled", ({ id }) => {
        // Idempotent terminal handler. The click handler already flipped
        // the row when the user cancelled from queued state; this fires
        // when the sendMultiple loop actually reaches that id and skips it.
        // If the click handler did the flip, the cancel button is hidden —
        // skip. Otherwise (defensive: someone called transfer.cancel(id)
        // for a queued id programmatically without using the row's button),
        // do the same flip here.
        const row = sendRowsById.get(id);
        if (!row) return;
        if (row.cancel.classList.contains("hidden")) return; // already finalized
        row.status.classList.add("hidden");
        row.cancel.classList.add("hidden");
        row.action.classList.remove("hidden");
        row.action.innerHTML = `<span class="text-sm text-[var(--color-fg-muted)]">✕ Cancelled before sending</span>`;
      });

      transfer.emitter.on("sendStart", (m) => {
        // Keep screen on while a transfer is in flight (refcounted).
        void acquireWakeLock();
        // Track for background-pause notifications (layer 2).
        trackBackgroundTransfer();
        const existing = m.id ? sendRowsById.get(m.id) : undefined;
        if (existing) {
          activeSendRow = existing;
          existing.id = m.id;
          showResumeBadge(existing, m.resumedFrom ?? 0, m.size);
          // Reset retry status if we got here from a retry — the new
          // attempt has begun in earnest.
          existing.status.classList.add("hidden");
          existing.status.textContent = "";
        } else {
          activeSendRow = makeRow(m.path ?? m.name, "send");
          activeSendRow.id = m.id;
          sendingRows.push(activeSendRow);
          if (m.id) sendRowsById.set(m.id, activeSendRow);
          showResumeBadge(activeSendRow, m.resumedFrom ?? 0, m.size);
        }
        // Reveal cancel button + wire handler (idempotent — replacing onclick
        // is safe). Hidden by default so receiver rows never get one.
        if (activeSendRow.cancel.dataset.field === "cancel" && m.id) {
          activeSendRow.cancel.classList.remove("hidden");
          activeSendRow.cancel.onclick = () => {
            if (!confirm(`Cancel sending "${m.name}"?`)) return;
            transfer.cancel(m.id!);
            activeSendRow!.cancel.disabled = true;
            activeSendRow!.cancel.textContent = "Cancelling…";
            // Watchdog: if neither sendCancelled, error, nor sendComplete
            // fires within 5s, restore the button so the user isn't
            // permanently stuck staring at "Cancelling…". The retry-loop
            // post-cancel always emits one of those three events within
            // ~100ms now, so this only fires on truly degenerate cases
            // (e.g. the WebRTC stack hung mid-state-transition). Cleared
            // by any of those handlers below.
            if (cancelWatchdog) clearTimeout(cancelWatchdog);
            cancelWatchdogId = m.id!;
            cancelWatchdog = setTimeout(() => {
              if (!activeSendRow || activeSendRow.id !== cancelWatchdogId) return;
              activeSendRow.cancel.disabled = false;
              activeSendRow.cancel.textContent = "Cancel";
              addWarning(
                "Cancel didn't get an acknowledgement within 5s — the transfer may still be tearing down. Try Reload if it persists.",
              );
              cancelWatchdog = null;
              cancelWatchdogId = null;
            }, 5000);
          };
        }
      });
      transfer.emitter.on("sendProgress", (p) => {
        if (activeSendRow) updateRow(activeSendRow, p);
        updateTitleProgress(p.bytes, p.total, "Sending");
      });
      // Retry tick — sender's awaitChannelOpen is waiting for re-connect.
      // Surface as a per-row pill so users see we're actively recovering.
      transfer.emitter.on("sendRetry", ({ id, attempt, maxAttempts, timeoutMs }) => {
        const row = sendRowsById.get(id);
        if (!row) return;
        const sec = Math.round(timeoutMs / 1000);
        row.status.textContent = `Reconnecting ${attempt}/${maxAttempts} · up to ${sec}s`;
        row.status.classList.remove("hidden");
      });
      transfer.emitter.on("sendCancelling", ({ id }) => {
        // Defensive — the click handler already sets these, but if cancel()
        // is invoked programmatically (e.g. future "Cancel All" button)
        // we want the same visual lock-down without duplicating logic.
        const row = sendRowsById.get(id);
        if (row && row.cancel.dataset.field === "cancel") {
          row.cancel.disabled = true;
          row.cancel.textContent = "Cancelling…";
        }
      });
      transfer.emitter.on("sendCancelled", ({ id }) => {
        // Matched release for sendStart acquire.
        void releaseWakeLock();
        untrackBackgroundTransfer();
        // Clear watchdog — cancel succeeded, no need to nag the user.
        if (cancelWatchdog && cancelWatchdogId === id) {
          clearTimeout(cancelWatchdog);
          cancelWatchdog = null;
          cancelWatchdogId = null;
        }
        const row = sendRowsById.get(id);
        if (row) {
          row.status.classList.add("hidden");
          row.cancel.classList.add("hidden");
          row.action.classList.remove("hidden");
          row.action.innerHTML = `<span class="text-sm text-[var(--color-fg-muted)]">✕ Cancelled</span>`;
        }
        if (activeSendRow && activeSendRow.id === id) activeSendRow = null;
      });
      transfer.emitter.on("sendComplete", (m) => {
        // Matched release for sendStart acquire.
        void releaseWakeLock();
        untrackBackgroundTransfer();
        // Clear watchdog — natural completion races a slow cancel.
        if (cancelWatchdog && cancelWatchdogId === m.id) {
          clearTimeout(cancelWatchdog);
          cancelWatchdog = null;
          cancelWatchdogId = null;
        }
        if (activeSendRow) {
          activeSendRow.status.classList.add("hidden");
          activeSendRow.cancel.classList.add("hidden");
          activeSendRow.action.classList.remove("hidden");
          activeSendRow.action.innerHTML = `<span class="text-sm text-[var(--color-success)]">✓ Sent ${formatBytes(m.size)}</span>`;
        }
        activeSendRow = null;
        completedSendCount += 1;
        completedSendBytes += m.size;
        playDingComplete();
        vibrate(120);
        setTabTitle(`✓ Sent · ${originalTitle.split(" | ")[1] || site.shortName}`, 3000);
        lastTitlePct = -1;
        maybeShowResetBar();
      });

      transfer.emitter.on("receiveStart", (m) => {
        // Keep screen on for the duration of the receive (refcounted).
        void acquireWakeLock();
        trackBackgroundTransfer();
        receiverWait.classList.add("hidden");
        const existing = m.id ? recvRowsById.get(m.id) : undefined;
        if (existing) {
          activeRecvRow = existing;
          existing.id = m.id;
          showResumeBadge(existing, m.resumedFrom ?? 0, m.size);
        } else {
          activeRecvRow = makeRow(m.path ?? m.name, "recv");
          activeRecvRow.id = m.id;
          receivingRows.push(activeRecvRow);
          if (m.id) recvRowsById.set(m.id, activeRecvRow);
          showResumeBadge(activeRecvRow, m.resumedFrom ?? 0, m.size);
        }
      });
      transfer.emitter.on("receiveProgress", (p) => {
        if (activeRecvRow) updateRow(activeRecvRow, p);
        updateTitleProgress(p.bytes, p.total, "Receiving");
      });
      transfer.emitter.on("receiveCancelled", ({ id, name, bytesReceived, totalBytes }) => {
        // Sender told us they cancelled. Release our wake lock + background
        // tracking (matching the receiveStart acquire), then flip the row
        // to a ✕ Cancelled state so the user understands why the bar froze
        // instead of leaving it sitting at 17% forever. Best-effort match —
        // if we never saw a row for this id (e.g. cancel arrived before our
        // first receiveStart) we just drop the event.
        void releaseWakeLock();
        untrackBackgroundTransfer();
        const row = recvRowsById.get(id);
        if (!row) return;
        const displayName = name || row.name;
        const pct = totalBytes > 0 ? Math.round((bytesReceived / totalBytes) * 100) : 0;
        row.status.classList.add("hidden");
        row.action.classList.remove("hidden");
        row.action.innerHTML = `<span class="text-sm text-[var(--color-fg-muted)]">✕ Cancelled by sender${
          totalBytes > 0 ? ` at ${pct}% (${formatBytes(bytesReceived)} of ${formatBytes(totalBytes)})` : ""
        }</span>`;
        if (activeRecvRow && activeRecvRow.id === id) activeRecvRow = null;
        addWarning(`"${displayName}" was cancelled by the sender.`);
      });
      transfer.emitter.on("receiveComplete", ({ meta, file }) => {
        // Matched release for receiveStart acquire.
        void releaseWakeLock();
        untrackBackgroundTransfer();
        playDingComplete();
        vibrate([80, 40, 80]);
        setTabTitle(`✓ Received · ${originalTitle.split(" | ")[1] || site.shortName}`, 3000);
        lastTitlePct = -1;
        completedRecvCount += 1;
        completedRecvBytes += meta.size;
        // Buffer for "Save all to folder" — preserve folder path when the
        // sender set meta.path so Save All can recreate the directory tree.
        receivedItems.push({ file, name: meta.name, saved: false, path: meta.path });
        refreshSaveAllBar();
        if (activeRecvRow) {
          const row = activeRecvRow;
          row.action.classList.remove("hidden");
          const preview = buildPreview(file, meta);
          row.action.innerHTML = `
            ${preview}
            <div class="flex items-center gap-2 flex-wrap mt-3">
              <button class="h-9 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] hover:opacity-90" data-act="save">Save to disk</button>
              <button class="hidden h-9 rounded-md border border-[var(--color-border)] px-4 text-sm font-medium hover:bg-[var(--color-bg-muted)] inline-flex items-center gap-1.5" data-act="share" aria-label="Share via system share sheet" title="Share via system share sheet">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
                Share
              </button>
              <span class="text-xs text-[var(--color-fg-subtle)]" data-act="hint">Pick where to save the file on your device</span>
            </div>
          `;
          const btn = row.action.querySelector('[data-act="save"]') as HTMLButtonElement;
          const shareBtn = row.action.querySelector('[data-act="share"]') as HTMLButtonElement;
          const hint = row.action.querySelector('[data-act="hint"]') as HTMLElement;
          // Feature-detect native share sheet per-file (some browsers gate
          // on MIME type — see src/lib/shareSheet.ts comments). Hidden by
          // default in markup; we only unhide when the OS will actually
          // accept this specific File payload. Massive UX win on iOS where
          // it's the only practical path to Photos/Messages/Mail without
          // a 5-tap Files-app detour.
          if (canShareFile(file)) {
            shareBtn.classList.remove("hidden");
            shareBtn.onclick = async () => {
              shareBtn.disabled = true;
              const result = await shareFile(file, meta.name);
              shareBtn.disabled = false;
              if (result.status === "error") {
                addWarning(`Share failed: ${result.message}`);
              }
              // "cancelled" and "shared" are both silent successes from
              // a UI perspective — no toast, no state change. The user
              // already got the feedback they needed from the OS sheet
              // (cancel button vs. confirmation in the receiving app).
            };
          }
          // If this file came from a folder, update the hint with safe textContent
          // (folder names are user-supplied filesystem strings — never interpolate
          // directly into innerHTML).
          if (meta.path) {
            const rootFolder = meta.path.split("/")[0];
            hint.textContent = `Part of folder “${rootFolder}” — for the full tree on disk use “Save all to folder” below`;
          }
          btn.onclick = async () => {
            btn.disabled = true;
            btn.textContent = "Saving…";
            try {
              // Suggest the bare filename (browsers don't accept paths in
              // suggestedName) but flag the folder context in the hint.
              const result = await saveFileToDisk(file, meta.name);
              if (result === "saved" || result === "downloaded") {
                // Mark this item as saved so it drops out of "Save all" tally.
                // Match on path-or-name + id (when present) to disambiguate
                // multiple files with the same basename in different subdirs.
                const entry = receivedItems.find(
                  (r) => !r.saved &&
                    r.name === meta.name &&
                    (r.path ?? "") === (meta.path ?? ""),
                );
                if (entry) entry.saved = true;
                refreshSaveAllBar();
              }
              if (result === "saved") {
                btn.textContent = "✓ Saved to disk";
                hint.textContent = "File written to the location you chose.";
              } else if (result === "downloaded") {
                btn.textContent = "✓ Downloaded";
                hint.textContent = "Browser saved it to your Downloads folder.";
              } else {
                btn.disabled = false;
                btn.textContent = "Save to disk";
                hint.textContent = "Save cancelled — click again to retry.";
              }
            } catch (e) {
              btn.disabled = false;
              btn.textContent = "Save to disk";
              addWarning((e as Error).message);
            }
          };
          // Wire up preview interactions (text expansion, etc.)
          wirePreview(row.action, file, meta);
        }
        activeRecvRow = null;
        maybeShowResetBar();
      });

      transfer.emitter.on("error", (e) => {
        // Best-effort release — error may fire mid-transfer, so drop our
        // wake-lock claim. The refcount can't go below zero by design.
        void releaseWakeLock();
        untrackBackgroundTransfer();
        // Clear any armed cancel watchdog — error already tore down the
        // transfer, so the user's cancel button is meaningless now.
        if (cancelWatchdog) {
          clearTimeout(cancelWatchdog);
          cancelWatchdog = null;
          cancelWatchdogId = null;
        }
        addWarning(e.message);
      });

      // Layer 3 — resume handshake didn't come back in time (slow TURN /
      // mid-renegotiation). Sender will fall back to restart-from-0.
      transfer.emitter.on("resumeTimeout", () => {
        addWarning(
          "⚠ Resume handshake timed out — restarting transfer from the beginning. This may take longer.",
        );
      });

      // ── Peer voluntarily left (received "bye" frame) ──────────────
      // Without this, when the peer manually disconnects we wait ~15s
      // for ICE timeout and surface a vague "Peer disconnected" toast.
      // With this, we react instantly and show the correct UI for the
      // peer's actual intent: disconnect (clean leave), role-switch
      // (they're re-booting the page), or retry (transient — they'll
      // be back in a few seconds with a fresh offer).
      s.emitter.on("peerLeft", ({ reason }) => {
        const peerLabel = peerName || "Peer";
        if (reason === "retry") {
          // Transient — peer is rebuilding with iceTransportPolicy: 'relay'.
          // Don't tear down our side; just hint to the user it's recovering.
          // The peer will send a fresh offer over signaling within ~2s
          // and the existing peer-rejoined / setRemoteDescription path
          // will pick it back up automatically.
          setStatus("signaling", `${peerLabel} is reconnecting via relay…`);
          addInfo(`${peerLabel} is rebuilding the connection. This usually takes 1-3 seconds.`);
          return;
        }
        if (reason === "role-switch") {
          // Peer is rebooting their page (switching role / toggling
          // paranoid mode). Tear down our session and go back to a
          // pristine state so we don't show stale UI from the dead session.
          addWarning(`${peerLabel} switched modes. Waiting for them to reconnect…`);
          try { session?.destroy(); } catch { /* */ }
          session = null;
          role = null;
          activePair = null;
          markIdle();
          showOnly("paired-waiting");
          setStatus("signaling", `Waiting for ${peerLabel} to come back…`);
          // If we're in paired flow, bootDevicesAuto will pick them up
          // when they re-announce. If we're in random-link flow, the
          // existing 'disconnected'/'failed' handlers above keep the
          // current room alive so the peer can rejoin on the same link.
          return;
        }
        // Default ("disconnect" or unknown): peer hit the manual
        // Disconnect button OR closed their tab. Surface a clean,
        // accurate message and reset our UI atomically.
        addWarning(`${peerLabel} disconnected.`);
        try { session?.destroy(); } catch { /* */ }
        session = null;
        role = null;
        activePair = null;
        markIdle();
        // Paired flow → wait for them to come back. Random-link flow →
        // surface retry panel so the user knows they need to act.
        if (lobbies.length > 0) {
          showOnly("paired-waiting");
          setStatus("signaling", `${peerLabel} disconnected. Will auto-reconnect when they return.`);
          setTimeout(() => { bootDevicesAuto(); }, 800);
        } else {
          showOnly("failed");
          setStatus("disconnected", `${peerLabel} disconnected.`);
        }
      });

    };

    // ---------- Pending queue (sender, pre-connection) ----------
    type PendingItem = { id: string; file: File; thumbUrl?: string; path?: string };
    const pendingQueue: PendingItem[] = [];
    const PQ_AUTO_KEY = "p2pds:autoSend";

    // Restore "auto-send" preference
    try {
      pqAuto.checked = localStorage.getItem(PQ_AUTO_KEY) === "1";
    } catch {
      // localStorage may be blocked (private mode) — non-fatal
    }
    pqAuto.addEventListener("change", () => {
      try { localStorage.setItem(PQ_AUTO_KEY, pqAuto.checked ? "1" : "0"); } catch {}
    });

    const isChannelLive = (): boolean =>
      !!(transfer && lastSessionState === "connected");

    const revokeThumbs = (items: PendingItem[]) => {
      for (const it of items) {
        if (it.thumbUrl) URL.revokeObjectURL(it.thumbUrl);
      }
    };

    const escHtml = (s: string) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    const fileIconSvg = (file: File): string => {
      const t = file.type;
      const color = "text-[var(--color-fg-muted)]";
      if (t.startsWith("video/")) {
        return `<svg class="${color}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="m22 8-6 4 6 4z"/></svg>`;
      }
      if (t.startsWith("audio/")) {
        return `<svg class="${color}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`;
      }
      if (t === "application/pdf") {
        return `<svg class="${color}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>`;
      }
      return `<svg class="${color}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>`;
    };

    const renderPendingQueue = () => {
      pendingQueueList.innerHTML = "";
      if (pendingQueue.length === 0) {
        pendingQueueSection.classList.add("hidden");
        pqReady.classList.add("hidden");
        return;
      }
      pendingQueueSection.classList.remove("hidden");
      const totalBytes = pendingQueue.reduce((a, it) => a + it.file.size, 0);
      pqCount.textContent = `· ${pendingQueue.length} file${pendingQueue.length === 1 ? "" : "s"} · ${formatBytes(totalBytes)}`;
      pqReadyCount.textContent = `${pendingQueue.length} file${pendingQueue.length === 1 ? "" : "s"} · ${formatBytes(totalBytes)}`;

      for (const it of pendingQueue) {
        const li = document.createElement("li");
        li.draggable = true;
        li.dataset.id = it.id;
        li.className = "group flex items-center gap-3 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-2.5 cursor-grab active:cursor-grabbing hover:border-[var(--color-border-strong)] transition-colors";

        const grip = document.createElement("span");
        grip.className = "shrink-0 text-[var(--color-fg-subtle)] group-hover:text-[var(--color-fg-muted)] transition-colors select-none";
        grip.title = "Drag to reorder";
        grip.setAttribute("aria-label", "Drag handle");
        grip.innerHTML = `<svg width="14" height="20" viewBox="0 0 14 20" fill="currentColor" aria-hidden="true"><circle cx="4" cy="4" r="1.4"/><circle cx="10" cy="4" r="1.4"/><circle cx="4" cy="10" r="1.4"/><circle cx="10" cy="10" r="1.4"/><circle cx="4" cy="16" r="1.4"/><circle cx="10" cy="16" r="1.4"/></svg>`;
        li.appendChild(grip);

        const thumb = document.createElement("div");
        thumb.className = "shrink-0 size-10 rounded-md bg-[var(--color-bg)] border border-[var(--color-border)] overflow-hidden flex items-center justify-center";
        if (it.thumbUrl) {
          const img = document.createElement("img");
          img.src = it.thumbUrl;
          img.alt = "";
          img.className = "w-full h-full object-cover";
          thumb.appendChild(img);
        } else {
          thumb.innerHTML = fileIconSvg(it.file);
        }
        li.appendChild(thumb);

        const meta = document.createElement("div");
        meta.className = "min-w-0 flex-1";
        meta.innerHTML = `
          <p class="text-sm font-medium truncate">${escHtml(it.file.name)}</p>
          <p class="text-xs text-[var(--color-fg-muted)]">${formatBytes(it.file.size)}</p>
        `;
        li.appendChild(meta);

        const remove = document.createElement("button");
        remove.type = "button";
        remove.setAttribute("aria-label", "Remove from queue");
        remove.className = "shrink-0 size-7 rounded-md text-[var(--color-fg-subtle)] hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)] flex items-center justify-center";
        remove.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>`;
        remove.onclick = (e) => {
          e.stopPropagation();
          const idx = pendingQueue.findIndex((x) => x.id === it.id);
          if (idx >= 0) {
            const [gone] = pendingQueue.splice(idx, 1);
            if (gone.thumbUrl) URL.revokeObjectURL(gone.thumbUrl);
            renderPendingQueue();
          }
        };
        li.appendChild(remove);

        // Drag & drop reorder
        li.addEventListener("dragstart", (e) => {
          li.classList.add("opacity-50");
          e.dataTransfer?.setData("text/plain", it.id);
          if (e.dataTransfer) e.dataTransfer.effectAllowed = "move";
        });
        li.addEventListener("dragend", () => li.classList.remove("opacity-50"));
        li.addEventListener("dragover", (e) => {
          e.preventDefault();
          if (e.dataTransfer) e.dataTransfer.dropEffect = "move";
        });
        li.addEventListener("drop", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const draggedId = e.dataTransfer?.getData("text/plain");
          if (!draggedId || draggedId === it.id) return;
          const from = pendingQueue.findIndex((x) => x.id === draggedId);
          const to = pendingQueue.findIndex((x) => x.id === it.id);
          if (from < 0 || to < 0) return;
          const [moved] = pendingQueue.splice(from, 1);
          pendingQueue.splice(to, 0, moved);
          renderPendingQueue();
        });

        pendingQueueList.appendChild(li);
      }

      // Show "Send all" CTA only when channel is live
      if (isChannelLive()) {
        pqReady.classList.remove("hidden");
        pqHint.textContent = "Drag to reorder. Tap Send all to start.";
      } else {
        pqReady.classList.add("hidden");
        pqHint.textContent = "Drag to reorder. Files will be sent in this order once the receiver joins.";
      }
    };

    const generateThumb = async (file: File): Promise<string | undefined> => {
      if (file.size > 100 * 1024 * 1024) return undefined;
      if (file.type.startsWith("image/")) {
        try { return URL.createObjectURL(file); } catch { return undefined; }
      }
      if (file.type.startsWith("video/")) {
        return await extractVideoFrame(file).catch(() => undefined);
      }
      return undefined;
    };

    /**
     * Extract first usable frame from a video file -> data URL.
     * Uses a hidden <video> + canvas; seeks ~0.1s to skip black frames.
     */
    const extractVideoFrame = (file: File): Promise<string | undefined> => {
      return new Promise((resolve) => {
        const url = URL.createObjectURL(file);
        const video = document.createElement("video");
        video.preload = "metadata";
        video.muted = true;
        video.playsInline = true;
        video.src = url;
        let settled = false;
        const cleanup = () => { URL.revokeObjectURL(url); };
        const fail = () => { if (settled) return; settled = true; cleanup(); resolve(undefined); };
        const grab = () => {
          if (settled) return;
          try {
            const w = Math.min(160, video.videoWidth || 160);
            const ratio = (video.videoHeight || 90) / (video.videoWidth || 160);
            const h = Math.round(w * ratio);
            const canvas = document.createElement("canvas");
            canvas.width = w; canvas.height = h;
            const ctx = canvas.getContext("2d");
            if (!ctx) return fail();
            ctx.drawImage(video, 0, 0, w, h);
            const dataUrl = canvas.toDataURL("image/jpeg", 0.7);
            settled = true; cleanup(); resolve(dataUrl);
          } catch { fail(); }
        };
        video.addEventListener("loadeddata", () => {
          try { video.currentTime = Math.min(0.1, (video.duration || 1) / 2); } catch { grab(); }
        });
        video.addEventListener("seeked", grab);
        video.addEventListener("error", fail);
        setTimeout(fail, 4000);
      });
    };

    const enqueuePending = async (files: FileList) => {
      const items: PendingItem[] = [];
      for (const f of Array.from(files)) {
        const id = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
        const thumbUrl = await generateThumb(f);
        items.push({ id, file: f, thumbUrl });
      }
      pendingQueue.push(...items);
      renderPendingQueue();
    };

    /**
     * Folder-aware variant of enqueuePending — accepts {file, path} pairs
     * (from folder picker / drag-drop folder) and tags each PendingItem
     * with its relative path so flushPendingQueue can use the path-aware
     * send. Receiver groups + recreates the tree on Save All.
     */
    const enqueuePendingFolder = async (
      files: Array<{ file: File; path: string }>,
    ) => {
      const items: PendingItem[] = [];
      for (const { file, path } of files) {
        const id = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
        const thumbUrl = await generateThumb(file);
        items.push({ id, file, thumbUrl, path });
      }
      pendingQueue.push(...items);
      renderPendingQueue();
    };

    /**
     * Sender entry-point for a folder pick / drop. If channel is already
     * live and no queue, sends immediately with paths; otherwise queues
     * and either auto-flushes or surfaces the "Send all" CTA, matching
     * onPickFiles() semantics.
     */
    const onPickFolderFiles = (files: Array<{ file: File; path: string }>) => {
      if (files.length === 0) return;
      resetBar.classList.add("hidden");
      if (isChannelLive() && pendingQueue.length === 0) {
        transfer!.sendMultipleWithPaths(files).catch((e) => addWarning(e.message));
        return;
      }
      enqueuePendingFolder(files).then(() => {
        if (isChannelLive() && pqAuto.checked) {
          flushPendingQueue();
        } else if (isChannelLive()) {
          pqReady.classList.remove("hidden");
        }
      });
    };

    const flushPendingQueue = () => {
      if (pendingQueue.length === 0 || !transfer) return;
      // If any queued item carries a folder-relative path (from folder
      // picker / drag-drop folder), use the path-aware send so the
      // receiver can group + recreate the tree. Otherwise stay on the
      // plain FileList path for the existing drag/reorder code.
      const anyHasPath = pendingQueue.some((it) => it.path !== undefined);
      // Revoke thumb URLs now — rows are about to switch to the live sending UI
      revokeThumbs(pendingQueue);
      if (anyHasPath) {
        const items = pendingQueue.map((it) => ({ file: it.file, path: it.path }));
        pendingQueue.length = 0;
        renderPendingQueue();
        transfer.sendMultipleWithPaths(items).catch((e) => addWarning(e.message));
        return;
      }
      // Flat-file path (unchanged): build a synthetic FileList via DataTransfer.
      const files = pendingQueue.map((it) => it.file);
      const dt = new DataTransfer();
      for (const f of files) dt.items.add(f);
      pendingQueue.length = 0;
      renderPendingQueue();
      transfer.sendMultiple(dt.files).catch((e) => addWarning(e.message));
    };

    pqClear.onclick = () => {
      revokeThumbs(pendingQueue);
      pendingQueue.length = 0;
      renderPendingQueue();
    };

    pqSend.onclick = () => {
      pqReady.classList.add("hidden");
      flushPendingQueue();
    };

    // ---------- File picker / DnD ----------
    const onPickFiles = (files: FileList | null) => {
      if (!files || files.length === 0) return;
      // New activity → hide the "All done" bar until next idle moment
      resetBar.classList.add("hidden");
      // If channel is live AND user hasn't queued anything yet → send immediately (legacy behavior)
      if (isChannelLive() && pendingQueue.length === 0) {
        transfer!.sendMultiple(files).catch((e) => addWarning(e.message));
        return;
      }
      // Otherwise enqueue (covers: pre-connection AND mid-session "queue more")
      enqueuePending(files).then(() => {
        // If channel is already live and auto-send preference is on, flush immediately
        if (isChannelLive() && pqAuto.checked) {
          flushPendingQueue();
        } else if (isChannelLive()) {
          // Channel live but user has stuff queued → show Send all CTA
          pqReady.classList.remove("hidden");
        }
      });
    };
    fileInput.addEventListener("change", () => {
      onPickFiles(fileInput.files);
      fileInput.value = "";
    });

    // ---------- Folder support ----------
    // Walks a FileSystemDirectoryEntry recursively, returns flat list of
    // [File, relativePath] tuples. Used by drag-drop of folders.
    type FsEntry = FileSystemEntry & {
      isFile: boolean;
      isDirectory: boolean;
      createReader?: () => { readEntries: (cb: (entries: FsEntry[]) => void, err?: (e: Error) => void) => void };
      file?: (cb: (f: File) => void, err?: (e: Error) => void) => void;
    };

    const walkEntry = async (entry: FsEntry, pathPrefix: string): Promise<{ file: File; path: string }[]> => {
      if (entry.isFile && entry.file) {
        return new Promise((resolve, reject) => {
          entry.file!((f) => resolve([{ file: f, path: `${pathPrefix}${f.name}` }]), reject);
        });
      }
      if (entry.isDirectory && entry.createReader) {
        const reader = entry.createReader();
        // readEntries returns up to 100 entries per call — must loop until empty
        const allEntries: FsEntry[] = [];
        await new Promise<void>((resolve, reject) => {
          const readBatch = () => {
            reader.readEntries((batch) => {
              if (batch.length === 0) resolve();
              else { allEntries.push(...batch); readBatch(); }
            }, reject);
          };
          readBatch();
        });
        const newPrefix = `${pathPrefix}${entry.name}/`;
        const nested = await Promise.all(allEntries.map((e) => walkEntry(e, newPrefix)));
        return nested.flat();
      }
      return [];
    };

    // Live zipping-progress UI: replaces the previous toast hint with a
    // visible bar so multi-hundred-file folder drops don't feel hung.
    const zipProgressContainer = document.createElement("div");
    zipProgressContainer.id = "zip-progress-rows";
    zipProgressContainer.className = "space-y-2";
    // Mounted next to fileList so it appears with other transfer activity
    fileList.parentElement?.insertBefore(zipProgressContainer, fileList);

    const makeZipRow = (label: string, totalBytes: number) => {
      const row = document.createElement("div");
      row.className = "rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-3";
      row.innerHTML = `
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 min-w-0">
            <svg class="text-[var(--color-fg-muted)] shrink-0 animate-pulse" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
            <span class="text-sm font-medium truncate" data-field="label"></span>
          </div>
          <span class="text-xs text-[var(--color-fg-muted)] tabular-nums" data-field="pct">0%</span>
        </div>
        <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-[var(--color-bg-muted)]">
          <div class="h-full w-0 bg-[var(--color-accent)] transition-[width] duration-150" data-field="bar"></div>
        </div>
        <p class="mt-2 text-xs text-[var(--color-fg-subtle)] tabular-nums" data-field="bytes">Zipping… preparing</p>
      `;
      (row.querySelector('[data-field="label"]') as HTMLElement).textContent = label;
      zipProgressContainer.appendChild(row);
      const bar = row.querySelector('[data-field="bar"]') as HTMLElement;
      const pct = row.querySelector('[data-field="pct"]') as HTMLElement;
      const bytes = row.querySelector('[data-field="bytes"]') as HTMLElement;
      return {
        el: row,
        update(soFar: number) {
          // We don't know total zip size upfront, so show "X / ~Y" using uncompressed total as approx
          const ratio = totalBytes > 0 ? Math.min(0.99, soFar / totalBytes) : 0;
          const p = (ratio * 100).toFixed(1);
          pct.textContent = `${p}%`;
          bar.style.width = `${p}%`;
          bytes.textContent = `Zipping… ${formatBytes(soFar)} of ~${formatBytes(totalBytes)}`;
        },
        done() {
          row.remove();
        },
      };
    };

    const zipFilesAndQueue = async (
      files: { file: File; path: string }[],
      zipName: string,
    ) => {
      if (files.length === 0) return;
      const totalUncompressed = files.reduce((acc, { file }) => acc + file.size, 0);
      const progressRow = makeZipRow(
        `${zipName} · ${files.length} file${files.length === 1 ? "" : "s"}`,
        totalUncompressed,
      );
      try {
        // client-zip returns a Response with a streamed ReadableStream of
        // the zip bytes. We need the full Blob (protocol needs meta.size
        // up front) but we can tee progress along the way.
        const zipResponse = downloadZip(
          files.map(({ file, path }) => ({ name: path, lastModified: new Date(file.lastModified), input: file })),
        );
        const reader = zipResponse.body!.getReader();
        const chunks: Uint8Array[] = [];
        let bytesSoFar = 0;
        let lastEmit = 0;
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          chunks.push(value);
          bytesSoFar += value.byteLength;
          const now = performance.now();
          if (now - lastEmit > 100) {
            progressRow.update(bytesSoFar);
            lastEmit = now;
          }
        }
        progressRow.update(bytesSoFar);
        const blob = new Blob(chunks as BlobPart[], { type: "application/zip" });
        const zipFile = new File([blob], zipName, { type: "application/zip", lastModified: Date.now() });
        progressRow.done();
        const dt = new DataTransfer();
        dt.items.add(zipFile);
        onPickFiles(dt.files);
      } catch (e) {
        progressRow.done();
        addWarning(`Failed to zip folder: ${(e as Error).message}`);
      }
    };

    folderInput.addEventListener("change", async () => {
      const files = folderInput.files;
      if (!files || files.length === 0) return;
      // webkitRelativePath gives us "FolderName/sub/file.ext"
      const arr = Array.from(files).map((f) => ({
        file: f,
        path: (f as File & { webkitRelativePath?: string }).webkitRelativePath || f.name,
      }));
      folderInput.value = "";
      // Send as individual files (each tagged with path) so receiver can
      // group + recreate the directory tree on Save All. Replaces the
      // legacy zip-on-sender path; zipFilesAndQueue() is preserved
      // internally as a fallback for any future opt-in toggle.
      onPickFolderFiles(arr);
    });

    pickFolderBtn.addEventListener("click", () => folderInput.click());

    // Wire all file-intake affordances — drag-over visual feedback, file/
    // folder drop handling, and clipboard paste — onto a given document +
    // window pair. Called once for the main page at boot, and AGAIN for the
    // Picture-in-Picture window when the user pops out (see the PiP toggle
    // below).
    //
    // Why the second call is mandatory: openPip() REPARENTS <main> (which
    // contains the drop zone) into the PiP window's own document. DOM event
    // listeners are bound per-document, so the PiP doc starts with NONE of
    // these handlers. Without a `dragover` preventDefault + `drop` handler
    // there, Chromium falls back to its default action and NAVIGATES the PiP
    // window to the dropped file — i.e. the file "opens in a new tab" instead
    // of queueing. Binding the same handlers onto the PiP document fixes it.
    //
    // Returns a teardown that removes every listener it added. Used on PiP
    // close: the PiP document is destroyed anyway, but we detach explicitly so
    // rapid pop-out/pop-in toggling can never accumulate stale listeners, and
    // so each document gets its OWN dragDepth counter (sharing one across two
    // documents would desync the enter/leave bookkeeping).
    const wireFileIntake = (doc: Document, win: Window): (() => void) => {
      const teardowns: Array<() => void> = [];

      // Drop-zone visual feedback: pulse + glow when a file is dragged over.
      // We use a counter because dragenter/dragleave fire for every child
      // element, not just the outer container — naive add/remove would flicker.
      const dropZoneLabel = doc.getElementById("drop-zone-label");
      if (dropZoneLabel) {
        let dragDepth = 0;
        const isFileDrag = (e: DragEvent) =>
          Array.from(e.dataTransfer?.types ?? []).includes("Files");

        const onDragEnter = (e: DragEvent) => {
          if (role !== "sender") return;
          if (!isFileDrag(e)) return;
          dragDepth++;
          dropZoneLabel.classList.add("is-dragover");
        };
        const onDragLeave = (e: DragEvent) => {
          if (role !== "sender") return;
          if (!isFileDrag(e)) return;
          dragDepth = Math.max(0, dragDepth - 1);
          if (dragDepth === 0) dropZoneLabel.classList.remove("is-dragover");
        };
        // Reset on drop or window leave — covers edge cases where dragleave
        // fires non-symmetrically (drop on an unrelated target, Escape, etc.).
        const resetDragState = () => {
          dragDepth = 0;
          dropZoneLabel.classList.remove("is-dragover");
        };
        doc.addEventListener("dragenter", onDragEnter);
        doc.addEventListener("dragleave", onDragLeave);
        doc.addEventListener("drop", resetDragState);
        win.addEventListener("blur", resetDragState);
        teardowns.push(() => {
          doc.removeEventListener("dragenter", onDragEnter);
          doc.removeEventListener("dragleave", onDragLeave);
          doc.removeEventListener("drop", resetDragState);
          win.removeEventListener("blur", resetDragState);
        });
      }

      const onDragOver = (e: DragEvent) => e.preventDefault();
      const onDrop = async (e: DragEvent) => {
        e.preventDefault();
        if (role !== "sender") return; // ignore drops on receiver side
        const items = e.dataTransfer?.items;
        // Detect folder drops via DataTransferItem.webkitGetAsEntry
        if (items && items.length > 0) {
          const entries: FsEntry[] = [];
          for (const item of Array.from(items)) {
            const entry = (item as DataTransferItem & {
              webkitGetAsEntry?: () => FsEntry | null;
            }).webkitGetAsEntry?.();
            if (entry) entries.push(entry);
          }
          const hasFolder = entries.some((en) => en.isDirectory);
          if (hasFolder) {
            // Mixed or folder-only drop: walk every folder, queue all files
            // with paths so receiver groups + recreates the tree. Stand-alone
            // files dropped alongside go through onPickFiles (no path).
            const standalone: File[] = [];
            for (const entry of entries) {
              if (entry.isFile && entry.file) {
                const f: File = await new Promise((res, rej) => entry.file!(res, rej));
                standalone.push(f);
              } else if (entry.isDirectory) {
                const walked = await walkEntry(entry, "");
                // Re-prefix so the path root matches the folder name
                const withRoot = walked.map(({ file, path }) => ({
                  file,
                  path: `${entry.name}/${path}`,
                }));
                onPickFolderFiles(withRoot);
              }
            }
            if (standalone.length > 0) {
              const dt = new DataTransfer();
              for (const f of standalone) dt.items.add(f);
              onPickFiles(dt.files);
            }
            return;
          }
        }
        // Plain files (no folders) — original path
        onPickFiles(e.dataTransfer?.files ?? null);
      };
      doc.addEventListener("dragover", onDragOver);
      doc.addEventListener("drop", onDrop);
      teardowns.push(() => {
        doc.removeEventListener("dragover", onDragOver);
        doc.removeEventListener("drop", onDrop);
      });

      // Paste images from clipboard (sender only). Ctrl+V / Cmd+V with an
      // image on the clipboard auto-queues it as pasted-image-<ts>.<ext>.
      const onPaste = (e: ClipboardEvent) => {
        if (role !== "sender") return;
        // Skip if user is pasting into a text field (chat input, paranoid blobs).
        const target = e.target as HTMLElement | null;
        const tag = target?.tagName;
        if (tag === "INPUT" || tag === "TEXTAREA" || target?.isContentEditable) return;
        const items = e.clipboardData?.items;
        if (!items) return;
        const picked: File[] = [];
        for (const item of Array.from(items)) {
          if (item.kind !== "file") continue;
          const blob = item.getAsFile();
          if (!blob) continue;
          // Rename pasted images (browsers give them generic "image.png" names)
          // so multiple pastes don't clash.
          const ext = (blob.type.split("/")[1] || "bin").replace("+xml", "");
          const stamp = new Date().toISOString().replace(/[:.]/g, "-").slice(0, 19);
          const name = blob.type.startsWith("image/")
            ? `pasted-image-${stamp}.${ext}`
            : blob.name || `pasted-${stamp}.${ext}`;
          picked.push(new File([blob], name, { type: blob.type, lastModified: Date.now() }));
        }
        if (picked.length === 0) return;
        e.preventDefault();
        const dt = new DataTransfer();
        for (const f of picked) dt.items.add(f);
        onPickFiles(dt.files);
      };
      doc.addEventListener("paste", onPaste);
      teardowns.push(() => doc.removeEventListener("paste", onPaste));

      return () => teardowns.forEach((fn) => fn());
    };

    // Bind file intake on the main page now. Re-bound onto the PiP window when
    // the user pops out — see the Document Picture-in-Picture toggle below.
    wireFileIntake(document, window);

    // ---------- Boot per role ----------
    const showStatus = () => statusCard.classList.remove("hidden");

    // ---------- Chat UI ----------
    const formatTime = (ts: number): string => {
      const d = new Date(ts);
      return d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    };

    const isNearBottom = () => {
      const slack = 80; // px
      return chatScroll.scrollHeight - chatScroll.scrollTop - chatScroll.clientHeight < slack;
    };

    const appendBubble = (msg: ChatMessage, mine: boolean) => {
      chatEmpty.classList.add("hidden");

      const stickToBottom = isNearBottom();
      const showTimestamp = msg.ts - lastMessageTs > 5 * 60 * 1000;
      lastMessageTs = msg.ts;

      const wrap = document.createElement("div");
      wrap.className = `flex flex-col ${mine ? "items-end" : "items-start"}`;

      const bubble = document.createElement("div");
      bubble.className = mine
        ? "max-w-[75%] rounded-2xl rounded-br-md bg-[var(--color-accent)] text-white px-3 py-2 text-sm break-words whitespace-pre-wrap"
        : "max-w-[75%] rounded-2xl rounded-bl-md bg-[var(--color-bg-muted)] text-[var(--color-fg)] px-3 py-2 text-sm break-words whitespace-pre-wrap";
      bubble.textContent = msg.text; // textContent — never innerHTML (XSS-safe)
      wrap.appendChild(bubble);

      if (showTimestamp) {
        const time = document.createElement("span");
        time.className = "mt-1 text-[10px] text-[var(--color-fg-subtle)] tabular-nums";
        time.textContent = formatTime(msg.ts);
        wrap.appendChild(time);
      }

      chatScroll.appendChild(wrap);
      if (stickToBottom) chatScroll.scrollTop = chatScroll.scrollHeight;
    };

    const wireChat = (c: ChatManager) => {
      c.emitter.on("message", (msg) => appendBubble(msg, false));
      c.emitter.on("peerTyping", (isTyping) => {
        typingIndicator.classList.toggle("hidden", !isTyping);
        if (isTyping && isNearBottom()) chatScroll.scrollTop = chatScroll.scrollHeight;
      });
      c.emitter.on("peerDisconnected", () => {
        typingIndicator.classList.add("hidden");
        const notice = document.createElement("div");
        notice.className = "text-center text-xs text-[var(--color-fg-subtle)] py-2";
        notice.textContent = "Peer left the chat";
        chatScroll.appendChild(notice);
        chatScroll.scrollTop = chatScroll.scrollHeight;
      });
      c.emitter.on("error", (e) => addWarning(e.message));
    };

    // Auto-grow textarea + send-button enable/disable + typing notification.
    // Resets to the 40px base height when empty so the input never collapses
    // to 0 (which happens if scrollHeight is read while the panel is hidden).
    const autoGrow = () => {
      if (chatInput.value.length === 0) {
        chatInput.style.height = "40px";
        return;
      }
      chatInput.style.height = "auto";
      const next = Math.max(40, Math.min(chatInput.scrollHeight, 128));
      chatInput.style.height = `${next}px`;
    };
    chatInput.addEventListener("input", () => {
      autoGrow();
      chatSend.disabled = chatInput.value.trim().length === 0;
      if (chat && chatInput.value.length > 0) chat.setTyping(true);
      else chat?.setTyping(false);
    });
    chatInput.addEventListener("keydown", (e) => {
      // Enter sends, Shift+Enter inserts newline.
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        chatForm.requestSubmit();
      }
    });
    chatForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const text = chatInput.value.trim();
      if (!text || !chat) return;
      try {
        const msg = chat.send(text);
        appendBubble(msg, true);
        chatInput.value = "";
        chatSend.disabled = true;
        autoGrow();
      } catch (err) {
        addWarning((err as Error).message);
      }
    });

    const resetChatUI = () => {
      chatPanel.classList.add("hidden");
      chatScroll.innerHTML = "";
      chatScroll.appendChild(chatEmpty);
      chatEmpty.classList.remove("hidden");
      typingIndicator.classList.add("hidden");
      chatInput.value = "";
      chatInput.disabled = false;
      chatInput.placeholder = "Type a message…";
      chatSend.disabled = true;
      lastMessageTs = 0;
      autoGrow();
    };

    let qrCurrentUrl = "";
    const renderQrCode = async (url: string) => {
      qrCurrentUrl = url;
      // Auto-expand the QR by default for invite links — most people scan
      // rather than copy/paste, and the extra click was friction.
      qrCanvasBox.innerHTML = "";
      try {
        const canvas = document.createElement("canvas");
        await QRCode.toCanvas(canvas, url, {
          width: 220,
          margin: 1,
          errorCorrectionLevel: "M",
          color: { dark: "#000000", light: "#ffffff" },
        });
        qrCanvasBox.appendChild(canvas);
        qrWrap.classList.remove("hidden");
        qrToggleLabel.textContent = "Hide QR code";
      } catch (e) {
        // Quietly fall back to the toggle UX if QR gen fails.
        qrWrap.classList.add("hidden");
        qrToggleLabel.textContent = "Show QR code";
        addWarning(`Failed to generate QR: ${(e as Error).message}`);
      }
    };

    // ─── Sender-side short-code pairing ───────────────────────────────
    // Mint a code immediately on sender-role boot (parallel with QR), display
    // alongside the link/QR with a live countdown, auto-mint a fresh code
    // when the TTL elapses. Stops on peer connect (hidePairCode).
    //
    // All failure paths are non-fatal — sender still has link + QR. We
    // never throw out of these helpers.
    let pairCodeRoomId = "";
    let pairCodeExpiresAt = 0;
    let pairCodeTimer: ReturnType<typeof setInterval> | null = null;
    let pairCodeMinting = false;

    const clearPairCodeTimer = () => {
      if (pairCodeTimer !== null) {
        clearInterval(pairCodeTimer);
        pairCodeTimer = null;
      }
    };

    const formatCountdown = (ms: number): string => {
      const s = Math.max(0, Math.ceil(ms / 1000));
      const m = Math.floor(s / 60);
      const sec = s % 60;
      return `${m}:${String(sec).padStart(2, "0")}`;
    };

    const renderPairCodeTick = () => {
      const remaining = pairCodeExpiresAt - Date.now();
      if (remaining <= 0) {
        pairCodeStatus.textContent = "refreshing…";
        return false;
      }
      pairCodeStatus.textContent = `expires in ${formatCountdown(remaining)}`;
      return true;
    };

    const startPairCodeCountdown = () => {
      clearPairCodeTimer();
      renderPairCodeTick();
      pairCodeTimer = setInterval(() => {
        const alive = renderPairCodeTick();
        if (!alive) {
          // TTL elapsed — auto-mint a fresh code so the sender never sees a dead one.
          clearPairCodeTimer();
          void refreshPairCode();
        }
      }, 1000);
    };

    const refreshPairCode = async () => {
      if (!pairCodeRoomId || pairCodeMinting) return;
      pairCodeMinting = true;
      try {
        const result = await mintCode(site.signalingUrl, pairCodeRoomId);
        if (!result) {
          // Soft fail: hide the block, keep QR/link working.
          pairCodeStatus.textContent = "unavailable — use the link or QR";
          pairCodeEl.textContent = "—";
          pairCodeCopy.disabled = true;
          return;
        }
        pairCodeEl.textContent = result.code;
        pairCodeExpiresAt = result.expiresAt;
        pairCodeCopy.disabled = false;
        startPairCodeCountdown();
      } finally {
        pairCodeMinting = false;
      }
    };

    const showPairCode = async (roomId: string) => {
      pairCodeRoomId = roomId;
      pairCodeWrap.classList.remove("hidden");
      pairCodeEl.textContent = "····";
      pairCodeStatus.textContent = "generating…";
      pairCodeCopy.disabled = true;
      await refreshPairCode();
    };

    const hidePairCode = () => {
      clearPairCodeTimer();
      pairCodeWrap.classList.add("hidden");
      pairCodeRoomId = "";
      pairCodeExpiresAt = 0;
    };

    pairCodeCopy.addEventListener("click", async () => {
      const code = pairCodeEl.textContent?.trim() ?? "";
      if (!code || code === "····" || code === "—") return;
      try {
        await navigator.clipboard.writeText(code);
        const prev = pairCodeCopy.textContent;
        pairCodeCopy.textContent = "Copied!";
        setTimeout(() => { pairCodeCopy.textContent = prev || "Copy code"; }, 1500);
      } catch {
        addWarning("Couldn't copy — select the code manually instead.");
      }
    });

    qrToggle.addEventListener("click", async () => {
      if (!qrWrap.classList.contains("hidden")) {
        qrWrap.classList.add("hidden");
        qrToggleLabel.textContent = "Show QR code";
        return;
      }
      if (!qrCurrentUrl) return;
      try {
        // Re-render in case canvas was cleared.
        if (!qrCanvasBox.firstChild) {
          const canvas = document.createElement("canvas");
          await QRCode.toCanvas(canvas, qrCurrentUrl, {
            width: 220,
            margin: 1,
            errorCorrectionLevel: "M",
            color: { dark: "#000000", light: "#ffffff" },
          });
          qrCanvasBox.appendChild(canvas);
        }
        qrWrap.classList.remove("hidden");
        qrToggleLabel.textContent = "Hide QR code";
      } catch (e) {
        addWarning(`Failed to generate QR: ${(e as Error).message}`);
      }
    });

    const bootAutoSender = async () => {
      session = new TeleportSession({ signalingUrl: site.signalingUrl });
      wireSession(session);
      setStatus("signaling", "Share the link below — the connection opens automatically as soon as the receiver loads it.");
      const room = generateRoomId();
      const url = `${location.origin}${import.meta.env.BASE_URL}transfer?r=${room}`;
      shareLink.value = url;
      senderLink.classList.remove("hidden");
      // Fire short-code mint in parallel with QR — both render into the
      // share panel. Mint is non-blocking; if the Worker is unreachable the
      // pair-code block degrades silently and link/QR keep working.
      void showPairCode(room);
      // Await QR render so we know the canvas is mounted, then scroll the QR
      // into view so another device can scan it without the sender having to
      // align their screen. Centred so the code is roughly mid-viewport on
      // both desktop and phone. Honour prefers-reduced-motion.
      await renderQrCode(url);
      try {
        const reduceMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
        requestAnimationFrame(() => {
          qrWrap.scrollIntoView({
            behavior: reduceMotion ? "auto" : "smooth",
            block: "center",
            inline: "nearest",
          });
        });
      } catch {
        // scrollIntoView shouldn't throw, but if it does, it's pure polish — swallow.
      }
      await session.hostAuto(room);
    };

    const bootAutoReceiver = async (room: string) => {
      session = new TeleportSession({ signalingUrl: site.signalingUrl });
      wireSession(session);
      setStatus("signaling", "Connecting to sender…");
      await session.joinAuto(room);
    };

    /**
     * Paired-device flow with EXPLICIT role choice. Eliminates the "both
     * devices think they're host" glare bug entirely — host vs join is
     * decided by the user's tap on this screen, not by who happened to
     * arrive at the signaling server first. One device picks Send, the
     * other picks Receive, both derive the same room from the pair
     * secret, and the handshake completes deterministically.
     */
    // ─── Lobby-driven paired flow ──────────────────────────────────
    // Replaces the old bootPaired (which reused a derived-from-secret
    // room and suffered from glare/stale-state bugs). New model:
    //   1. Open a WS to the LobbyDO for this pair (announce identity).
    //   2. Sender sees a roster of online paired devices, picks one,
    //      sends an `invite` with a freshly-random sessionRoomId.
    //   3. Receiver gets `invite-received`, auto-accepts (or prompts),
    //      then both connect to the sessionRoomId via TeleportSession.
    //   4. Inviter is host, invitee is join — deterministic, no glare.
    // ─── Multi-lobby state ──────────────────────────────────────
    // We open ONE WebSocket per paired secret in parallel so the sender
    // can see every online paired device, and the receiver is reachable
    // via any of its pairs. Rosters are merged into a single unified
    // view (deduped by deviceId) for the UI.
    interface LobbyHandle {
      pair: Pair;
      lobby: DeviceLobby;
      roster: RosterEntry[];
    }
    let lobbies: LobbyHandle[] = [];
    let lobbyRole: "sender" | "receiver" | null = null;
    // Tracks outgoing invite so we know which sessionRoomId we're
    // waiting on an ack for, and which pair it went out on.
    let pendingInvite: { toDeviceId: string; sessionRoomId: string; pairSecret: string } | null = null;
    // Receiver: once accepted, lock the active pair so other lobbies
    // don't keep firing invite handlers.
    let receiverBusy = false;

    // Wire up the real markIdle now that lobbies + receiverBusy exist.
    // Cleanup callers anywhere in the script can invoke markIdle()
    // unconditionally — this overrides the no-op stub declared above.
    markIdle = () => {
      receiverBusy = false;
      for (const h of lobbies) {
        try { h.lobby.setRole("available"); } catch { /* lobby may be dead — fine */ }
      }
    };

    // DOM refs for the lobby UI
    const lobbySenderPanel = $("lobby-sender");
    const lobbySenderList = $<HTMLUListElement>("lobby-sender-list");
    const lobbySenderEmpty = $("lobby-sender-empty");
    const lobbySenderSwitchLink = $<HTMLButtonElement>("lobby-sender-switch-link");
    const lobbyReceiverPanel = $("lobby-receiver");
    const lobbyReceiverNickname = $("lobby-receiver-nickname");
    const lobbyReceiverRename = $<HTMLButtonElement>("lobby-receiver-rename");
    const lobbyReceiverStatus = $("lobby-receiver-status");
    const lobbyReceiverCancel = $<HTMLButtonElement>("lobby-receiver-cancel");
    const lobbyInviteConfirm = $("lobby-invite-confirm");
    const lobbyInviteFrom = $("lobby-invite-from");
    const lobbyInviteAccept = $<HTMLButtonElement>("lobby-invite-accept");
    const lobbyInviteDecline = $<HTMLButtonElement>("lobby-invite-decline");

    const stopAllLobbies = () => {
      for (const h of lobbies) {
        try { h.lobby.stop(); } catch { /* */ }
      }
      lobbies = [];
      lobbyRole = null;
      pendingInvite = null;
      receiverBusy = false;
    };

    /**
     * Merged roster across all paired lobbies, deduped by deviceId.
     * Same deviceId can show up in multiple pair lobbies if both sides
     * pair-added each other — we collapse to one entry and remember
     * which pair we'd use to invite/answer them.
     */
    interface UnifiedRosterEntry extends RosterEntry {
      pair: Pair;
      lobby: DeviceLobby;
    }
    const buildUnifiedRoster = (): UnifiedRosterEntry[] => {
      const myId = getDeviceId();
      const byDeviceId = new Map<string, UnifiedRosterEntry>();
      for (const h of lobbies) {
        for (const peer of h.roster) {
          if (peer.deviceId === myId) continue;
          // Prefer the entry with the most "useful" role (sending/receiving
          // beats available — shows actual state).
          const existing = byDeviceId.get(peer.deviceId);
          const candidate: UnifiedRosterEntry = { ...peer, pair: h.pair, lobby: h.lobby };
          if (!existing) {
            byDeviceId.set(peer.deviceId, candidate);
          } else {
            // Prefer non-"available" role for liveness signal
            const rank = (r: string) => r === "available" ? 0 : 1;
            if (rank(candidate.role) > rank(existing.role)) {
              byDeviceId.set(peer.deviceId, candidate);
            }
          }
        }
      }
      return Array.from(byDeviceId.values());
    };

    /**
     * When we see a peer in a pair's lobby, that peer IS the partner for
     * that pair (lobbies are scoped per pair-secret). Persist their
     * deviceId on the pair record + trigger dedup of any other pair we
     * have that already points at the same partner. Also auto-sync the
     * peer's broadcast nickname into our local pair label (unless the
     * user manually renamed — manualNickname flag wins).
     */
    const learnPartnerDeviceIds = (h: LobbyHandle) => {
      const myId = getDeviceId();
      let touchedAnyPair = false;
      for (const peer of h.roster) {
        if (peer.deviceId === myId) continue;
        // Auto-sync nickname (no-op if user manually renamed).
        if (syncPeerNickname(h.pair.secret, peer.nickname)) {
          touchedAnyPair = true;
        }
        if (h.pair.partnerDeviceId === peer.deviceId) continue;
        const kept = setPartnerDeviceId(h.pair.secret, peer.deviceId);
        // Update our in-memory pair handle (could be the kept one or removed).
        if (kept) {
          h.pair = kept;
        }
        touchedAnyPair = true;
        break; // exactly one partner per pair
      }
      // Refresh My Devices list since dedup may have removed entries
      // AND/OR nickname may have changed AND/OR online dots may need to
      // flip (roster event itself is the trigger for presence updates).
      if (touchedAnyPair) {
        try { renderDevices(); } catch { /* */ }
      }
    };

    /** Render the sender's unified list of online devices. */
    const renderLobbySenderList = () => {
      const others = buildUnifiedRoster();
      lobbySenderList.innerHTML = "";
      if (others.length === 0) {
        lobbySenderEmpty.classList.remove("hidden");
        return;
      }
      lobbySenderEmpty.classList.add("hidden");
      for (const peer of others) {
        const li = document.createElement("li");
        li.className = "flex items-center gap-3 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-3 cursor-pointer transition-colors hover:border-[var(--color-accent)] hover:bg-[var(--color-bg-muted)]";
        const dot = document.createElement("span");
        dot.className = "size-2.5 rounded-full shrink-0 bg-[var(--color-online)] presence-dot-online";
        li.appendChild(dot);
        const label = document.createElement("div");
        label.className = "flex-1 min-w-0";
        const name = document.createElement("div");
        name.className = "text-sm font-medium truncate";
        name.textContent = peer.nickname || "Unnamed device";
        label.appendChild(name);
        const meta = document.createElement("div");
        meta.className = "text-xs text-[var(--color-fg-muted)]";
        meta.textContent = peer.role === "available"
          ? "Ready to receive"
          : peer.role === "receiving" ? "Receiving…"
          : peer.role === "sending" ? "Busy sending" : peer.role;
        label.appendChild(meta);
        li.appendChild(label);
        const arrow = document.createElement("span");
        arrow.className = "text-[var(--color-fg-muted)] shrink-0";
        arrow.textContent = "→";
        li.appendChild(arrow);
        const busy = peer.role === "sending" || peer.role === "receiving";
        if (busy) {
          li.classList.remove("cursor-pointer", "hover:border-[var(--color-accent)]", "hover:bg-[var(--color-bg-muted)]");
          li.classList.add("opacity-60", "cursor-not-allowed");
        } else {
          li.onclick = () => inviteDevice(peer);
        }
        lobbySenderList.appendChild(li);
      }
    };

    const inviteDevice = async (target: UnifiedRosterEntry) => {
      const sessionRoomId = generateSessionRoomId();
      pendingInvite = { toDeviceId: target.deviceId, sessionRoomId, pairSecret: target.pair.secret };
      setStatus("signaling", `Inviting ${target.nickname}…`);
      target.lobby.invite(target.deviceId, sessionRoomId);
      // Pre-create the TeleportSession as host on the fresh session room
      // so the data channel is ready the moment they accept.
      role = "sender";
      session = new TeleportSession({ signalingUrl: site.signalingUrl });
      wireSession(session);
      activePair = target.pair;
      const badge = document.getElementById("chat-trusted-badge");
      if (badge) badge.classList.remove("hidden");
      session.emitter.on("state", (state) => {
        if (state === "connected") {
          addWarning(`✓ Connected to ${target.nickname}`);
          // Mark ourselves "sending" across all our lobbies so peers see it.
          for (const h of lobbies) h.lobby.setRole("sending");
          renderDevices();
          const disc = document.getElementById("manual-disconnect");
          if (disc) disc.classList.remove("hidden");
        }
      });
      try {
        await session.hostAuto(sessionRoomId);
      } catch (e) {
        addWarning(`Failed to start session: ${(e as Error).message}`);
      }
    };

    const handleIncomingInvite = (
      h: LobbyHandle,
      invite: { fromDeviceId: string; fromNickname: string; sessionRoomId: string },
    ) => {
      if (receiverBusy) {
        // Already accepted another invite — politely decline this one.
        h.lobby.respondToInvite(invite.fromDeviceId, invite.sessionRoomId, false, "Already in another session");
        return;
      }
      const accept = async () => {
        receiverBusy = true;
        lobbyInviteConfirm.classList.add("hidden");
        lobbyReceiverStatus.textContent = `Connecting to ${invite.fromNickname}…`;
        h.lobby.respondToInvite(invite.fromDeviceId, invite.sessionRoomId, true);
        // Join the session room as receiver.
        role = "receiver";
        session = new TeleportSession({ signalingUrl: site.signalingUrl });
        wireSession(session);
        activePair = h.pair;
        const badge = document.getElementById("chat-trusted-badge");
        if (badge) badge.classList.remove("hidden");
        session.emitter.on("state", (state) => {
          if (state === "connected") {
            addWarning(`✓ Connected to ${invite.fromNickname}`);
            // Mark ourselves "receiving" across all lobbies.
            for (const lh of lobbies) lh.lobby.setRole("receiving");
            renderDevices();
            const disc = document.getElementById("manual-disconnect");
            if (disc) disc.classList.remove("hidden");
          }
        });
        try {
          await session.joinAuto(invite.sessionRoomId);
        } catch (e) {
          addWarning(`Connect failed: ${(e as Error).message}`);
          receiverBusy = false;
        }
      };
      const decline = () => {
        lobbyInviteConfirm.classList.add("hidden");
        h.lobby.respondToInvite(invite.fromDeviceId, invite.sessionRoomId, false, "Declined by user");
        lobbyReceiverStatus.textContent = "Waiting for a sender to invite you…";
      };
      if (getAutoAccept()) { accept(); return; }
      lobbyInviteFrom.textContent = invite.fromNickname;
      lobbyInviteConfirm.classList.remove("hidden");
      lobbyInviteAccept.onclick = accept;
      lobbyInviteDecline.onclick = decline;
    };

    /**
     * Open lobbies for ALL paired devices in parallel. Both sender and
     * receiver call this — sender renders the unified roster + waits for
     * a tap; receiver shows "you're online" and waits for any invite.
     */
    const bootLobby = async (_unused: Pair, asRole: "sender" | "receiver") => {
      stopAllLobbies();
      lobbyRole = asRole;
      statusCard.classList.remove("hidden");
      const pairs = listPairsDeduped();
      if (pairs.length === 0) return;

      for (const pair of pairs) {
        const lobbyId = await deriveLobbyId(pair.secret);
        const handle: LobbyHandle = {
          pair,
          lobby: new DeviceLobby({
            signalingUrl: site.signalingUrl,
            lobbyId,
            deviceId: getDeviceId(),
            nickname: getMyNickname(),
            role: "available",
          }),
          roster: [],
        };
        const lobbyRef = handle.lobby;
        lobbyRef.on("roster", (peers) => {
          handle.roster = peers;
          learnPartnerDeviceIds(handle);
          if (asRole === "sender") renderLobbySenderList();
          // Always refresh My Devices so online dots flip on every roster
          // change (peer joined → green, peer left → grey). learnPartner...
          // only renders on first-learn or dedup; this catches subsequent
          // online/offline flips for already-known partners.
          try { renderDevices(); } catch { /* */ }
        });
        lobbyRef.on("invite", (invite) => {
          if (asRole === "receiver") handleIncomingInvite(handle, invite);
        });
        lobbyRef.on("inviteAck", (ack) => {
          if (asRole !== "sender" || !pendingInvite) return;
          if (ack.sessionRoomId !== pendingInvite.sessionRoomId) return;
          if (!ack.accepted) {
            addWarning(`Invite declined: ${ack.reason ?? "no reason given"}`);
            setStatus("signaling", "Pick another device or try again.");
            try { session?.destroy(); } catch { /* */ }
            session = null;
            pendingInvite = null;
            // Decline path also leaves us in role "sending" — roll back
            // to "available" so this device shows clickable in our own
            // roster + peers' rosters.
            markIdle();
          }
        });
        lobbyRef.on("error", (msg) => addWarning(`Lobby (${pair.nickname}): ${msg}`));
        lobbyRef.start();
        lobbies.push(handle);
      }

      if (asRole === "sender") {
        lobbySenderPanel.classList.remove("hidden");
        setStatus("signaling", "Looking for your online devices…");
        renderLobbySenderList();
      } else {
        lobbyReceiverPanel.classList.remove("hidden");
        lobbyReceiverNickname.textContent = getMyNickname();
        setStatus("signaling", "You're online. Waiting for an invite…");
      }
    };

    // Wire lobby UI buttons
    lobbySenderSwitchLink.onclick = () => {
      stopAllLobbies();
      lobbySenderPanel.classList.add("hidden");
      connectMode = "stranger";
      updateConnectModeUI();
      bootRole();
    };
    lobbyReceiverRename.onclick = () => {
      const newName = prompt("What should this device be called?", getMyNickname());
      if (newName && newName.trim()) {
        setMyNickname(newName);
        lobbyReceiverNickname.textContent = getMyNickname();
        try { refreshThisDeviceLabel(); } catch { /* */ }
        // Re-announce across all lobbies by stopping + restarting.
        if (lobbyRole === "receiver") {
          stopAllLobbies();
          bootLobby(null as unknown as Pair, "receiver");
        }
      }
    };
    lobbyReceiverCancel.onclick = () => {
      stopAllLobbies();
      lobbyReceiverPanel.classList.add("hidden");
      rolePicker.classList.remove("hidden");
      setStatus("idle", "Pick a role to get started.");
    };


    /**
     * Race ALL paired devices in parallel — for each pair, spin up a session
     * on the derived room (host or join depending on pair.iAmHost). The first
     * one to reach "connected" wins; the rest get destroyed.
     */
    let probeSessions: { session: TeleportSession; pair: Pair }[] = [];
    const bootDevicesAuto = async () => {
      if (!getAutoAccept()) {
        // User has explicitly disabled silent auto-connect — show the picker
        // instead so they can choose send/receive manually.
        rolePicker.classList.remove("hidden");
        return;
      }
      const pairs = listPairs();
      if (pairs.length === 0) {
        rolePicker.classList.remove("hidden");
        return;
      }
      // Show the status card with a "waiting" message + a "Pick role manually"
      // escape hatch so the user isn't stuck if no paired device comes online.
      statusCard.classList.remove("hidden");
      const names = pairs.map((p) => p.nickname).join(", ");
      setStatus("signaling", `Waiting for your devices to come online: ${names}`);

      // Show "or pick role manually" affordance after a few seconds.
      const manualEscape = setTimeout(() => {
        addWarning("No paired device online yet. You can also pick a role manually below.");
        rolePicker.classList.remove("hidden");
      }, 6000);

      // v1: probe pairs SEQUENTIALLY rather than in parallel. Each pair gets
      // ~12s to connect; on miss we destroy and move to the next. Sequential
      // probing keeps session/role correctly pinned to whichever pair wins
      // (parallel racing made wireSession's listeners attach to a session
      // that might lose, breaking previews + UI on the winner). Once one
      // connects, we stay on it forever — manual disconnect is the escape.
      let didConnect = false;
      for (const pair of pairs) {
        if (didConnect) break;
        try {
          const room = await deriveRoomId(pair.secret);
          const s = new TeleportSession({ signalingUrl: site.signalingUrl });
          probeSessions = [{ session: s, pair }];
          session = s;
          // Provisional role — will be reassigned by connectAuto based on
          // server-side first/second arrival, so we don't rely on stored
          // iAmHost (which breaks if either device clears storage or both
          // somehow stored iAmHost=true).
          role = "sender";
          wireSession(s);

          s.emitter.on("state", (state) => {
            if (state === "connected" && !didConnect) {
              didConnect = true;
              clearTimeout(manualEscape);
              rolePicker.classList.add("hidden");
              activePair = pair;
              const badge = document.getElementById("chat-trusted-badge");
              if (badge) badge.classList.remove("hidden");
              addWarning(`✓ Auto-connected to ${pair.nickname}`);
              renderDevices();
              const disc = document.getElementById("manual-disconnect");
              if (disc) disc.classList.remove("hidden");
            }
          });

          // connectAuto handles host/join election server-side. Role gets
          // re-pinned on the session AND mirrored to our local `role` var
          // (needed by the failure-recovery paths in wireSession).
          try {
            const decidedRole = await s.connectAuto(room);
            role = decidedRole;
          } catch (e) {
            // Role election timed out or signaling failed — fall through to
            // the per-pair wait below; if we don't connect in 12s, move on.
            addWarning(`Pair "${pair.nickname}" role election failed: ${(e as Error).message}`);
          }

          // Wait up to 12s for THIS pair to connect; if it doesn't, move on.
          await new Promise<void>((resolve) => {
            const t = setTimeout(resolve, 12_000);
            const off = s.emitter.on("state", (st) => {
              if (st === "connected" || st === "failed") {
                clearTimeout(t);
                off();
                resolve();
              }
            });
          });

          if (!didConnect) {
            try { s.destroy(); } catch {}
            session = null;
            role = null;
            // Probe failed (no connection landed) — reset advertised role
            // so the partner's roster doesn't show us as "sending" stuck.
            markIdle();
          }
        } catch (e) {
          addWarning(`Pair "${pair.nickname}" probe failed: ${(e as Error).message}`);
        }
      }

      if (!didConnect) {
        // Last fallback: surface the picker so the user isn't stuck.
        rolePicker.classList.remove("hidden");
      }
    };

    const resetParanoidUI = () => {
      psSender.classList.add("hidden");
      psRecv.classList.add("hidden");
      senderOfferBlob.value = "";
      senderAnswerBlob.value = "";
      recvOfferBlob.value = "";
      recvAnswerBlob.value = "";
      lockStep(psenderStep1, false);
      lockStep(psenderStep2, true);
      lockStep(precvStep1, false);
      lockStep(precvStep2, true);
      senderCopyOffer.disabled = true;
      senderShareOffer.disabled = true;
      senderMarkShared.disabled = true;
      senderSubmitAnswer.disabled = false;
      senderSubmitAnswer.textContent = "Connect";
      recvGenerateAnswer.disabled = false;
      recvGenerateAnswer.textContent = "Generate reply code";
    };

    const bootParanoidSender = async () => {
      session = new TeleportSession({ signalingUrl: site.signalingUrl });
      wireSession(session);
      paranoidPanel.classList.remove("hidden");
      resetParanoidUI();
      psSender.classList.remove("hidden");
      setStatus("signaling", "Generating your invite code…");

      const offer = await session.hostManual();
      senderOfferBlob.value = offer;
      senderCopyOffer.disabled = false;
      senderShareOffer.disabled = false;
      senderMarkShared.disabled = false;
      setStatus("signaling", "Step 1 — share the invite code with the receiver.");

      senderMarkShared.onclick = () => {
        lockStep(psenderStep1, true);
        lockStep(psenderStep2, false);
        setStatus("signaling", "Step 2 — paste the receiver's reply code below.");
        senderAnswerBlob.focus();
      };
      senderSubmitAnswer.onclick = async () => {
        const blob = senderAnswerBlob.value.trim();
        const kind = peekBlobType(blob);
        if (kind !== "answer") {
          addWarning(
            kind === "offer"
              ? "That looks like another invite code, not a reply code. The receiver needs to paste your invite first, then send you back the *reply* they generate."
              : kind === "empty"
              ? "Paste the receiver's reply code first."
              : "That doesn't look like a valid reply code. Ask the receiver to copy it again.",
          );
          return;
        }
        senderSubmitAnswer.disabled = true;
        senderSubmitAnswer.textContent = "Connecting…";
        try {
          await session!.acceptManualAnswer(blob);
        } catch (e) {
          addWarning((e as Error).message);
          senderSubmitAnswer.disabled = false;
          senderSubmitAnswer.textContent = "Connect";
        }
      };
    };

    const bootParanoidReceiver = async () => {
      session = new TeleportSession({ signalingUrl: site.signalingUrl });
      wireSession(session);
      paranoidPanel.classList.remove("hidden");
      resetParanoidUI();
      psRecv.classList.remove("hidden");
      setStatus("signaling", "Step 1 — paste the sender's invite code below.");

      recvGenerateAnswer.onclick = async () => {
        const blob = recvOfferBlob.value.trim();
        const kind = peekBlobType(blob);
        if (kind !== "offer") {
          addWarning(
            kind === "answer"
              ? "That looks like a reply code, not an invite. Reply codes go on the sender's side."
              : kind === "empty"
              ? "Paste the invite code from the sender first."
              : "That doesn't look like a valid invite code. Ask the sender to copy it again.",
          );
          return;
        }
        recvGenerateAnswer.disabled = true;
        recvGenerateAnswer.textContent = "Generating…";
        try {
          const answer = await session!.joinManual(blob);
          recvAnswerBlob.value = answer;
          lockStep(precvStep1, true);
          lockStep(precvStep2, false);
          setStatus("signaling", "Step 2 — copy the reply code and send it back to the sender.");
        } catch (e) {
          addWarning((e as Error).message);
          recvGenerateAnswer.disabled = false;
          recvGenerateAnswer.textContent = "Generate reply code";
        }
      };
    };

    const bootRole = () => {
      everConnectedThisSession = false;
      // Tell the peer we're rebooting BEFORE we destroy() the channel.
      // Categorized as "role-switch" since bootRole runs on user-initiated
      // retry / paranoid-toggle / role change — all visible-to-user
      // intentional reboots. Peer's UI shows "Waiting for them to come
      // back" instead of an error.
      try { session?.sendBye("role-switch"); } catch { /* */ }
      session?.destroy();
      session = null;
      // Always start a fresh role boot in an "available" lobby state,
      // even if the previous session ended dirty.
      markIdle();
      // Atomically reset every major panel — prevents stale UI from
      // the previous session (sender-link card, retry panel, role-picker,
      // lobby cards) lingering into the fresh role. The boot* calls
      // below will then show the panels appropriate to the new role.
      showOnly("booting");
      transfer = null;
      chat = null;
      lastSessionState = "idle";
      sendingRows.length = 0;
      receivingRows.length = 0;
      activeSendRow = null;
      activeRecvRow = null;
      completedSendCount = 0;
      completedSendBytes = 0;
      completedRecvCount = 0;
      completedRecvBytes = 0;
      receivedItems.length = 0;
      saveAllBar.classList.add("hidden");
      resetBar.classList.add("hidden");
      peerHiddenBanner.classList.add("hidden");
      fileList.innerHTML = "";
      warnings.innerHTML = "";
      transferPanel.classList.add("hidden");
      senderLink.classList.add("hidden");
      retryPanel.classList.add("hidden");
      paranoidPanel.classList.add("hidden");
      // Reset pair-code state — any prior timer is cleared so role-switching
      // doesn't leak intervals; a fresh mint happens via bootAutoSender.
      hidePairCode();
      // Reset pending queue UI (but only if switching role — preserve on paranoid toggle re-boot)
      // Easiest: just clear it. Re-picking files takes one tap.
      revokeThumbs(pendingQueue);
      pendingQueue.length = 0;
      renderPendingQueue();
      resetChatUI();
      showStatus();
      // Reset peer identity — new connection means new (possibly same) peer
      peerName = "";
      refreshIdentityLabels();

      // Sender: show drop zone + transfer panel IMMEDIATELY so files can be queued
      // before the receiver joins. Receiver doesn't get drop zone.
      if (role === "sender") {
        transferPanel.classList.remove("hidden");
        dropZone.classList.remove("hidden");
        receiverWait.classList.add("hidden");
      }

      const paranoid = paranoidToggle.checked;
      if (role === "sender") {
        if (paranoid) bootParanoidSender();
        else bootAutoSender();
      } else {
        if (paranoid) bootParanoidReceiver();
        else {
          const room = new URL(location.href).searchParams.get("r") || location.hash.replace(/^#/, "");
          if (!room) {
            addWarning("Receiver needs an invite link from the sender. Ask them to copy and send you their link.");
            return;
          }
          bootAutoReceiver(room);
        }
      }
    };

    // ---------- Role picker ----------
    const params = new URL(location.href);
    // Pair fragment takes priority over the legacy hash-as-room-id fallback.
    const incomingPair = parsePairFragment(location.hash);
    // Only treat the hash as a bare room ID when it looks like one (12 hex chars).
    const bareHashRoom = /^[0-9a-f]{12}$/i.test(location.hash.replace(/^#/, ""))
      ? location.hash.replace(/^#/, "")
      : "";
    const presetRoom = params.searchParams.get("r") || bareHashRoom;
    const sharedFlag = params.searchParams.get("shared") === "1";

    // ---------- My Devices wiring ----------
    const devicesAddBtn = $<HTMLButtonElement>("devices-add");
    const devicesAddPanel = $("devices-add-panel");
    const devicesAddName = $<HTMLInputElement>("devices-add-name");
    const devicesAddDone = $<HTMLButtonElement>("devices-add-done");
    const devicesPairUrl = $<HTMLInputElement>("devices-pair-url");
    const devicesPairCopy = $<HTMLButtonElement>("devices-pair-copy");
    const devicesPairQr = $("devices-pair-qr");
    const devicesList = $<HTMLUListElement>("devices-list");
    const devicesCount = $("devices-count");
    const devicesAutoAccept = $<HTMLInputElement>("devices-auto-accept");
    const thisDeviceName = $("this-device-name");
    const thisDeviceRename = $<HTMLButtonElement>("this-device-rename");

    const refreshThisDeviceLabel = () => {
      thisDeviceName.textContent = getMyNickname();
      // Subtle visual hint that the name is still the auto-default —
      // nudges multi-device users to rename so they can tell devices apart.
      if (!hasCustomNickname()) {
        thisDeviceName.classList.add("italic", "text-[var(--color-fg-muted)]");
        thisDeviceName.title = "Auto-detected name — tap Rename to make it recognizable in your other devices.";
      } else {
        thisDeviceName.classList.remove("italic", "text-[var(--color-fg-muted)]");
        thisDeviceName.title = "";
      }
    };

    const promptForDeviceName = (reason?: string): boolean => {
      const current = hasCustomNickname() ? getMyNickname() : "";
      const message = reason
        ? `${reason}\n\nWhat should this device be called? (e.g. "Shrestha's iPhone", "Work Mac")`
        : "What should this device be called? (e.g. \"Shrestha's iPhone\", \"Work Mac\")";
      const name = prompt(message, current);
      if (name && name.trim()) {
        setMyNickname(name);
        refreshThisDeviceLabel();
        return true;
      }
      return false;
    };

    thisDeviceRename.onclick = () => promptForDeviceName();
    refreshThisDeviceLabel();

    const pairIncoming = $("pair-incoming");
    const pairIncomingName = $<HTMLInputElement>("pair-incoming-name");
    const pairIncomingDetail = $("pair-incoming-detail");
    const pairIncomingAccept = $<HTMLButtonElement>("pair-incoming-accept");
    const pairIncomingCancel = $<HTMLButtonElement>("pair-incoming-cancel");

    /**
     * Returns true if any active lobby for this pair has the partner
     * device present in its roster. Used for the live online dot in
     * "My Devices". Independent of activePair (which only goes true
     * during an actual transfer) — this is "are they reachable RIGHT
     * NOW for an invite?".
     */
    const isPairOnline = (pair: Pair): boolean => {
      const myId = getDeviceId();
      for (const h of lobbies) {
        if (h.pair.secret !== pair.secret) continue;
        for (const peer of h.roster) {
          if (peer.deviceId !== myId) return true;
        }
      }
      return false;
    };

    const renderDevices = () => {
      const pairs = listPairsDeduped();
      devicesCount.textContent = pairs.length ? `· ${pairs.length}` : "";
      // Reflect device-cap state on the Add button.
      const atCap = pairs.length >= 3;
      devicesAddBtn.disabled = atCap;
      devicesAddBtn.classList.toggle("opacity-40", atCap);
      devicesAddBtn.classList.toggle("cursor-not-allowed", atCap);
      devicesAddBtn.title = atCap ? "Maximum 3 paired devices. Remove one to add another." : "";
      devicesList.innerHTML = "";
      if (pairs.length === 0) {
        const empty = document.createElement("li");
        empty.className = "text-xs text-[var(--color-fg-subtle)] italic";
        empty.textContent = "No devices paired yet.";
        devicesList.appendChild(empty);
        return;
      }
      for (const p of pairs) {
        const li = document.createElement("li");
        li.className = "flex items-center gap-3 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-3";
        const dot = document.createElement("span");
        const isActive = activePair?.secret === p.secret;
        const isOnline = isPairOnline(p);
        // Three states:
        //   - green (connected NOW — actively transferring)
        //   - blue/online (visible in lobby, ready for invite)
        //   - grey (offline — no lobby presence)
        // Falls through priority: active wins over online wins over offline.
        const dotColor = isActive
          ? "bg-[var(--color-success)]"
          : isOnline
          ? "bg-[var(--color-online,#3b82f6)]"
          : "bg-[var(--color-fg-subtle)]";
        dot.className = `size-2.5 rounded-full shrink-0 ${dotColor}`;
        dot.title = isActive ? "Connected now" : isOnline ? "Online — ready for invite" : "Offline";
        dot.dataset.field = "presence";
        li.appendChild(dot);
        const label = document.createElement("span");
        label.className = "flex-1 text-sm font-medium truncate";
        const suffix = isActive ? " · connected" : isOnline ? " · online" : "";
        label.textContent = p.nickname + suffix;
        li.appendChild(label);
        const meta = document.createElement("span");
        meta.className = "text-xs text-[var(--color-fg-subtle)]";
        meta.textContent = `Added ${new Date(p.addedAt).toLocaleDateString()}`;
        li.appendChild(meta);
        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className = "text-xs text-[var(--color-fg-subtle)] hover:text-[var(--color-danger)] px-2 py-1";
        removeBtn.textContent = "Remove";
        removeBtn.onclick = () => {
          if (confirm(`Remove "${p.nickname}" from paired devices?`)) {
            removePair(p.secret);
            renderDevices();
          }
        };
        li.appendChild(removeBtn);
        devicesList.appendChild(li);
      }
    };

    devicesAutoAccept.checked = getAutoAccept();
    devicesAutoAccept.onchange = () => setAutoAccept(devicesAutoAccept.checked);

    const MAX_PAIRED_DEVICES = 3;
    let pendingPairSecret = "";
    devicesAddBtn.onclick = async () => {
      if (listPairsDeduped().length >= MAX_PAIRED_DEVICES) {
        addWarning(`You can pair at most ${MAX_PAIRED_DEVICES} devices. Remove one before adding another.`);
        return;
      }
      pendingPairSecret = generatePairSecret();
      const myName = (localStorage.getItem("p2pds:name") || "").trim();
      const url = buildPairUrl(location.origin, import.meta.env.BASE_URL, pendingPairSecret, myName);
      devicesPairUrl.value = url;
      devicesAddPanel.classList.remove("hidden");
      devicesAddName.value = "";
      devicesAddName.focus();
      devicesPairQr.innerHTML = "";
      try {
        const canvas = document.createElement("canvas");
        await QRCode.toCanvas(canvas, url, {
          width: 220, margin: 1, errorCorrectionLevel: "M",
          color: { dark: "#000000", light: "#ffffff" },
        });
        devicesPairQr.appendChild(canvas);
      } catch (e) {
        addWarning(`QR generation failed: ${(e as Error).message}`);
      }
    };

    devicesPairCopy.onclick = async () => {
      try {
        await navigator.clipboard.writeText(devicesPairUrl.value);
        const orig = devicesPairCopy.textContent;
        devicesPairCopy.textContent = "Copied ✓";
        setTimeout(() => { devicesPairCopy.textContent = orig; }, 1500);
      } catch {
        devicesPairUrl.select();
        document.execCommand("copy");
      }
    };

    devicesAddDone.onclick = () => {
      // Save the secret locally even if the other side hasn't opened the URL yet.
      // The pair is one-sided until the other device opens it — but storing here
      // means auto-host will start looking for it immediately.
      if (pendingPairSecret) {
        const customName = devicesAddName.value.trim();
        const myName = (localStorage.getItem("p2pds:name") || "").trim();
        const label = customName
          || (myName ? `${myName}'s other device` : "Other device");
        upsertPair(pendingPairSecret, label, true);
      }
      pendingPairSecret = "";
      devicesAddPanel.classList.add("hidden");
      renderDevices();
      // Inviter side: now that a pair exists locally, reveal the mode toggle
      // and default to paired mode (matches the acceptor-side behaviour).
      connectMode = "paired";
      updateConnectModeUI();
      refreshModeToggle();
    };

    // ---------- Incoming pair (URL fragment) ----------
    if (incomingPair) {
      // Strip the fragment IMMEDIATELY so a refresh doesn't re-pair and the
      // secret doesn't linger in window.location during the session.
      history.replaceState({}, "", `${location.pathname}${location.search}`);
      pairIncoming.classList.remove("hidden");
      if (incomingPair.nickname) {
        pairIncomingDetail.textContent = `"${incomingPair.nickname}" wants to pair with this device for auto-connect.`;
      }
      pairIncomingName.value = "";
      pairIncomingAccept.onclick = () => {
        if (listPairsDeduped().length >= MAX_PAIRED_DEVICES) {
          addWarning(`You can pair at most ${MAX_PAIRED_DEVICES} devices. Remove one before pairing this one.`);
          return;
        }
        const label = pairIncomingName.value.trim() || incomingPair.nickname || "Other device";
        upsertPair(incomingPair.secret, label, false);
        pairIncoming.classList.add("hidden");
        renderDevices();
        // Now that a pair exists, default to paired mode and reveal the toggle
        // so the user understands they can switch between paired vs link flows.
        connectMode = "paired";
        updateConnectModeUI();
        refreshModeToggle();
      };
      pairIncomingCancel.onclick = () => {
        pairIncoming.classList.add("hidden");
      };
    }

    renderDevices();


    // Web Share Target: files were POSTed via SW, retrieve them from cache
    /** Show/hide the paired-vs-stranger mode toggle based on whether we have pairs. */
    const refreshModeToggle = () => {
      const banner = document.getElementById("role-paired-banner");
      const bannerName = document.getElementById("role-paired-banner-name");
      if (!banner) return;
      const pairs = listPairsDeduped();
      if (pairs.length > 0) {
        if (bannerName) bannerName.textContent = pairs[0].nickname;
        banner.classList.remove("hidden");
      } else {
        banner.classList.add("hidden");
      }
    };

    if (sharedFlag) {
      // Strip the query string so a reload doesn't re-trigger
      history.replaceState({}, "", `${location.pathname}`);
      (async () => {
        try {
          const res = await fetch("/__shared__");
          if (!res.ok) return;
          const form = await res.formData();
          const files = form.getAll("files").filter((f): f is File => f instanceof File);
          if (files.length === 0) return;
          // Auto-pick sender role and queue the shared files
          role = "sender";
          rolePicker.classList.add("hidden");
          bootRole();
          // bootRole runs async (bootAutoSender) — wait a tick then enqueue
          setTimeout(() => {
            const dt = new DataTransfer();
            for (const f of files) dt.items.add(f);
            onPickFiles(dt.files);
          }, 50);
        } catch (e) {
          addWarning(`Could not load shared files: ${(e as Error).message}`);
        }
      })();
    } else if (presetRoom) {
      // Auto-detect: someone gave us an invite link → we're the receiver.
      role = "receiver";
      bootRole();
    } else if (listPairs().length > 0 && !incomingPair) {
      // Paired-device flow with EXPLICIT role choice — show the role picker
      // even though we have paired devices.
      refreshModeToggle();
      rolePicker.classList.remove("hidden");
    } else {
      rolePicker.classList.remove("hidden");
    }

    // If we have an incoming pair (URL fragment), the pair-incoming card
    // is showing inside role-picker; make sure the mode toggle appears
    // immediately so the user understands paired vs link mode.
    refreshModeToggle();

    roleSendBtn.onclick = () => {
      role = "sender";
      rolePicker.classList.add("hidden");
      // Paired fast-path only when (a) we have a paired device, (b) user hasn't
      // explicitly switched to "Someone else (link)" mode, and (c) not paranoid.
      const pairs = listPairs();
      if (pairs.length > 0 && connectMode === "paired" && !paranoidToggle.checked) {
        // Force a name prompt on first paired use — otherwise everyone
        // shows up in their peer's roster as "iPhone" / "Mac" / etc.
        // and there's no way to tell two devices apart.
        if (!hasCustomNickname()) {
          const ok = promptForDeviceName(
            "Before connecting, give this device a name so your other devices can recognize it.",
          );
          if (!ok) {
            rolePicker.classList.remove("hidden");
            return;
          }
        }
        bootLobby(pairs[0], "sender").catch((e) => {
          addWarning(`Pair connect failed: ${(e as Error).message}`);
          rolePicker.classList.remove("hidden");
        });
        return;
      }
      bootRole();
    };
    roleRecvBtn.onclick = () => {
      // Mark role immediately so paranoid toggle works while the user
      // is still on the "paste invite link" sub-step.
      role = "receiver";
      statusRole.textContent = "Receiver";
      refreshIdentityLabels();
      // If paranoid is already on, jump straight into the paranoid flow.
      if (paranoidToggle.checked) {
        rolePicker.classList.add("hidden");
        bootRole();
        return;
      }
      // Paired-device fast path — only when user hasn't switched to stranger mode.
      const pairs = listPairs();
      if (pairs.length > 0 && connectMode === "paired") {
        // Force a name prompt on first paired use (see send path above).
        if (!hasCustomNickname()) {
          const ok = promptForDeviceName(
            "Before going online, give this device a name so the sender can recognize it.",
          );
          if (!ok) {
            return;
          }
        }
        rolePicker.classList.add("hidden");
        bootLobby(pairs[0], "receiver").catch((e) => {
          addWarning(`Pair connect failed: ${(e as Error).message}`);
          rolePicker.classList.remove("hidden");
        });
        return;
      }
      // Reveal the "paste link" input. We don't actually boot until the
      // user clicks Join (or switches to paranoid mode).
      roleReceiveInput.classList.remove("hidden");
      // Focus the 4-char pairing code input — most cross-device receive
      // flows are "sender reads me their 4-char code" (in person / on
      // a call), NOT "sender shares a link I paste here." Link-paste
      // remains one tab away and is still the right move for messaging-
      // app-shared invites. claimCodeBoxes is defined later in this
      // module but is safe to reference inside this handler because the
      // handler fires at user-event time, long after script init.
      // setTimeout(0) guarantees focus happens AFTER the .hidden class
      // is removed by the browser (otherwise iOS Safari ignores focus
      // on still-display:none elements).
      setTimeout(() => {
        if (claimCodeBoxes[0]) {
          claimCodeBoxes[0].focus();
        } else {
          roleReceiveLink.focus();
        }
      }, 0);
    };

    // ---------- Connect-mode toggle (paired vs stranger) ----------
    // Default to "paired" if user has any pairs — they almost always want
    // their paired-device flow. Falls back to stranger for fresh installs.
    let connectMode: "paired" | "stranger" = listPairs().length > 0 ? "paired" : "stranger";
    const cmPaired = document.getElementById("connect-mode-paired");
    const cmStranger = document.getElementById("connect-mode-stranger");
    const updateConnectModeUI = () => {
      if (!cmPaired || !cmStranger) return;
      const activeCls = "font-medium bg-[var(--color-bg-muted)] text-[var(--color-fg)]";
      const inactiveCls = "text-[var(--color-fg-muted)] hover:text-[var(--color-fg)]";
      cmPaired.className = `flex-1 rounded px-3 py-1.5 ${connectMode === "paired" ? activeCls : inactiveCls}`;
      cmStranger.className = `flex-1 rounded px-3 py-1.5 ${connectMode === "stranger" ? activeCls : inactiveCls}`;
      // Update the help text + role-button descriptions based on mode.
      const help = document.getElementById("connect-mode-help");
      if (help) {
        help.innerHTML = connectMode === "paired"
          ? "Pick <strong>Send</strong> on one device and <strong>Receive</strong> on the other — they'll auto-connect. No link needed."
          : "Generate or paste a one-time invite link — for sending files to someone who isn't on your paired devices.";
      }
      const sendDesc = document.querySelector("#role-send p");
      const recvDesc = document.querySelector("#role-receive p");
      if (sendDesc && recvDesc) {
        if (connectMode === "paired") {
          sendDesc.textContent = "Send files to my paired device — they'll connect automatically.";
          recvDesc.textContent = "Receive files from my paired device — they'll connect automatically.";
        } else {
          sendDesc.textContent = "I have files to share. Give me a link to send to someone.";
          recvDesc.textContent = "Someone sent me an invite link to paste.";
        }
      }
    };
    if (cmPaired) cmPaired.onclick = () => { connectMode = "paired"; updateConnectModeUI(); };
    if (cmStranger) cmStranger.onclick = () => { connectMode = "stranger"; updateConnectModeUI(); };
    updateConnectModeUI();

    /** Extract a room ID from a pasted invite link OR a bare ID. */
    const extractRoomId = (input: string): string | null => {
      const v = input.trim();
      if (!v) return null;
      // Try parsing as URL first.
      try {
        const u = new URL(v);
        const fromQuery = u.searchParams.get("r");
        if (fromQuery) return fromQuery;
        const fromHash = u.hash.replace(/^#/, "");
        if (fromHash) return fromHash;
      } catch {
        /* not a URL — fall through to bare-ID handling */
      }
      // Accept a bare room ID (12 hex chars per generateRoomId).
      if (/^[\w-]{4,128}$/.test(v)) return v;
      return null;
    };

    const updateJoinBtn = () => {
      roleReceiveGo.disabled = extractRoomId(roleReceiveLink.value) === null;
    };
    roleReceiveLink.addEventListener("input", updateJoinBtn);
    roleReceiveLink.addEventListener("paste", () => setTimeout(updateJoinBtn, 0));
    roleReceiveLink.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        roleReceiveGo.click();
      }
    });

    roleReceiveGo.onclick = () => {
      const room = extractRoomId(roleReceiveLink.value);
      if (!room) {
        addWarning("Couldn't read a room ID from that. Paste the full link or just the room ID after ?r=");
        return;
      }
      role = "receiver";
      rolePicker.classList.add("hidden");
      // Inject as URL param so re-bootRole picks it up cleanly.
      const u = new URL(location.href);
      u.searchParams.set("r", room);
      history.replaceState(null, "", u.toString());
      bootRole();
    };

    // ─── Receiver-side short-code claim ───────────────────────────────
    // 4 inputs, autoadvance on type, autoback on backspace, paste-aware
    // (pasting a 4-char string distributes across all boxes).
    //
    // On successful claim → set ?r=<roomId> and call bootRole() — same code
    // path the link/QR flow uses, so resume/chat/transfer all "just work".
    const claimCodeBoxes = Array.from(
      document.querySelectorAll<HTMLInputElement>(".claim-code-box"),
    );
    const claimCodeSubmit = $<HTMLButtonElement>("claim-code-submit");
    const claimCodeStatus = $("claim-code-status");

    const claimCodeChars = (): string =>
      claimCodeBoxes.map((b) => b.value).join("").toUpperCase();

    const claimCodeIsFull = (): boolean =>
      claimCodeBoxes.every((b) => b.value.length === 1);

    const updateClaimSubmit = () => {
      claimCodeSubmit.disabled = !claimCodeIsFull();
    };

    const clearClaimCode = () => {
      for (const b of claimCodeBoxes) b.value = "";
      updateClaimSubmit();
      claimCodeBoxes[0]?.focus();
    };

    const distributePastedCode = (text: string) => {
      // Strip whitespace + dashes (users often paste "H7K2" or "H7-K2"),
      // uppercase, then fan out across boxes.
      const cleaned = text.replace(/[^0-9A-Za-z]/g, "").toUpperCase();
      const chars = cleaned.slice(0, claimCodeBoxes.length).split("");
      for (let i = 0; i < claimCodeBoxes.length; i++) {
        claimCodeBoxes[i].value = chars[i] ?? "";
      }
      updateClaimSubmit();
      // Focus last filled box (or last box if full).
      const lastFilled = Math.min(chars.length, claimCodeBoxes.length) - 1;
      const focusIdx = Math.max(0, Math.min(lastFilled + 1, claimCodeBoxes.length - 1));
      claimCodeBoxes[focusIdx]?.focus();
      claimCodeBoxes[focusIdx]?.select();
      if (claimCodeIsFull()) {
        // Auto-submit on full paste — saves a click in the happy path.
        void doClaim();
      }
    };

    claimCodeBoxes.forEach((box, idx) => {
      box.addEventListener("input", () => {
        // Sanitise to a single uppercase alphanum char.
        const raw = box.value.replace(/[^0-9A-Za-z]/g, "").toUpperCase();
        box.value = raw.slice(0, 1);
        if (box.value && idx < claimCodeBoxes.length - 1) {
          claimCodeBoxes[idx + 1].focus();
        }
        updateClaimSubmit();
        if (claimCodeIsFull()) {
          // Auto-submit on the 4th character — no Connect click needed.
          void doClaim();
        }
      });

      box.addEventListener("keydown", (e) => {
        if (e.key === "Backspace" && !box.value && idx > 0) {
          claimCodeBoxes[idx - 1].focus();
          claimCodeBoxes[idx - 1].value = "";
          updateClaimSubmit();
        } else if (e.key === "ArrowLeft" && idx > 0) {
          claimCodeBoxes[idx - 1].focus();
        } else if (e.key === "ArrowRight" && idx < claimCodeBoxes.length - 1) {
          claimCodeBoxes[idx + 1].focus();
        } else if (e.key === "Enter" && claimCodeIsFull()) {
          e.preventDefault();
          void doClaim();
        }
      });

      box.addEventListener("paste", (e) => {
        const pasted = e.clipboardData?.getData("text") ?? "";
        if (pasted.length > 1) {
          e.preventDefault();
          distributePastedCode(pasted);
        }
      });

      box.addEventListener("focus", () => box.select());
    });

    const doClaim = async () => {
      if (!claimCodeIsFull()) return;
      const code = claimCodeChars();
      claimCodeSubmit.disabled = true;
      claimCodeStatus.textContent = "connecting…";

      const result = await claimCode(site.signalingUrl, code);

      if (result.roomId) {
        claimCodeStatus.textContent = "matched ✓";
        role = "receiver";
        rolePicker.classList.add("hidden");
        const u = new URL(location.href);
        u.searchParams.set("r", result.roomId);
        history.replaceState(null, "", u.toString());
        bootRole();
        return;
      }

      // Map error to user-facing copy.
      const msg = result.error === "expired"
        ? "Code expired — ask the sender for a new one."
        : result.error === "claimed"
        ? "Code already used — ask the sender for a new one."
        : result.error === "network"
        ? "Couldn't reach the server. Try again."
        : "No active session for that code. Double-check and retry.";
      claimCodeStatus.textContent = "";
      addWarning(msg);
      clearClaimCode();
    };

    claimCodeSubmit.onclick = () => void doClaim();

    roleReceiveParanoid.onclick = () => {
      role = "receiver";
      paranoidToggle.checked = true;
      rolePicker.classList.add("hidden");
      bootRole();
    };

    // ---------- QR scan flow (receiver side, non-paranoid) ----------
    // The Scan button opens a modal with a live camera feed. When a QR is
    // decoded we run it through the same extractRoomId() the paste/Join
    // flow uses, so any QR encoding a transfer URL OR a bare room ID works.
    let qrScannerController: ScannerController | null = null;

    const setScanStatus = (msg: string | null) => {
      if (!msg) {
        qrScanStatus.classList.add("hidden");
        qrScanStatus.textContent = "";
        return;
      }
      qrScanStatus.textContent = msg;
      qrScanStatus.classList.remove("hidden");
    };

    const closeQrScanner = () => {
      qrScannerController?.stop();
      qrScannerController = null;
      qrScanModal.classList.add("hidden");
      setScanStatus(null);
    };

    const openQrScanner = async () => {
      qrScanModal.classList.remove("hidden");
      setScanStatus("Starting camera…");
      try {
        const controller = await startQrScanner({
          video: qrScanVideo,
          onResult: (text) => {
            const room = extractRoomId(text);
            if (!room) {
              // Decoded something, but it wasn't a valid invite. Show a hint
              // and reopen so the user can try another QR.
              const wasOpen = !qrScanModal.classList.contains("hidden");
              closeQrScanner();
              if (wasOpen) {
                setTimeout(() => {
                  qrScanModal.classList.remove("hidden");
                  setScanStatus("That QR doesn't look like a transfer invite. Try the sender's QR again.");
                  setTimeout(openQrScanner, 1800);
                }, 0);
              }
              return;
            }
            // Got a valid room — close the scanner, populate the input, and
            // press Join programmatically. Reuses the same code path as the
            // manual paste flow, so we don't fork the join logic.
            closeQrScanner();
            roleReceiveLink.value = text;
            roleReceiveGo.disabled = false;
            roleReceiveGo.click();
          },
          onError: (msg) => {
            // Set status; do NOT clear it after the await — that race was
            // wiping legitimate camera errors (caught by Browserbase smoke
            // test which has no camera).
            setScanStatus(msg);
          },
        });
        qrScannerController = controller;
        // Only clear "Starting camera…" if no error was raised. Calling
        // setScanStatus(null) unconditionally here erased onError messages.
        if (qrScanStatus.textContent === "Starting camera…") {
          setScanStatus(null);
        }
      } catch (err) {
        // Defensive — startQrScanner already handles its own errors via
        // onError, but a synchronous throw before that would land here.
        setScanStatus(`Couldn't open the camera: ${(err as Error)?.message ?? "unknown error"}`);
      }
    };

    roleReceiveScan.onclick = openQrScanner;
    qrScanClose.onclick = closeQrScanner;
    // Click on the dim backdrop (outside the dialog box) → close.
    qrScanModal.addEventListener("click", (e) => {
      if (e.target === qrScanModal) closeQrScanner();
    });
    // Escape to close — standard modal UX.
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !qrScanModal.classList.contains("hidden")) {
        closeQrScanner();
      }
    });

    // Retry handlers (sender side, after a connection failure)
    retryBtn.onclick = () => {
      // Same role, same mode — just rebuild from scratch with a fresh room.
      // showOnly("booting") clears EVERY panel atomically — fixes the bug
      // where role-picker + lobby + sender-link + retry would all stay
      // visible at once after clicking Try again.
      showOnly("booting");
      autoReconnectAttempted = false;
      bootRole();
    };
    retryParanoidBtn.onclick = () => {
      showOnly("booting");
      paranoidToggle.checked = true;
      bootRole();
    };

    paranoidToggle.addEventListener("change", () => {
      if (role) {
        // Tell the peer we're switching modes so they don't wait ~15s
        // for the data channel to time out. Best-effort — if there's
        // no live session yet, this is a no-op.
        try { session?.sendBye("role-switch"); } catch { /* */ }
        showOnly("booting");
        bootRole();
      }
    });

    // ---------- Misc ----------
    const canShare = typeof navigator !== "undefined" && typeof navigator.share === "function";
    async function tryShare(btn: HTMLButtonElement, data: ShareData, fallbackText: string, restoreLabel: string) {
      try {
        await navigator.share(data);
        btn.textContent = "Shared!";
      } catch (err: any) {
        if (err && err.name === "AbortError") return; // user cancelled
        // fallback to clipboard
        try { await navigator.clipboard.writeText(fallbackText); btn.textContent = "Copied!"; } catch { return; }
      }
      setTimeout(() => (btn.textContent = restoreLabel), 1500);
    }
    if (canShare) {
      shareLinkBtn.classList.remove("hidden");
      senderShareOffer.classList.remove("hidden");
      recvShareAnswer.classList.remove("hidden");
    }
    shareLinkBtn.addEventListener("click", () =>
      tryShare(shareLinkBtn, { title: "FileTransferNow invite", text: "Join my secure file transfer:", url: shareLink.value }, shareLink.value, "Share")
    );
    senderShareOffer.addEventListener("click", () =>
      tryShare(senderShareOffer, { title: "FileTransferNow invite code", text: senderOfferBlob.value }, senderOfferBlob.value, "Share")
    );
    recvShareAnswer.addEventListener("click", () =>
      tryShare(recvShareAnswer, { title: "FileTransferNow reply code", text: recvAnswerBlob.value }, recvAnswerBlob.value, "Share")
    );
    copyLinkBtn.addEventListener("click", async () => {
      await navigator.clipboard.writeText(shareLink.value);
      copyLinkBtn.textContent = "Copied!";
      setTimeout(() => (copyLinkBtn.textContent = "Copy"), 1500);
    });
    senderCopyOffer.addEventListener("click", async () => {
      await navigator.clipboard.writeText(senderOfferBlob.value);
      senderCopyOffer.textContent = "Copied!";
      setTimeout(() => (senderCopyOffer.textContent = "Copy invite code"), 1500);
    });
    recvCopyAnswer.addEventListener("click", async () => {
      await navigator.clipboard.writeText(recvAnswerBlob.value);
      recvCopyAnswer.textContent = "Copied!";
      setTimeout(() => (recvCopyAnswer.textContent = "Copy reply code"), 1500);
    });

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") {
        // Page came back from background — wake the signaling socket
        // if it got killed by iOS/Android while we were away.
        session?.resumeIfStale();
      } else if (activeSendRow) {
        addWarning("Tab moved to background — transfer may slow until you return.");
      }
    });

    // ---------- Network-change auto-recovery (commit 2/3) ----------
    // When the OS swaps Wi-Fi ↔ cellular (or any other connectivity change),
    // the underlying UDP socket the WebRTC peer is using dies. WebRTC's
    // built-in fix is ICE restart: re-gather candidates over the new path
    // while the data channel stays alive on the same RTCPeerConnection.
    //
    // We have three triggers (defense in depth, gated by a 5s cooldown):
    //   1. window.online       — fastest signal, fires before PC notices
    //   2. navigator.connection.change (Chromium) — wifi→cellular handoffs
    //      where both endpoints stay "online"
    //   3. peer state === "disconnected" (2s grace) — safety net if the
    //      OS signals miss
    //
    // Sender-only — receiver auto-handles the renegotiated offer via the
    // existing ws.onmessage "offer" branch. restartIce() itself is a
    // no-op for receivers and paranoid sessions, but we still gate at
    // the call site to avoid noise in the logs / banners.
    let lastIceRestartAt = 0;
    const ICE_RESTART_COOLDOWN_MS = 5_000;
    const maybeRestartIce = (reason: string) => {
      if (!session) return;
      if (session.currentRole !== "sender") return;
      if (!isChannelLive()) return;
      const now = Date.now();
      if (now - lastIceRestartAt < ICE_RESTART_COOLDOWN_MS) return;
      lastIceRestartAt = now;
      addInfo(`Network change detected (${reason}) — reconnecting…`);
      void session.restartIce();
    };

    window.addEventListener("online", () => maybeRestartIce("online"));
    window.addEventListener("offline", () => {
      if (isChannelLive()) {
        addWarning("You're offline. Will reconnect when network returns.");
      }
    });

    // Chromium / Android — fires on type changes (wifi → 4g) even when
    // both endpoints stay "online" (e.g. mobile handoff between APs).
    // No-op on Safari / Firefox — navigator.connection is unavailable.
    const netConn = (navigator as Navigator & {
      connection?: { effectiveType?: string; addEventListener?: (k: string, h: () => void) => void };
    }).connection;
    if (netConn && typeof netConn.addEventListener === "function") {
      netConn.addEventListener("change", () =>
        maybeRestartIce(`type=${netConn.effectiveType ?? "?"}`),
      );
    }

    // ---------- Background-pause banner (layer 2) ----------
    // Tracks tab visibility: if the tab was hidden for >2s while a transfer
    // was active, show a "welcome back" banner on return explaining the
    // possible slowdown. The Notification API side (desktop toast while
    // backgrounded) is handled in src/lib/backgroundWarning.ts.
    const bgPauseBanner = document.getElementById("bg-pause-banner") as HTMLDivElement;
    const bgPauseClose = document.getElementById("bg-pause-banner-close") as HTMLButtonElement;
    let bgHiddenAt = 0;
    let bgBannerHideTimer: number | null = null;
    const hideBgBanner = () => {
      bgPauseBanner.classList.add("hidden");
      if (bgBannerHideTimer !== null) {
        clearTimeout(bgBannerHideTimer);
        bgBannerHideTimer = null;
      }
    };
    bgPauseClose.addEventListener("click", hideBgBanner);
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") {
        bgHiddenAt = Date.now();
        return;
      }
      // Visible again — show banner only if (a) a transfer is in flight,
      // (b) the tab was hidden for >2s (skip incidental focus blips).
      const hiddenFor = bgHiddenAt > 0 ? Date.now() - bgHiddenAt : 0;
      bgHiddenAt = 0;
      const transferInFlight = activeSendRow !== null || activeRecvRow !== null;
      if (hiddenFor > 2000 && transferInFlight) {
        bgPauseBanner.classList.remove("hidden");
        if (bgBannerHideTimer !== null) clearTimeout(bgBannerHideTimer);
        bgBannerHideTimer = window.setTimeout(hideBgBanner, 8000);
      }
      // Also clear any stale desktop notification once the user is back.
      clearBackgroundNotification();
    });

    // ---------- Keyboard shortcut help overlay ----------
    const kbdOverlay = document.getElementById("kbd-overlay") as HTMLDivElement;
    const kbdOverlayClose = document.getElementById("kbd-overlay-close") as HTMLButtonElement;
    const helpToggleBtn = document.getElementById("help-toggle") as HTMLButtonElement | null;
    const showKbdHelp = () => kbdOverlay.classList.remove("hidden");
    const hideKbdHelp = () => kbdOverlay.classList.add("hidden");
    kbdOverlayClose.addEventListener("click", hideKbdHelp);
    helpToggleBtn?.addEventListener("click", () => {
      if (kbdOverlay.classList.contains("hidden")) showKbdHelp();
      else hideKbdHelp();
    });
    kbdOverlay.addEventListener("click", (e) => {
      if (e.target === kbdOverlay) hideKbdHelp();
    });
    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement | null;
      const tag = t?.tagName;
      const inField = tag === "INPUT" || tag === "TEXTAREA" || t?.isContentEditable;
      if (e.key === "Escape" && !kbdOverlay.classList.contains("hidden")) {
        hideKbdHelp();
        e.preventDefault();
        return;
      }
      if (inField) return;
      if (e.key === "?") {
        e.preventDefault();
        if (kbdOverlay.classList.contains("hidden")) showKbdHelp();
        else hideKbdHelp();
      }
    });

    // ---------- Manual disconnect ----------
    const discBtn = document.getElementById("manual-disconnect") as HTMLButtonElement | null;

    /**
     * Best-effort "leave the lobby cleanly" handler for tab close/refresh.
     *
     * Why both events: `pagehide` fires reliably on mobile browsers
     * (especially iOS Safari) where `beforeunload` is unreliable —
     * Safari treats `beforeunload` as a discouraged "stay on page"
     * prompt. `pagehide` is the modern way.
     *
     * Why best-effort: WebSocket.send() during page-unload is allowed
     * but the OS may drop the frame if it doesn't make it onto the
     * wire before the process is reaped. Acceptable — even if dropped,
     * the LobbyDO's WS-close detection will eventually fire (~10-30s)
     * and stale peers will fall off the roster. This handler just
     * shrinks that gap to instant when it works.
     *
     * Also tears down session.destroy() for the same reason —
     * RTCPeerConnection.close() sends a goodbye DTLS alert that's
     * helpful for the peer's RTCPC.onconnectionstatechange.
     */
    const cleanupOnUnload = () => {
      // Best-effort bye frame BEFORE destroy(). On tab close the OS may
      // drop the frame mid-send (process reaped before SCTP flushes),
      // but on refresh / navigation it usually makes it out — giving the
      // peer an instant "they left" event instead of waiting for ICE
      // timeout to fire ~15s later.
      try { session?.sendBye("disconnect"); } catch { /* */ }
      try { markIdle(); } catch { /* */ }
      try { session?.destroy(); } catch { /* */ }
    };
    window.addEventListener("pagehide", cleanupOnUnload);
    window.addEventListener("beforeunload", cleanupOnUnload);

    discBtn?.addEventListener("click", () => {
      if (!confirm("Disconnect from this peer? You'll need to reconnect manually (or auto-reconnect if paired).")) return;
      // Tell the peer FIRST (before destroy() closes the channel) so
      // their UI flips to "Lappy disconnected" instantly instead of
      // waiting ~15s for ICE timeout to surface a vague error.
      try { session?.sendBye("disconnect"); } catch { /* */ }
      try { session?.destroy(); } catch {}
      session = null;
      role = null;
      activePair = null;
      // Tell our paired peers we're idle again — without this, the other
      // side's roster keeps us pinned in "sending"/"receiving" state
      // until their next ping or our roster broadcast catches up.
      markIdle();
      // Hide UI bits that don't make sense post-disconnect.
      discBtn.classList.add("hidden");
      const badge = document.getElementById("chat-trusted-badge");
      if (badge) badge.classList.add("hidden");
      // Stop the uptime ticker + reset chat input state.
      setStatus("disconnected", "You disconnected manually. Refresh the page to reconnect.");
      chatInput.disabled = true;
      chatInput.placeholder = "Disconnected — refresh to reconnect";
      chatSend.disabled = true;
      renderDevices();
      addWarning("Disconnected. Refresh the page (or close the tab) to reset.");
    });

    // Theme toggle now lives in <Nav /> (src/components/Nav.astro) — global
    // for the whole site. Removed the duplicate /transfer-page-only button
    // + handler to prevent two toggles racing on the same theme state.

    // ── Document Picture-in-Picture toggle ─────────────────────────────
    // Feature-detected at boot. On unsupported browsers (Firefox, Safari,
    // mobile), the button stays hidden — silent degradation, no broken
    // UI ever. On Chromium 116+ desktop, button is unhidden and click
    // pops the entire <main> into a floating window.
    //
    // The DOM move is one-shot — the same JS event listeners, WebRTC
    // handles, file refs, MediaStream refs, and module-scope closures
    // keep working because we MOVE nodes (don't clone). On close, they
    // come straight back into <main>.
    const pipBtn = document.getElementById("pip-toggle") as HTMLButtonElement | null;
    const pipIconOpen = document.getElementById("pip-icon-open");
    const pipIconClose = document.getElementById("pip-icon-close");
    const pipPlaceholder = document.getElementById("pip-placeholder");
    const pipPlaceholderBringBack = document.getElementById("pip-placeholder-bring-back");
    const pipMainEl = document.querySelector("main") as HTMLElement | null;

    if (pipBtn && pipIconOpen && pipIconClose && pipPlaceholder && pipMainEl && isPipSupported()) {
      pipBtn.classList.remove("hidden");

      const setPipUi = (open: boolean) => {
        if (open) {
          pipIconOpen.classList.add("hidden");
          pipIconClose.classList.remove("hidden");
          pipBtn.setAttribute("aria-label", "Bring back to this tab");
          pipBtn.setAttribute("title", "Bring back to this tab");
        } else {
          pipIconOpen.classList.remove("hidden");
          pipIconClose.classList.add("hidden");
          pipBtn.setAttribute("aria-label", "Pop out into floating window");
          pipBtn.setAttribute("title", "Pop out into floating window");
        }
      };

      // Teardown for the file-intake listeners bound onto the PiP document.
      // Held at toggle scope so the onClose callback (fired by pipWindow.ts on
      // pagehide/unload/safety-net) can detach them. Null when not floating.
      let pipIntakeTeardown: (() => void) | null = null;

      const togglePip = async () => {
        if (isPipOpen()) {
          closePip();
          // pagehide handler in pipWindow.ts runs onClose → setPipUi(false)
          return;
        }
        const handle = await openPip({
          sourceEl: pipMainEl,
          placeholderEl: pipPlaceholder,
          width: 400,
          height: 640,
          onClose: () => {
            // Detach the PiP-document intake listeners. The PiP document is
            // being destroyed anyway, but explicit teardown keeps rapid
            // pop-out/pop-in toggling from leaking listeners or desyncing the
            // per-document dragDepth counter.
            try {
              pipIntakeTeardown?.();
            } catch (err) {
              console.warn("[pip] file-intake teardown threw:", err);
            }
            pipIntakeTeardown = null;
            setPipUi(false);
          },
          pipTitle: `📺 ${document.title}`,
        });
        if (!handle) {
          addWarning(
            "Your browser blocked the floating window. Allow pop-ups for this site and try again.",
          );
          return;
        }
        // Re-bind drag/drop/paste onto the PiP window's document. Without this,
        // dropping a file on the float navigates the PiP window to that file
        // (browser default action) instead of queueing it — the drop zone got
        // reparented into a document that has none of the main page's intake
        // listeners. See wireFileIntake's header comment for the full rationale.
        if (handle.window) {
          try {
            pipIntakeTeardown = wireFileIntake(handle.window.document, handle.window);
          } catch (err) {
            console.warn("[pip] failed to wire file intake into PiP window:", err);
          }
        }
        setPipUi(true);
      };

      pipBtn.addEventListener("click", togglePip);
      // The placeholder's "Bring back" button is identical to clicking
      // the toggle while in PiP — same close path.
      pipPlaceholderBringBack?.addEventListener("click", () => {
        if (isPipOpen()) closePip();
      });

      // One-step onboarding pointer — fires 2.5s after load on first
      // visit. initPipTour() self-bails if seen, unsupported, or anchor
      // is missing/hidden, so this is safe to always call here.
      initPipTour();
    }
  </script>
</Layout>
