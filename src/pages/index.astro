---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

const features = [
  {
    title: "Zero uploads",
    body: "Files stream peer-to-peer over WebRTC data channels. Our servers route only the SDP handshake — never a single byte of your content.",
  },
  {
    title: "Unlimited size",
    body: "Send 10MB or 100GB — same flow. Data is streamed directly to the receiver's local disk via the Origin Private File System, so RAM never bloats.",
  },
  {
    title: "End-to-end encrypted",
    body: "WebRTC transports are DTLS-encrypted by default. Even if someone tapped the network path, they'd see noise.",
  },
  {
    title: "No signup, no install",
    body: "Open the page, generate a room, share the link. Receiver opens it, transfer starts. Nothing to download, no account to create.",
  },
  {
    title: "Paranoid mode",
    body: "Don't trust our signaling server? Use manual SDP exchange — copy/paste the handshake text over Signal, email, or carrier pigeon.",
  },
  {
    title: "Cross-platform",
    body: "Works on any modern Chromium, Firefox, or Safari — desktop or mobile. No app store, no installs, just a URL.",
  },
];
---

<Layout title="Send files browser-to-browser, zero cloud" description={site.description}>
  <Nav />

  <main>
    <!-- HERO -->
    <section class="border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-[1200px] px-6 md:px-12 py-20 md:py-32">
        <p class="text-sm uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">
          P2P File Transfer · WebRTC · Zero Cloud
        </p>
        <h1 class="mt-4 text-5xl md:text-7xl font-semibold tracking-tight max-w-4xl">
          Send files browser-to-browser.
          <span class="text-[var(--color-fg-muted)]">No server in the middle.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg md:text-xl text-[var(--color-fg-muted)]">
          {site.tagline} Drop any file, share a link, done. End-to-end encrypted, unlimited size, no signup.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="/transfer"
            class="inline-flex h-12 items-center rounded-lg bg-[var(--color-fg)] px-6 text-sm font-medium text-[var(--color-bg)] no-underline transition-opacity hover:opacity-90"
          >
            Launch the teleporter →
          </a>
          <a
            href="/how-it-works"
            class="inline-flex h-12 items-center rounded-lg border border-[var(--color-border)] px-6 text-sm font-medium text-[var(--color-fg)] no-underline transition-colors hover:bg-[var(--color-bg-muted)]"
          >
            How it works
          </a>
        </div>
        <div class="mt-10 flex flex-wrap gap-6 text-sm text-[var(--color-fg-muted)]">
          <span class="flex items-center gap-2">
            <span class="size-1.5 rounded-full bg-[var(--color-success)]"></span> Free forever
          </span>
          <span class="flex items-center gap-2">
            <span class="size-1.5 rounded-full bg-[var(--color-success)]"></span> No tracking
          </span>
          <span class="flex items-center gap-2">
            <span class="size-1.5 rounded-full bg-[var(--color-success)]"></span> No account
          </span>
        </div>
      </div>
    </section>

    <!-- FEATURE GRID -->
    <section class="border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-[1200px] px-6 md:px-12 py-16 md:py-24">
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight max-w-2xl">
          Built around one principle: <span class="text-[var(--color-fg-muted)]">your bytes are your business.</span>
        </h2>
        <div class="mt-12 grid gap-px bg-[var(--color-border)] sm:grid-cols-2 lg:grid-cols-3 border border-[var(--color-border)] rounded-lg overflow-hidden">
          {features.map((f) => (
            <div class="bg-[var(--color-bg)] p-6 md:p-8">
              <h3 class="text-lg font-semibold">{f.title}</h3>
              <p class="mt-2 text-[var(--color-fg-muted)] text-sm leading-relaxed">{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS TEASER -->
    <section class="border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-[1200px] px-6 md:px-12 py-16 md:py-24 grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">How it works</p>
          <h2 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">Three steps. No cloud.</h2>
          <ol class="mt-6 space-y-4 text-[var(--color-fg-muted)]">
            <li><span class="text-[var(--color-fg)] font-medium">1. Generate a room.</span> Open the app — get a one-time URL.</li>
            <li><span class="text-[var(--color-fg)] font-medium">2. Share the link.</span> Send it to the recipient any way you like.</li>
            <li><span class="text-[var(--color-fg)] font-medium">3. Drop the file.</span> Direct browser-to-browser stream begins instantly.</li>
          </ol>
          <a href="/how-it-works" class="mt-8 inline-flex h-10 items-center rounded-md border border-[var(--color-border)] px-4 text-sm font-medium text-[var(--color-fg)] no-underline transition-colors hover:bg-[var(--color-bg-muted)]">
            Read the technical deep-dive →
          </a>
        </div>
        <pre class="overflow-x-auto rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-6 text-xs leading-relaxed text-[var(--color-fg-muted)]"><code>{`// Receiver side — direct write to local disk
peerConnection.ondatachannel = (event) => {
  event.channel.onmessage = async (e) => {
    await opfsWriteHandle.write({
      type: 'write',
      data: e.data,
      position: receivedBytes,
    });
  };
};`}</code></pre>
      </div>
    </section>

    <!-- CTA -->
    <section>
      <div class="mx-auto max-w-[1200px] px-6 md:px-12 py-20 md:py-28 text-center">
        <h2 class="text-4xl md:text-6xl font-semibold tracking-tight">Stop emailing files to yourself.</h2>
        <p class="mt-5 text-lg text-[var(--color-fg-muted)] max-w-xl mx-auto">
          Open {site.shortName}. Drop a file. Share the link. Done in 10 seconds.
        </p>
        <a
          href="/transfer"
          class="mt-10 inline-flex h-12 items-center rounded-lg bg-[var(--color-fg)] px-8 text-sm font-medium text-[var(--color-bg)] no-underline transition-opacity hover:opacity-90"
        >
          Launch the teleporter →
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
