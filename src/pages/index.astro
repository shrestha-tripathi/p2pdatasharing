---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import MechanismAnimation from "../components/MechanismAnimation.astro";
import { site } from "../site.config";

// WebApplication schema — tells Google this URL is a usable web app, not
// just marketing. Eligible for software-app rich results (rating, price).
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `${site.url}/#webapp`,
  name: site.name,
  alternateName: ["P2P File Transfer", "Browser-to-browser file sharing"],
  url: site.url,
  description: site.description,
  applicationCategory: "UtilitiesApplication",
  applicationSubCategory: "FileSharing",
  operatingSystem: "Any (Chrome, Firefox, Safari, Edge)",
  browserRequirements: "Requires a modern browser with WebRTC support",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  featureList: [
    "Peer-to-peer file transfer over WebRTC",
    "End-to-end encrypted with DTLS",
    "No file size limit",
    "No signup, no install, no upload",
    "Works across any network — home, mobile, corporate",
    "Resume after disconnect",
    "Persistent device pairing",
    "QR code pairing",
  ],
  publisher: { "@id": `${site.url}/#organization` },
};

const features = [
  {
    title: "Works across any network",
    body: "Different WiFi networks, different cities, different continents — doesn't matter. WebRTC + STUN/TURN traversal connects browsers behind home routers, mobile data, and corporate firewalls. This isn't AirDrop — it's true global P2P.",
  },
  {
    title: "Zero uploads, zero servers",
    body: "Files stream directly peer-to-peer over WebRTC data channels. No file ever touches our infrastructure. Our signaling server routes only the SDP handshake — not a single byte of your content.",
  },
  {
    title: "Unlimited size",
    body: "Send 10MB or 100GB — same flow, no upload step. Data streams directly to the receiver's local disk via the Origin Private File System, so RAM never bloats.",
  },
  {
    title: "End-to-end encrypted",
    body: "WebRTC transports are DTLS-encrypted by default. Keys negotiated browser-to-browser; even we can't decrypt the stream. Anyone tapping the network sees noise.",
  },
  {
    title: "No signup, no install, no app",
    body: "Open the page, generate a room, share the link. Receiver opens it, transfer starts. Nothing to download, no account to create — just a URL.",
  },
  {
    title: "Resume after disconnect",
    body: "WiFi dropped mid-transfer? Battery died? Tab refreshed? The receiver's partial file is persisted to disk and the sender re-streams only the missing bytes — never restart a 50GB transfer from byte 0 again.",
  },
  {
    title: "Paranoid mode",
    body: "Don't trust our signaling server? Use manual SDP exchange — copy/paste the handshake text over Signal, email, or carrier pigeon. Truly zero cloud, even for the handshake.",
  },
  {
    title: "Greener by design",
    body: "No upload to a server, no storage racks spinning to hold your file 'just in case'. A typical cloud round-trip burns ~5x the energy of a direct P2P hop. Sustainable by accident — because we just skip the cloud entirely.",
  },
];
---

<Layout
  title="Send files browser-to-browser across any network — no server, no cloud"
  description={site.description}
  jsonLd={[webAppSchema]}
>
  <Nav />

  <main>
    <!-- HERO -->
    <section class="border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-[1200px] px-6 md:px-12 py-20 md:py-32">
        <p class="text-sm uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">
          P2P File Transfer · WebRTC · Across Any Network · Zero Cloud
        </p>
        <h1 class="mt-4 text-5xl md:text-7xl font-semibold tracking-tight max-w-4xl">
          {site.tagline}
          <span class="text-[var(--color-fg-muted)]"> Send files browser to browser, across any network.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg md:text-xl text-[var(--color-fg-muted)]">
          {site.description}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href={`${import.meta.env.BASE_URL}transfer`}
            class="inline-flex h-12 items-center rounded-lg bg-[var(--color-fg)] px-6 text-sm font-medium text-[var(--color-bg)] no-underline transition-opacity hover:opacity-90"
          >
            Send a file now →
          </a>
          <a
            href={`${import.meta.env.BASE_URL}how-it-works`}
            class="inline-flex h-12 items-center rounded-lg border border-[var(--color-border)] px-6 text-sm font-medium text-[var(--color-fg)] no-underline transition-colors hover:bg-[var(--color-bg-muted)]"
          >
            How it works
          </a>
        </div>
        <div class="mt-10 flex flex-wrap gap-2.5">
          <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-3.5 py-2 text-sm text-[var(--color-fg)]">
            <svg class="size-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18.178 8c5.096 0 5.096 8 0 8-5.095 0-7.133-8-12.739-8-4.585 0-4.585 8 0 8 5.606 0 7.644-8 12.74-8z"/>
            </svg>
            No file size limit
          </span>
          <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-3.5 py-2 text-sm text-[var(--color-fg)]">
            <svg class="size-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/>
            </svg>
            True peer-to-peer
          </span>
          <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-3.5 py-2 text-sm text-[var(--color-fg)]">
            <svg class="size-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
            Blazingly fast
          </span>
          <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-3.5 py-2 text-sm text-[var(--color-fg)]">
            <svg class="size-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            End-to-end encrypted
          </span>
          <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-3.5 py-2 text-sm text-[var(--color-fg)]">
            <svg class="size-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 12l2 2 4-4"/><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/>
            </svg>
            No signup, no install
          </span>
          <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-subtle)] px-3.5 py-2 text-sm text-[var(--color-fg)]">
            <svg class="size-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            Works across any network
          </span>
        </div>
      </div>
    </section>

    <!-- MECHANISM ANIMATION -->
    <section class="border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-[1200px] px-6 md:px-12 py-16 md:py-24">
        <div class="max-w-2xl">
          <p class="text-sm uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">
            The mechanism
          </p>
          <h2 class="mt-3 text-3xl md:text-5xl font-semibold tracking-tight">
            <span class="text-[var(--color-fg-muted)]">Connect.</span>{" "}
            <span class="text-[var(--color-fg-muted)]">Encrypt.</span>{" "}
            Stream straight to disk.
          </h2>
          <p class="mt-5 text-lg text-[var(--color-fg-muted)] max-w-xl">
            A signaling server briefly helps the two browsers find each other.
            From that point on, every byte flows directly between them — encrypted
            end-to-end, never touching a server, never paused for an upload step.
          </p>
        </div>
        <div class="mt-12 md:mt-16">
          <MechanismAnimation />
        </div>
      </div>
    </section>

    <!-- COMPARISON: Cloud upload vs WebFileSend -->
    <section class="border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-[1200px] px-6 md:px-12 py-16 md:py-24">
        <div class="max-w-2xl">
          <p class="text-sm uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">The difference</p>
          <h2 class="mt-3 text-3xl md:text-5xl font-semibold tracking-tight">
            WeTransfer, Smash, Dropbox.
            <span class="text-[var(--color-fg-muted)]">Then us.</span>
          </h2>
          <p class="mt-5 text-lg text-[var(--color-fg-muted)] max-w-xl">
            Cloud tools make your file take a round trip through a server — first
            upload, then download. {site.shortName} skips the round trip entirely.
          </p>
        </div>

        <div class="mt-12 grid gap-px bg-[var(--color-border)] md:grid-cols-2 border border-[var(--color-border)] rounded-lg overflow-hidden">
          <!-- BEFORE: cloud upload -->
          <div class="bg-[var(--color-bg)] p-6 md:p-10">
            <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-[var(--color-fg-subtle)] font-medium">
              <span class="size-1.5 rounded-full bg-[var(--color-fg-subtle)]"></span>
              The old way
            </div>
            <h3 class="mt-3 text-xl font-semibold">Upload, store, hope it works</h3>

            <svg viewBox="0 0 360 200" class="mt-6 w-full h-auto text-[var(--color-fg-muted)]" aria-hidden="true">
              <defs>
                <marker id="arr-old" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
                  <path d="M0,0 L8,4 L0,8 z" fill="currentColor" />
                </marker>
              </defs>
              <!-- Sender -->
              <rect x="10" y="120" width="80" height="50" rx="6" fill="none" stroke="currentColor" stroke-width="1.5"/>
              <text x="50" y="148" text-anchor="middle" font-size="11" fill="currentColor" font-weight="600">You</text>
              <!-- Cloud (huge, dominant) -->
              <ellipse cx="180" cy="50" rx="56" ry="26" fill="none" stroke="currentColor" stroke-width="1.5"/>
              <text x="180" y="48" text-anchor="middle" font-size="11" fill="currentColor" font-weight="600">Their server</text>
              <text x="180" y="62" text-anchor="middle" font-size="9" fill="currentColor" opacity="0.6">stores your file</text>
              <!-- Receiver -->
              <rect x="270" y="120" width="80" height="50" rx="6" fill="none" stroke="currentColor" stroke-width="1.5"/>
              <text x="310" y="148" text-anchor="middle" font-size="11" fill="currentColor" font-weight="600">Recipient</text>
              <!-- Upload arrow -->
              <path d="M 60 120 Q 100 80 130 65" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#arr-old)"/>
              <text x="80" y="100" font-size="10" fill="currentColor" opacity="0.7">1. upload</text>
              <!-- Download arrow -->
              <path d="M 230 65 Q 260 80 300 120" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#arr-old)"/>
              <text x="270" y="100" font-size="10" fill="currentColor" opacity="0.7">2. download</text>
              <text x="180" y="195" text-anchor="middle" font-size="9.5" fill="currentColor" opacity="0.55">File travels twice. Server sees it. Storage cap. Size limit.</text>
            </svg>

            <ul class="mt-6 space-y-2 text-sm text-[var(--color-fg-muted)]">
              <li class="flex items-start gap-2"><span class="text-[var(--color-fg-subtle)] mt-0.5">✗</span> File is uploaded to a server (then downloaded again)</li>
              <li class="flex items-start gap-2"><span class="text-[var(--color-fg-subtle)] mt-0.5">✗</span> 2GB / 5GB / 20GB size caps on the free tier</li>
              <li class="flex items-start gap-2"><span class="text-[var(--color-fg-subtle)] mt-0.5">✗</span> Server can read it, scan it, store it, lose it</li>
              <li class="flex items-start gap-2"><span class="text-[var(--color-fg-subtle)] mt-0.5">✗</span> Link expires in 3 / 7 / 30 days</li>
            </ul>
          </div>

          <!-- AFTER: direct P2P -->
          <div class="bg-[var(--color-bg)] p-6 md:p-10">
            <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-[var(--color-accent)] font-medium">
              <span class="size-1.5 rounded-full bg-[var(--color-accent)]"></span>
              With {site.shortName}
            </div>
            <h3 class="mt-3 text-xl font-semibold">Direct. End of story.</h3>

            <svg viewBox="0 0 360 200" class="mt-6 w-full h-auto" aria-hidden="true">
              <defs>
                <marker id="arr-new" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
                  <path d="M0,0 L8,4 L0,8 z" fill="var(--color-accent)" />
                </marker>
                <linearGradient id="directLine" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.6"/>
                  <stop offset="50%" stop-color="var(--color-accent)" stop-opacity="1"/>
                  <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0.6"/>
                </linearGradient>
              </defs>
              <!-- Sender -->
              <rect x="10" y="120" width="80" height="50" rx="6" fill="none" stroke="var(--color-fg)" stroke-width="1.5"/>
              <text x="50" y="148" text-anchor="middle" font-size="11" fill="var(--color-fg)" font-weight="600">You</text>
              <!-- Receiver -->
              <rect x="270" y="120" width="80" height="50" rx="6" fill="none" stroke="var(--color-fg)" stroke-width="1.5"/>
              <text x="310" y="148" text-anchor="middle" font-size="11" fill="var(--color-fg)" font-weight="600">Recipient</text>
              <!-- Direct line (curve down + straight across) -->
              <path d="M 90 145 L 270 145" fill="none" stroke="url(#directLine)" stroke-width="3" stroke-linecap="round" marker-end="url(#arr-new)"/>
              <text x="180" y="135" text-anchor="middle" font-size="11" fill="var(--color-fg)" font-weight="600">Direct, encrypted</text>
              <!-- Tiny cloud above, faded -->
              <ellipse cx="180" cy="50" rx="36" ry="16" fill="none" stroke="var(--color-fg-subtle)" stroke-width="1" stroke-dasharray="3 3" opacity="0.5"/>
              <text x="180" y="48" text-anchor="middle" font-size="9" fill="var(--color-fg-subtle)" opacity="0.7">handshake only</text>
              <text x="180" y="60" text-anchor="middle" font-size="8" fill="var(--color-fg-subtle)" opacity="0.7">(no file bytes)</text>
              <text x="180" y="195" text-anchor="middle" font-size="9.5" fill="var(--color-fg-muted)">One hop. Zero storage. No size limit.</text>
            </svg>

            <ul class="mt-6 space-y-2 text-sm text-[var(--color-fg-muted)]">
              <li class="flex items-start gap-2"><span class="text-[var(--color-accent)] mt-0.5">✓</span> File goes straight from your browser to theirs</li>
              <li class="flex items-start gap-2"><span class="text-[var(--color-accent)] mt-0.5">✓</span> No size limit — 10MB or 100GB, same flow</li>
              <li class="flex items-start gap-2"><span class="text-[var(--color-accent)] mt-0.5">✓</span> We physically can't see the file (E2E encrypted)</li>
              <li class="flex items-start gap-2"><span class="text-[var(--color-accent)] mt-0.5">✓</span> Resume after disconnect — no restart from zero</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURE GRID -->
    <section class="border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-[1200px] px-6 md:px-12 py-16 md:py-24">
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight max-w-2xl">
          Built around one principle: <span class="text-[var(--color-fg-muted)]">your bytes are your business — and never anyone else's server's problem.</span>
        </h2>
        <div class="mt-12 grid gap-px bg-[var(--color-border)] sm:grid-cols-2 lg:grid-cols-3 border border-[var(--color-border)] rounded-lg overflow-hidden">
          {features.map((f) => (
            <div class="bg-[var(--color-bg)] p-6 md:p-8">
              <h3 class="text-lg font-semibold">{f.title}</h3>
              <p class="mt-2 text-[var(--color-fg-muted)] text-sm leading-relaxed">{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS TEASER -->
    <section class="border-b border-[var(--color-border)]">
      <div class="mx-auto max-w-[1200px] px-6 md:px-12 py-16 md:py-24 grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">How it works</p>
          <h2 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">Three steps. No server in the middle.</h2>
          <ol class="mt-6 space-y-4 text-[var(--color-fg-muted)]">
            <li><span class="text-[var(--color-fg)] font-medium">1. Generate a room.</span> Open the app on any browser, any device, any network — get a one-time URL.</li>
            <li><span class="text-[var(--color-fg)] font-medium">2. Share the link.</span> Send it to the recipient any way you like — they can be next to you or on the other side of the planet.</li>
            <li><span class="text-[var(--color-fg)] font-medium">3. Drop the file.</span> A direct, end-to-end encrypted browser-to-browser stream begins instantly. Zero upload step.</li>
          </ol>
          <a href={`${import.meta.env.BASE_URL}how-it-works`} class="mt-8 inline-flex h-10 items-center rounded-md border border-[var(--color-border)] px-4 text-sm font-medium text-[var(--color-fg)] no-underline transition-colors hover:bg-[var(--color-bg-muted)]">
            Read the technical deep-dive →
          </a>
        </div>
        <pre class="overflow-x-auto rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-6 text-xs leading-relaxed text-[var(--color-fg-muted)]"><code>{`// Receiver side — direct write to local disk
peerConnection.ondatachannel = (event) => {
  event.channel.onmessage = async (e) => {
    await opfsWriteHandle.write({
      type: 'write',
      data: e.data,
      position: receivedBytes,
    });
  };
};`}</code></pre>
      </div>
    </section>

    <!-- CTA -->
    <section>
      <div class="mx-auto max-w-[1200px] px-6 md:px-12 py-20 md:py-28 text-center">
        <h2 class="text-4xl md:text-6xl font-semibold tracking-tight">Stop uploading. Stop emailing. Just send.</h2>
        <p class="mt-5 text-lg text-[var(--color-fg-muted)] max-w-xl mx-auto">
          Open {site.shortName}. Drop a file. Share the link. The other browser — anywhere in the world — pulls it down directly. Done in 10 seconds.
        </p>
        <a
          href={`${import.meta.env.BASE_URL}transfer`}
          class="mt-10 inline-flex h-12 items-center rounded-lg bg-[var(--color-fg)] px-8 text-sm font-medium text-[var(--color-bg)] no-underline transition-opacity hover:opacity-90"
        >
          Send a file now →
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
