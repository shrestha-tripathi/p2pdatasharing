---
import Layout from "../layouts/Layout.astro";
import { site } from "../site.config";
---

<Layout>
  <main class="mx-auto max-w-[1200px] px-6 md:px-12 py-20 md:py-32">
    <p class="text-sm uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">
      Project scaffolded
    </p>
    <h1 class="mt-4 text-5xl md:text-7xl font-semibold">
      {site.name}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-[var(--color-fg-muted)]">
      {site.tagline}
    </p>
    <div class="mt-12 flex gap-3">
      <a
        href="https://github.com/shrestha-tripathi"
        class="inline-flex h-10 items-center rounded-lg bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] no-underline transition-opacity hover:opacity-90"
      >
        Get started
      </a>
      <a
        href="/about"
        class="inline-flex h-10 items-center rounded-lg border border-[var(--color-border)] px-4 text-sm font-medium text-[var(--color-fg)] no-underline transition-colors hover:bg-[var(--color-bg-muted)]"
      >
        Learn more
      </a>
    </div>
    <p class="mt-16 text-xs text-[var(--color-fg-subtle)]">
      Domain: {site.domain} — change in <code class="font-mono">.env</code>
    </p>
  </main>
</Layout>
