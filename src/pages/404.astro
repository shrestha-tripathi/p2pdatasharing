---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Lost in transit" description="The page you requested doesn't exist." noindex>
  <main class="min-h-screen flex items-center justify-center px-6 text-center">
    <div>
      <p class="text-sm uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">Error 404</p>
      <h1 class="mt-3 text-5xl md:text-7xl font-semibold tracking-tight">Lost in transit</h1>
      <p class="mt-4 text-[var(--color-fg-muted)]">That page never made it through the data channel.</p>
      <a href={import.meta.env.BASE_URL} class="mt-8 inline-flex h-10 items-center rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] no-underline transition-opacity hover:opacity-90">
        Back home →
      </a>
    </div>
  </main>
</Layout>
