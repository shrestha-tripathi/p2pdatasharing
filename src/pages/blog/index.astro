---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import { site } from "../../site.config";

/**
 * /blog — index of all published posts.
 *
 * Each post is a .md file in src/content/blog/ with frontmatter validated
 * by src/content.config.ts. Adding a new post = drop a file, no manual
 * registration needed.
 *
 * Why a blog at all? ToffeeShare has 30 posts driving long-tail SEO. Ours
 * is empty. Even 3 launch posts give Google something to chew on while
 * we grow.
 */

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Blog schema — tells Google this is a blog (eligible for the "Top stories"
// carousel and "more from {site}" link clusters).
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${site.url}/blog#blog`,
  url: `${site.url}/blog`,
  name: `${site.shortName} Blog`,
  description: `Long-form posts on peer-to-peer file transfer, WebRTC, browser networking, privacy, and the engineering behind ${site.shortName}.`,
  publisher: { "@id": `${site.url}/#organization` },
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    description: p.data.description,
    datePublished: p.data.pubDate.toISOString(),
    url: `${site.url}/blog/${p.id}`,
    author: { "@type": "Person", name: site.author },
  })),
};

function formatDate(d: Date): string {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<Layout
  title="Blog — peer-to-peer file transfer, WebRTC, privacy"
  description={`Long-form posts on peer-to-peer file transfer, WebRTC internals, browser networking, and the engineering behind ${site.shortName}.`}
  jsonLd={[blogSchema]}
>
  <Nav />

  <main class="mx-auto max-w-[860px] px-6 md:px-12 py-16 md:py-24">
    <p class="text-sm uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">Blog</p>
    <h1 class="mt-4 text-4xl md:text-6xl font-semibold tracking-tight">
      Writing about file transfer, WebRTC, and the open web.
    </h1>
    <p class="mt-6 text-lg text-[var(--color-fg-muted)]">
      Deep dives, comparisons, and troubleshooting guides. No content marketing fluff —
      just the actual engineering and tradeoffs behind {site.shortName}.
    </p>

    <hr class="my-12 border-[var(--color-border)]" />

    {posts.length === 0 ? (
      <p class="text-[var(--color-fg-muted)]">No posts yet. Check back soon.</p>
    ) : (
      <div class="space-y-6">
        {posts.map((post) => (
          <a
            href={`${import.meta.env.BASE_URL}blog/${post.id}`}
            class="group block rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-6 md:p-8 no-underline transition-colors hover:border-[var(--color-border-strong)]"
          >
            <p class="text-xs uppercase tracking-wider text-[var(--color-fg-subtle)]">
              {formatDate(post.data.pubDate)}
              {post.data.tags.length > 0 && (
                <>
                  {" · "}
                  {post.data.tags.slice(0, 3).join(" · ")}
                </>
              )}
            </p>
            <h2 class="mt-3 text-xl md:text-2xl font-semibold text-[var(--color-fg)] leading-tight group-hover:text-[var(--color-accent)] transition-colors">
              {post.data.title}
            </h2>
            <p class="mt-3 text-[var(--color-fg-muted)] leading-relaxed">
              {post.data.description}
            </p>
            <p class="mt-4 text-sm text-[var(--color-accent)]">Read post →</p>
          </a>
        ))}
      </div>
    )}
  </main>

  <Footer />
</Layout>
