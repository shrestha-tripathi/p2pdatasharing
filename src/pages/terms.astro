---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

/**
 * Terms & Conditions — legal contract between user and operator.
 *
 * Structure: definitions, acceptance, service description, acceptable use,
 * IP, third-party services, disclaimer, limitation of liability,
 * indemnification, modifications, governing law, contact.
 *
 * This is intentionally short and plain-English. For an indie/open-source
 * tool, a 30-page legalese ToS is both unenforceable in practice and a
 * trust signal in the wrong direction.
 */

const lastUpdated = "June 5, 2026";

const termsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${site.url}/terms#terms`,
  url: `${site.url}/terms`,
  name: `Terms & Conditions — ${site.shortName}`,
  description: `Terms of service for ${site.shortName} — acceptable use, disclaimer of warranty, limitation of liability, and governing law.`,
  dateModified: "2026-06-05",
  publisher: { "@id": `${site.url}/#organization` },
};
---

<Layout
  title="Terms & Conditions"
  description={`Terms of service for ${site.shortName} — what the free service does and doesn't promise, acceptable use, third-party providers, and limitation of liability. Plain English, no surprises.`}
  jsonLd={[termsSchema]}
>
  <Nav />

  <main class="mx-auto max-w-[760px] px-6 md:px-12 py-16 md:py-24">
    <p class="text-sm uppercase tracking-[0.06em] text-[var(--color-fg-subtle)]">Legal</p>
    <h1 class="mt-4 text-4xl md:text-5xl font-semibold tracking-tight">
      Terms &amp; Conditions
    </h1>
    <p class="mt-4 text-sm text-[var(--color-fg-subtle)]">
      Last updated: {lastUpdated}
    </p>
    <p class="mt-6 text-lg text-[var(--color-fg-muted)]">
      Plain-English terms for using {site.shortName}. By using the site or
      the file transfer tool, you agree to what's below.
    </p>

    <hr class="my-12 border-[var(--color-border)]" />

    <section class="space-y-10 text-[var(--color-fg-muted)] leading-relaxed">

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          1. Definitions
        </h2>
        <p class="mt-3">
          <strong class="text-[var(--color-fg)]">"Service"</strong> means the
          {site.shortName} website at <a href={site.url} class="text-[var(--color-accent)] underline break-all">{site.domain}</a>
          and the browser-based peer-to-peer file transfer tool it provides.
          <strong class="text-[var(--color-fg)]"> "We" / "us" / "operator"</strong> means
          {site.author}, the individual who operates the Service. <strong class="text-[var(--color-fg)]">"You"</strong> means
          the person using the Service.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          2. Acceptance
        </h2>
        <p class="mt-3">
          By accessing or using the Service, you confirm that you have read,
          understood, and agree to these Terms. If you do not agree, do not
          use the Service.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          3. What the Service does
        </h2>
        <p class="mt-3">
          {site.shortName} is a free, browser-based tool that helps two browsers
          establish a direct peer-to-peer connection using WebRTC, so users can
          send files to one another without uploading those files to any server.
          We operate only the small signaling infrastructure required to bootstrap
          the connection.
        </p>
        <p class="mt-3">
          <strong class="text-[var(--color-fg)]">We do not store, see, route, or
          transmit your files.</strong> The Service simply enables a direct
          connection between your browser and your recipient's browser. See
          our <a href={`${import.meta.env.BASE_URL}privacy-policy`} class="text-[var(--color-accent)] underline">Privacy Policy</a>
          for technical detail.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          4. Acceptable use
        </h2>
        <p class="mt-3">
          You may use {site.shortName} for any lawful purpose. You agree
          <strong class="text-[var(--color-fg)]">not</strong> to use the Service to:
        </p>
        <ul class="mt-4 list-disc pl-6 space-y-2">
          <li>Transfer content that is illegal in your jurisdiction or the
            recipient's — including but not limited to child sexual abuse
            material (CSAM), content that infringes copyright, trade secrets,
            or trademarks you don't have rights to, or content that violates
            export-control laws.</li>
          <li>Distribute malware, viruses, ransomware, or any software designed
            to damage, disable, or gain unauthorized access to systems.</li>
          <li>Harass, threaten, defame, or stalk any person.</li>
          <li>Reverse-engineer, scrape, overload, or attempt to disrupt the
            signaling server or other Service infrastructure.</li>
          <li>Resell, rebrand, or commercially redistribute the Service without
            written permission.</li>
        </ul>
        <p class="mt-3">
          Because we have <em>no visibility</em> into file content, enforcement
          of these rules relies on reports. If you believe the Service is being
          misused, contact <a href={`mailto:${site.contactEmail}`} class="text-[var(--color-accent)] underline">{site.contactEmail}</a>.
          We may suspend or block specific room IDs or network addresses found
          to be abusing the signaling layer.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          5. Your content
        </h2>
        <p class="mt-3">
          You retain all rights to files you send via {site.shortName}. We do
          not claim any ownership, license, or right to use your files — we
          never see them. You are solely responsible for ensuring you have
          the legal right to share the content you transfer.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          6. Intellectual property
        </h2>
        <p class="mt-3">
          The {site.shortName} name, branding, and original source code are
          owned by the operator. Open-source portions are licensed under their
          respective open-source licenses (see the
          <a href={site.githubRepo} target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] underline">project repository</a>
          for full license text). You may use, fork, and self-host the
          open-source portions under those licenses.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          7. Third-party services
        </h2>
        <p class="mt-3">
          The Service relies on third-party infrastructure (notably Cloudflare
          for hosting + signaling, and Google's public STUN servers for WebRTC
          discovery). Your use of the Service is also subject to those
          providers' terms. We are not responsible for outages, policy
          changes, or other actions of those providers.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          8. Disclaimer of warranty
        </h2>
        <p class="mt-3 uppercase text-sm font-medium">
          The Service is provided "as is" and "as available," without warranty of
          any kind, express or implied.
        </p>
        <p class="mt-3">
          We do not warrant that the Service will be uninterrupted, error-free,
          virus-free, or that all transfers will complete successfully. WebRTC
          connectivity depends on factors outside our control (your ISP, the
          recipient's ISP, NAT configurations, firewalls, browser updates). We
          make no guarantees about transfer speed, reliability, or compatibility.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          9. Limitation of liability
        </h2>
        <p class="mt-3">
          To the maximum extent permitted by law, the operator shall not be
          liable for any indirect, incidental, special, consequential, or
          punitive damages — including without limitation loss of profits, loss
          of data, loss of files, loss of business opportunity, or service
          interruption — arising from or related to your use of the Service.
        </p>
        <p class="mt-3">
          Because the Service is provided free of charge, the operator's total
          aggregate liability to you for any claim related to the Service is
          limited to <strong class="text-[var(--color-fg)]">USD $0</strong>.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          10. Indemnification
        </h2>
        <p class="mt-3">
          You agree to indemnify and hold harmless the operator from any
          claim, demand, loss, or expense (including reasonable legal fees)
          arising out of your misuse of the Service or your violation of
          these Terms, applicable law, or any third-party right.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          11. Modifications &amp; termination
        </h2>
        <p class="mt-3">
          We may modify or discontinue the Service at any time, with or
          without notice. We may update these Terms; the "Last updated" date
          at the top will change. Continued use after a change constitutes
          acceptance. If you don't agree with a change, stop using the Service.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          12. Governing law
        </h2>
        <p class="mt-3">
          These Terms are governed by the laws of {site.jurisdiction}, without
          regard to its conflict-of-laws provisions. Any dispute arising from
          or related to the Service shall be resolved in the courts of
          {site.jurisdiction}, unless mandatory consumer-protection laws in
          your jurisdiction grant you the right to bring claims locally.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          13. Severability
        </h2>
        <p class="mt-3">
          If any provision of these Terms is held to be unenforceable, that
          provision shall be modified to the minimum extent necessary to make
          it enforceable, and the remaining provisions shall remain in full
          force and effect.
        </p>
      </div>

      <div>
        <h2 class="text-xl md:text-2xl font-semibold text-[var(--color-fg)] tracking-tight">
          14. Contact
        </h2>
        <p class="mt-3">
          Questions about these Terms:
          <a href={`mailto:${site.contactEmail}`} class="text-[var(--color-accent)] underline break-all">{site.contactEmail}</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
