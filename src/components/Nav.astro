---
import { site } from "../site.config";

const links = [
  { href: "/", label: "Home" },
  { href: "/how-it-works", label: "How it works" },
  { href: "/privacy", label: "Privacy" },
];
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const raw = Astro.url.pathname.replace(/\/$/, "") || "/";
const path = base && raw.startsWith(base) ? (raw.slice(base.length) || "/") : raw;
const b = (p: string) => `${base}${p}`;
---

<header class="border-b border-[var(--color-border)] sticky top-0 z-50 backdrop-blur bg-[color-mix(in_srgb,var(--color-bg)_85%,transparent)]">
  <nav class="mx-auto max-w-[1200px] px-6 md:px-12 h-16 flex items-center justify-between">
    <a href={b("/")} class="flex items-center gap-2 no-underline">
      <svg width="22" height="22" viewBox="0 0 512 512" fill="none" class="text-[var(--color-fg)]" aria-hidden="true">
        <path d="M256 256 m-120 0 a120 120 0 1 1 240 0 a90 90 0 1 1 -180 0 a60 60 0 1 1 120 0 a30 30 0 1 1 -60 0"
              fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" opacity="0.35"/>
        <path d="M110 350 L430 130 L290 380 L240 300 Z" fill="currentColor"/>
        <path d="M240 300 L430 130 L290 250 Z" fill="currentColor" opacity="0.5"/>
      </svg>
      <span class="font-semibold text-[var(--color-fg)]">{site.shortName}</span>
    </a>
    <div class="flex items-center gap-1 md:gap-2">
      {links.map((l) => (
        <a
          href={b(l.href)}
          class:list={[
            "px-3 h-9 hidden sm:inline-flex items-center text-sm rounded-md no-underline transition-colors",
            path === l.href
              ? "text-[var(--color-fg)] bg-[var(--color-bg-muted)]"
              : "text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] hover:bg-[var(--color-bg-muted)]",
          ]}
        >{l.label}</a>
      ))}
      {path !== "/transfer" ? (
        <a
          href={b("/transfer")}
          class="inline-flex h-9 items-center gap-1.5 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] no-underline transition-opacity hover:opacity-90"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          Open app
        </a>
      ) : (
        <button
          type="button"
          onclick="location.reload()"
          title="Reload app"
          aria-label="Reload app"
          class="inline-flex h-9 items-center gap-1.5 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-90"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>
          Reload app
        </button>
      )}
    </div>
  </nav>
</header>
