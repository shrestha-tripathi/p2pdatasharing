---
import { site } from "../site.config";

const links = [
  { href: "/", label: "Home" },
  { href: "/how-it-works", label: "How it works" },
  { href: "/blog", label: "Blog" },
  { href: "/faq", label: "FAQ" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const raw = Astro.url.pathname.replace(/\/$/, "") || "/";
const path = base && raw.startsWith(base) ? (raw.slice(base.length) || "/") : raw;
const b = (p: string) => `${base}${p}`;
---

<header class="border-b border-[var(--color-border)] sticky top-0 z-50 backdrop-blur bg-[color-mix(in_srgb,var(--color-bg)_85%,transparent)]">
  <nav class="mx-auto max-w-[1200px] px-6 md:px-12 h-16 flex items-center justify-between">
    <a href={b("/")} class="flex items-center gap-2 no-underline">
      <svg width="22" height="22" viewBox="0 0 512 512" fill="none" class="text-[var(--color-fg)]" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="14" opacity="0.35">
          <polygon points="256,76 412,166 412,346 256,436 100,346 100,166"/>
          <polygon points="256,136 360,196 360,316 256,376 152,316 152,196"/>
          <polygon points="256,196 308,226 308,286 256,316 204,286 204,226"/>
          <line x1="256" y1="256" x2="256" y2="76"/>
          <line x1="256" y1="256" x2="412" y2="166"/>
          <line x1="256" y1="256" x2="412" y2="346"/>
          <line x1="256" y1="256" x2="256" y2="436"/>
          <line x1="256" y1="256" x2="100" y2="346"/>
          <line x1="256" y1="256" x2="100" y2="166"/>
        </g>
        <path d="M110 350 L430 130 L290 380 L240 300 Z" fill="currentColor"/>
        <path d="M240 300 L430 130 L290 250 Z" fill="currentColor" opacity="0.5"/>
      </svg>
      <span class="font-semibold text-[var(--color-fg)]">{site.shortName}</span>
    </a>
    <div class="flex items-center gap-1 md:gap-2">
      {links.map((l) => (
        <a
          href={b(l.href)}
          class:list={[
            "px-3 h-9 hidden sm:inline-flex items-center text-sm rounded-md no-underline transition-colors",
            path === l.href
              ? "text-[var(--color-fg)] bg-[var(--color-bg-muted)]"
              : "text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] hover:bg-[var(--color-bg-muted)]",
          ]}
        >{l.label}</a>
      ))}
      <!--
        Global theme toggle — lives in Nav so every page gets it (previously
        only existed inside the /transfer app). Wired via window.__setTheme
        defined in Layout.astro. Dark by default; persists in localStorage.
        Shows SUN icon in dark mode (click → go light); MOON icon in light.
      -->
      <button
        id="nav-theme-toggle"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] hover:bg-[var(--color-bg-muted)] transition-colors"
        aria-label="Toggle light/dark theme"
        title="Toggle light/dark theme"
      >
        <svg id="nav-theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg id="nav-theme-icon-moon" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      {path !== "/transfer" ? (
        <a
          href={b("/transfer")}
          class="inline-flex h-9 items-center gap-1.5 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] no-underline transition-opacity hover:opacity-90"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          Open app
        </a>
      ) : (
        <button
          type="button"
          onclick="location.reload()"
          title="Reload app"
          aria-label="Reload app"
          class="inline-flex h-9 items-center gap-1.5 rounded-md bg-[var(--color-fg)] px-4 text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-90"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>
          Reload app
        </button>
      )}
    </div>
  </nav>
</header>

<!--
  Single source of truth for the Nav theme toggle. Uses window.__setTheme
  / __getTheme defined in Layout.astro. is:inline so it runs synchronously
  on every page without bundling overhead.
-->
<script is:inline>
  (function () {
    var btn = document.getElementById("nav-theme-toggle");
    var iconSun = document.getElementById("nav-theme-icon-sun");
    var iconMoon = document.getElementById("nav-theme-icon-moon");
    if (!btn) return;
    function sync() {
      var t = (window.__getTheme && window.__getTheme()) || "dark";
      if (iconSun) iconSun.classList.toggle("hidden", t !== "dark");
      if (iconMoon) iconMoon.classList.toggle("hidden", t !== "light");
    }
    sync();
    btn.addEventListener("click", function () {
      var cur = (window.__getTheme && window.__getTheme()) || "dark";
      if (window.__setTheme) window.__setTheme(cur === "dark" ? "light" : "dark");
    });
    window.addEventListener("themechange", sync);
  })();
</script>
