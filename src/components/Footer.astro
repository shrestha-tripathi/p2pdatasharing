---
import { site } from "../site.config";
const year = new Date().getFullYear();
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const b = (p: string) => `${base}${p}`;
---

<footer class="border-t border-[var(--color-border)] mt-24">
  <div class="mx-auto max-w-[1200px] px-6 md:px-12 py-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <p class="text-sm text-[var(--color-fg-muted)]">
      © {year} {site.name} — files never touch a server.
    </p>
    <div class="flex flex-wrap gap-5 text-sm">
      <a href={b("/")} class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline">Home</a>
      <a href={b("/how-it-works")} class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline">How it works</a>
      <a href={b("/local-network")} class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline">Local network</a>
      <a href={b("/faq")} class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline">FAQ</a>
      <a href={b("/install")} class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline">Install</a>
      <a href={b("/privacy")} class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline">Privacy</a>
      <a href={b("/transfer")} class="text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] no-underline">App</a>
    </div>
  </div>
</footer>
