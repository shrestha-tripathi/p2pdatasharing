# Site configuration — copy to .env and edit when domain is finalized.
# All keys are PUBLIC_* so Astro exposes them to client + server.

PUBLIC_SITE_NAME="P2P Date Sharing"
PUBLIC_SITE_SHORT_NAME="P2PShare"
PUBLIC_SITE_DOMAIN="p2pdatesharing.local"
PUBLIC_SITE_URL="https://p2pdatesharing.local"
PUBLIC_SITE_TAGLINE="Peer-to-peer file sharing — files never touch a server."
PUBLIC_SITE_DESCRIPTION="Send files directly browser-to-browser using WebRTC. End-to-end encrypted, zero uploads, no signup."
PUBLIC_SITE_AUTHOR="Shrestha Tripathi"
PUBLIC_SITE_LOCALE="en-US"
PUBLIC_SITE_TWITTER=""
