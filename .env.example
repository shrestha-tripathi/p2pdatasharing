# Site configuration — copy to .env and edit when domain is finalized.
# All keys are PUBLIC_* so Astro exposes them to client + server.

PUBLIC_SITE_NAME="FileTransferNow"
PUBLIC_SITE_SHORT_NAME="FileTransferNow"
PUBLIC_SITE_DOMAIN="filetransfernow.com"
PUBLIC_SITE_URL="https://filetransfernow.com"
PUBLIC_SITE_TAGLINE="Files, finally direct."
PUBLIC_SITE_DESCRIPTION="Send files browser-to-browser with no upload, no signup, and no size limit. Free peer-to-peer file transfer over WebRTC, end-to-end encrypted, works across any network."
PUBLIC_SITE_AUTHOR="Shrestha Tripathi"
PUBLIC_SITE_LOCALE="en-US"
PUBLIC_SITE_TWITTER=""

# Contact email shown on /contact + /privacy-policy + /terms.
PUBLIC_SITE_CONTACT_EMAIL="hello@filetransfernow.com"

# Canonical public repo URL — surfaced on /about + /contact + footer.
PUBLIC_SITE_GITHUB_REPO="https://github.com/shrestha-tripathi/p2pdatasharing"

# Jurisdiction whose law governs the Terms & Conditions.
PUBLIC_SITE_JURISDICTION="India"

# WebSocket URL of the signaling server. Used ONLY for SDP/ICE handshake.
# In production set this to wss://signal.<your-domain>
PUBLIC_SIGNALING_URL="ws://localhost:8080"

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX). Leave blank to
# disable analytics entirely. Snippet is only injected in production builds.
PUBLIC_GA_MEASUREMENT_ID="G-S9DSNFWGGF"
