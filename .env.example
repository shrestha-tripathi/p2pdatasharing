# Site configuration — copy to .env and edit when domain is finalized.
# All keys are PUBLIC_* so Astro exposes them to client + server.

PUBLIC_SITE_NAME="Local Teleport"
PUBLIC_SITE_SHORT_NAME="Local Teleport"
PUBLIC_SITE_DOMAIN="p2pdatasharing.local"
PUBLIC_SITE_URL="https://p2pdatasharing.local"
PUBLIC_SITE_TAGLINE="Zero-cloud P2P file teleporter — browser to browser, never through a server."
PUBLIC_SITE_DESCRIPTION="Send files of any size directly browser-to-browser with WebRTC. No uploads, no signup, no size limits."
PUBLIC_SITE_AUTHOR="Shrestha Tripathi"
PUBLIC_SITE_LOCALE="en-US"
PUBLIC_SITE_TWITTER=""

# WebSocket URL of the signaling server. Used ONLY for SDP/ICE handshake.
# In production set this to wss://signal.<your-domain>
PUBLIC_SIGNALING_URL="ws://localhost:8080"
